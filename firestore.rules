rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /artifacts/{appId}/scores/{scoreId} {
   function valid() {
    let d = request.resource.data;
    let fields = ['initials','seconds','score','deathCause','shipId','fitting','stabilizers','linkedEngines','challenge','userId'];
    return appId == 'void-drift' && request.auth != null
     && d.keys().hasAll(fields)
     && d.keys().hasOnly(fields)
     && d.userId == request.auth.uid
     // Only the current challenge is written; earlier boards stay stored and readable.
     && d.challenge == 'ion-storm'
     && d.shipId is string && d.shipId.size() >= 1 && d.shipId.size() <= 32
     && scoreId == 'ion-storm_' + request.auth.uid + '_' + d.shipId
     && d.initials is string && d.initials.matches('^[A-Z]{3}$')
     // Seconds hold at most three decimals and have no ceiling.
     && d.seconds is number && d.seconds > 0
     && math.abs(d.seconds * 1000 - math.round(d.seconds * 1000)) < 0.000001
     // Score counts whole seconds, so it is never below them and has no ceiling.
     && d.score is int && d.score >= 1 && d.score > d.seconds - 1
     && d.deathCause in ['STAR','HULL','POWER']
     // MAX_FITTING_PARTS in packages/mode-a/src/schemas/highscore.ts.
     && d.fitting is list && d.fitting.size() <= 16
     && d.stabilizers is bool && d.linkedEngines is bool;
   }
   allow get: if appId == 'void-drift' && request.auth != null;
   allow list: if appId == 'void-drift' && request.auth != null && request.query.limit <= 30;
   allow create: if valid();
   allow update: if valid() && request.resource.data.challenge == resource.data.challenge && resource.data.userId == request.auth.uid && request.resource.data.score > resource.data.score;
   allow delete: if false;
  }
 }
}
