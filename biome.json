{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.astro",
      "!**/.vite",
      "!**/.vscode",
      "!**/.claude",
      "!artifacts",
      "!apps/web/public/studies/drone-launcher-2026-11-25/01-ion-weapons-source.svg",
      "!apps/web/public/studies/drone-launcher-2026-11-25/02-6-sources",
      "!docs/loop-evidence/artifacts",
      "!playwright-report",
      "!test-results",
      "!pnpm-lock.yaml",
      "!.agents",
      "!firebase-debug.log",
      "!firestore-debug.log",
      "!ui-debug.log",
      "!.firebase"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  }
}
