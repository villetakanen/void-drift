---
import { buildMounts, defaultBuilds } from "@void-drift/mode-a";
import { FIGHTER } from "../../../../../packages/mode-a/src/lib/fighter";

type Point = readonly [number, number];
const points = (v: readonly Point[]) => v.map((p) => p.join(",")).join(" ");
const mounts = buildMounts(defaultBuilds().balanced)
	.map((m) => (m.group === "aft" ? { ...m, x: m.x - 5 } : m))
	.filter((m) => m.group !== "hull");
const concepts: {
	name: string;
	idea: string;
	body: Point[];
	outlet: Point[];
	blue: Point[];
	ridge: Point;
	bands: number[];
}[] = [
	{
		name: "01 / Magnetic bottle",
		idea: "A swollen containment body with three retaining bands and a wide rear throat. The stored-energy silhouette contrasts with the thin ion accelerator.",
		body: [
			[9, 0],
			[6, -3],
			[2, -4.5],
			[-6, -4.5],
			[-10, -3],
			[-12, -3],
			[-12, 3],
			[-10, 3],
			[-6, 4.5],
			[2, 4.5],
			[6, 3],
		],
		outlet: [
			[-9, -2.8],
			[-12, -2.8],
			[-12, 2.8],
			[-9, 2.8],
		],
		blue: [
			[-11.5, -2],
			[-10.5, -2],
			[-10.5, 2],
			[-11.5, 2],
		],
		ridge: [0, 0],
		bands: [-5, -1, 3],
	},
	{
		name: "02 / Coil barrel",
		idea: "A long chamber wrapped in repeated magnetic collars. The staged rings suggest charging along the body before release through one broad opening.",
		body: [
			[10, 0],
			[7, -3.5],
			[-9, -3.5],
			[-12, -2.7],
			[-12, 2.7],
			[-9, 3.5],
			[7, 3.5],
		],
		outlet: [
			[-9, -2.7],
			[-12, -2.7],
			[-12, 2.7],
			[-9, 2.7],
		],
		blue: [
			[-11.5, -2],
			[-10.5, -2],
			[-10.5, 2],
			[-11.5, 2],
		],
		ridge: [1, 0],
		bands: [-7, -3, 1, 5],
	},
	{
		name: "03 / Armored furnace",
		idea: "A squat pressure housing with two heavy retaining bands and a flared release mouth. Broad panels make the engine feel like a compact reservoir.",
		body: [
			[8, 0],
			[4, -4.7],
			[-6, -4.7],
			[-8, -3],
			[-11, -4],
			[-12, -2.8],
			[-12, 2.8],
			[-11, 4],
			[-8, 3],
			[-6, 4.7],
			[4, 4.7],
		],
		outlet: [
			[-8, -2.7],
			[-12, -2.8],
			[-12, 2.8],
			[-8, 2.7],
		],
		blue: [
			[-11.5, -2.2],
			[-10.5, -2.2],
			[-10.5, 2.2],
			[-11.5, 2.2],
		],
		ridge: [0, 0],
		bands: [-4, 2],
	},
];
const colors = [
	{ name: "Hot orange", value: "#ff7b24" },
	{ name: "Amber", value: "#ffb52e" },
	{ name: "Solar yellow", value: "#ffe36a" },
];
// Match 02.2's fixed 210° sun, with +x model-forward rotated up on screen.
function shade(base: readonly number[], angle: number, slope = 0.85) {
	const amount =
		0.42 +
		1.05 * Math.max(0, Math.cos(angle - (210 * Math.PI) / 180) * slope + 0.25);
	return `rgb(${base.map((v) => Math.round(Math.min(255, v * amount))).join(",")})`;
}
function faceColor(p: Point, q: Point, angle: number, base: readonly number[]) {
	return shade(base, angle + Math.atan2((p[1] + q[1]) / 2, (p[0] + q[0]) / 2));
}
---

<div class="concepts">
	{concepts.map((concept, index) => (
		<article style="color: #ff7b24">
			<h4>{concept.name}</h4>
			<svg
				viewBox="-40 -56 80 102"
				role="img"
				aria-label={`${concept.name} fitted to all four Fighter engine mounts`}
			>
				<defs>
					{[0, ...mounts.map((m) => m.angle)].map((angle, pose) => (
						<g id={`plasma-body-${index}-${pose}`}>
							{concept.body.map((p, i) => (
								<polygon
									points={points([
										concept.ridge,
										p,
										concept.body[(i + 1) % concept.body.length],
									])}
									fill={faceColor(
										p,
										concept.body[(i + 1) % concept.body.length],
										angle - Math.PI / 2,
										[64, 68, 74],
									)}
								/>
							))}
							{concept.bands.map((x) => (
								<>
									<polygon
										points={points([
											[x, -4.8],
											[x + 1, -4.8],
											[x + 1, 0],
											[x, 0],
										])}
										fill={shade([95, 102, 110], angle - Math.PI, 0.5)}
									/>
									<polygon
										points={points([
											[x, 0],
											[x + 1, 0],
											[x + 1, 4.8],
											[x, 4.8],
										])}
										fill={shade([95, 102, 110], angle, 0.5)}
									/>
									<polygon
										points={points([
											[x + 0.25, -1],
											[x + 0.75, -1],
											[x + 0.75, 1],
											[x + 0.25, 1],
										])}
										fill="currentColor"
									/>
								</>
							))}
							<polygon points={points(concept.outlet)} fill="#12171e" />
							<polygon points={points(concept.blue)} fill="currentColor" />
						</g>
					))}
				</defs>
				<g transform="rotate(-90)">
					{mounts.map(
						(m, pose) =>
							m.group === "side" && (
								<use
									href={`#plasma-body-${index}-${pose + 1}`}
									transform={`translate(${m.x} ${m.y}) rotate(${(m.angle * 180) / Math.PI})`}
								/>
							),
					)}
					{FIGHTER.hull.map((p, i) => (
						<polygon
							points={points([
								[-3, 0],
								p,
								FIGHTER.hull[(i + 1) % FIGHTER.hull.length],
							])}
							fill={faceColor(
								p,
								FIGHTER.hull[(i + 1) % FIGHTER.hull.length],
								-Math.PI / 2,
								[105, 160, 177],
							)}
						/>
					))}
					<polygon
						points={points(FIGHTER.ridge)}
						fill={shade([130, 185, 195], -Math.PI / 2, 0.2)}
					/>
					<polygon points={points(FIGHTER.cockpit)} fill="#030609" />
					{mounts.map(
						(m, pose) =>
							m.group === "aft" && (
								<use
									href={`#plasma-body-${index}-${pose + 1}`}
									transform={`translate(${m.x + 5} ${m.y}) rotate(${(m.angle * 180) / Math.PI})`}
								/>
							),
					)}
				</g>
			</svg>
			<div class="detail">
				<svg
					viewBox="-15 -16 30 32"
					role="img"
					aria-label={`${concept.name} enlarged plasma chamber`}
				>
					<use href={`#plasma-body-${index}-0`} transform="rotate(-90)" />
				</svg>
				<p>{concept.idea}</p>
			</div>
		</article>
	))}
</div>
<div class="colors">
	{colors.map((color) => (
		<figure style={`color: ${color.value}`}>
			<svg
				viewBox="-15 -16 30 32"
				role="img"
				aria-label={`${color.name} magnetic bottle`}
			>
				<use href="#plasma-body-0-0" transform="rotate(-90)" />
			</svg>
			<figcaption>{color.name}</figcaption>
		</figure>
	))}
</div>
<style>
.concepts {
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: var(--spacing-lg);
	margin-block: var(--spacing-lg);
}
article {
	border: var(--flight-border);
	background: var(--color-void-light);
	padding: var(--spacing-md);
}
h4 {
	color: var(--color-text);
	min-height: 2.7em;
	margin: 0;
	font-size: 1.1rem;
}
svg {
	width: 100%;
	height: 340px;
	display: block;
}
.detail {
	display: grid;
	grid-template-columns: 90px 1fr;
	gap: var(--spacing-md);
	align-items: center;
}
.detail svg {
	height: 130px;
}
p {
	color: var(--color-text);
	margin: 0;
	font-size: var(--font-body);
}
@media (max-width: 900px) {
	.detail {
		grid-template-columns: 1fr;
	}
}
@media (max-width: 620px) {
	.concepts {
		grid-template-columns: 1fr;
	}
}
.colors {
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: var(--spacing-md);
}
.colors figure {
	margin: 0;
	padding: var(--spacing-md);
	border: var(--flight-border);
	text-align: center;
}
.colors svg {
	height: 140px;
}
</style>
