---
import { buildMounts, defaultBuilds } from "@void-drift/mode-a";
import { FIGHTER } from "../../../../../packages/mode-a/src/lib/fighter";

interface Props {
	simplified?: boolean;
}
const { simplified = false } = Astro.props;
const prefix = simplified ? "plasma-simple" : "plasma-vessel";
type Point = readonly [number, number];
const points = (v: readonly Point[]) => v.map((p) => p.join(",")).join(" ");
const mounts = buildMounts(defaultBuilds().balanced)
	.map((m) => (m.group === "aft" ? { ...m, x: m.x - 5 } : m))
	.filter((m) => m.group !== "hull");
type Part = { body: Point[]; base: number[]; accent?: boolean };
const metal = [64, 68, 74];
const steel = [105, 113, 119];
function plate(body: Point[], base = metal, accent = false): Part {
	return { body, base, accent };
}
function rect(
	x: number,
	y: number,
	w: number,
	h: number,
	base = metal,
	accent = false,
): Part {
	return plate(
		[
			[x, y],
			[x + w, y],
			[x + w, y + h],
			[x, y + h],
		],
		base,
		accent,
	);
}
function tank(x: number, y: number, l: number, r: number): Part[] {
	return [
		plate([
			[x - l / 2, y - r * 0.6],
			[x - l / 2 + 1.5, y - r],
			[x + l / 2 - 2, y - r],
			[x + l / 2, y - r * 0.45],
			[x + l / 2, y + r * 0.45],
			[x + l / 2 - 2, y + r],
			[x - l / 2 + 1.5, y + r],
			[x - l / 2, y + r * 0.6],
		]),
		rect(x - l / 2 + 1.5, y - r, l - 3.5, r, [82, 88, 94]),
		rect(x - l / 2 + 1.5, y, l - 3.5, r, [40, 45, 51]),
		rect(x - l / 2 + 0.7, y - r - 0.25, 1, r * 2 + 0.5, steel),
		rect(x + l / 2 - 3, y - r - 0.25, 1, r * 2 + 0.5, steel),
		rect(x + l / 2, y - 0.7, 1.2, 1.4, steel),
		rect(x - 1, y - r + 0.4, 2, 0.45, [255, 181, 46], true),
	];
}
function orb(x: number, r: number): Part[] {
	const body: Point[] = Array.from({ length: 10 }, (_, i) => [
		x + r * Math.cos((i * Math.PI) / 5),
		r * Math.sin((i * Math.PI) / 5),
	]);
	return [
		plate(body),
		plate(
			[
				[x - r * 0.8, -r * 0.6],
				[x, -r],
				[x + r * 0.8, -r * 0.6],
				[x + r * 0.6, 0],
				[x - r * 0.6, 0],
			],
			[88, 95, 102],
		),
		rect(x - 0.6, -r - 0.3, 1.2, 2 * r + 0.6, steel),
		rect(x - r * 0.5, -0.6, r, 1.2, [31, 36, 42]),
		rect(x - r * 0.4, -0.25, r * 0.5, 0.5, [255, 181, 46], true),
	];
}
function nozzle(w: number, armored: boolean): Part[] {
	return [
		plate([
			[-5, -w],
			[-8, -w],
			[-11, -w * 0.75],
			[-11, w * 0.75],
			[-8, w],
			[-5, w],
		]),
		...[-6.7, -8.6].flatMap((x) => [
			rect(x, -w - 0.25, 0.9, w + 0.25, steel),
			rect(x, 0, 0.9, w + 0.25, [56, 62, 69]),
		]),
		rect(-10.7, -w * 0.64, 1.1, w * 1.28, [10, 13, 18]),
		rect(-10.3, -w * 0.47, 0.45, w * 0.94, [255, 181, 46], true),
		...(armored
			? [-1, 1].map((side) => rect(-9, side * w - 0.45, 4, 0.9, [79, 85, 92]))
			: []),
	];
}
const originals = [
	{
		name: "01 / Twin pressure tanks",
		idea: "Broad gas cylinders, steel retaining straps and a shared armored manifold. A short coil throat sits directly behind the tanks.",
		parts: [
			rect(-6, -5, 7, 10, [37, 42, 48]),
			...tank(2, -2.8, 14, 2.3),
			...tank(2, 2.8, 14, 2.3),
			...nozzle(3.5, false),
		],
	},
	{
		name: "02 / Caged twin tanks",
		idea: "Two thick cylinders enclosed by protective rails, with recessed valves and a wider shielded exhaust block.",
		parts: [
			rect(-6, -5.2, 15, 10.4, [33, 38, 44]),
			...tank(2, -2.7, 12, 2.2),
			...tank(2, 2.7, 12, 2.2),
			rect(-4, -5.6, 13, 0.8, steel),
			rect(-4, 4.8, 13, 0.8, [55, 61, 68]),
			...nozzle(4.3, true),
		],
	},
	{
		name: "03 / Reinforced pressure vessel",
		idea: "One large cylindrical vessel with flat end caps, heavy compression bands and a compact magnetic nozzle.",
		parts: [rect(-6, -2, 16, 4), ...tank(2, 0, 17, 4.3), ...nozzle(3.4, false)],
	},
	{
		name: "04 / Armored containment vessel",
		idea: "A long tank nested inside a thick angular cradle. Side armor protects the pressure body and a broad nozzle contains the release.",
		parts: [
			rect(-7, -5, 17, 10, [34, 39, 45]),
			...tank(2, 0, 16, 3.8),
			rect(-4, -5.2, 13, 1.2, steel),
			rect(-4, 4, 13, 1.2, [55, 61, 68]),
			...nozzle(4.4, true),
		],
	},
	{
		name: "05 / Coupled pressure spheres",
		idea: "Two large spherical pressure chambers joined by a thick coupling, each held by an equatorial restraint. The coil throat is short and heavy.",
		parts: [
			rect(-6, -1.6, 17, 3.2, steel),
			...orb(7, 4.1),
			...orb(-1, 4.1),
			...nozzle(3.5, false),
		],
	},
	{
		name: "06 / Reactor sphere cage",
		idea: "Two pressure spheres sit inside a protective industrial frame. Thick side rails and a shielded outlet make the assembly feel hazardous and contained.",
		parts: [
			rect(-6, -5, 17, 10, [30, 35, 41]),
			...orb(7, 3.9),
			...orb(-1, 3.9),
			rect(-5, -5.2, 16, 1, steel),
			rect(-5, 4.2, 16, 1, [55, 61, 68]),
			...nozzle(4.3, true),
		],
	},
];
const concepts = simplified
	? [
			{
				name: "04 / Armored containment · simplified",
				idea: "One broad faceted pressure vessel, an integrated armor edge and a compact coil chamber. Two coarse coil bands and one amber outlet carry the machinery's identity.",
				parts: [
					plate(
						[
							[10, -2],
							[8, -5],
							[-7, -5],
							[-11, -3.3],
							[-11, 3.3],
							[-7, 5],
							[8, 5],
							[10, 2],
						],
						[34, 39, 45],
					),
					plate(
						[
							[10, 0],
							[8, -3.8],
							[-4.5, -3.8],
							[-6, 0],
						],
						[82, 88, 94],
					),
					plate(
						[
							[10, 0],
							[8, 3.8],
							[-4.5, 3.8],
							[-6, 0],
						],
						[40, 45, 51],
					),
					plate(
						[
							[8, -5],
							[-7, -5],
							[-6, -3.8],
							[8, -3.8],
						],
						[94, 102, 110],
					),
					plate([
						[-6, -4.4],
						[-8, -4.4],
						[-11, -3.3],
						[-11, 3.3],
						[-8, 4.4],
						[-6, 4.4],
					]),
					rect(-7.4, -4.4, 1, 4.4, [94, 102, 110]),
					rect(-7.4, 0, 1, 4.4, [50, 56, 63]),
					rect(-9.4, -3.9, 1, 3.9, [94, 102, 110]),
					rect(-9.4, 0, 1, 3.9, [50, 56, 63]),
					rect(-10.8, -2.7, 0.8, 5.4, [12, 16, 22]),
					rect(-10.5, -2, 0.5, 4, [255, 181, 46], true),
				],
			},
		]
	: originals;
// Match 02.2's fixed 210° sun, with +x model-forward rotated up on screen.
function shade(base: readonly number[], angle: number, slope = 0.85) {
	const amount =
		0.42 +
		1.05 * Math.max(0, Math.cos(angle - (210 * Math.PI) / 180) * slope + 0.25);
	return `rgb(${base.map((v) => Math.round(Math.min(255, v * amount))).join(",")})`;
}
function faceColor(p: Point, q: Point, angle: number, base: readonly number[]) {
	return shade(base, angle + Math.atan2((p[1] + q[1]) / 2, (p[0] + q[0]) / 2));
}
---

<div class:list={["concepts", { simplified }]}>
	{concepts.map((concept, index) => (
		<article style="color: #ffb52e">
			<h4>{concept.name}</h4>
			<svg
				viewBox="-40 -56 80 102"
				role="img"
				aria-label={`${concept.name} fitted to all four Fighter engine mounts`}
			>
				<defs>
					{[0, ...mounts.map((m) => m.angle)].map((angle, pose) => (
						<g id={`${prefix}-${index}-${pose}`}>
							{concept.parts.map((part) => (
								<polygon
									points={points(part.body)}
									fill={
										part.accent
											? "currentColor"
											: shade(
													part.base,
													angle -
														Math.PI / 2 +
														Math.atan2(
															part.body.reduce((sum, p) => sum + p[1], 0) /
																part.body.length,
															1,
														),
													0.55,
												)
									}
								/>
							))}
						</g>
					))}
				</defs>
				<g transform="rotate(-90)">
					{mounts.map(
						(m, pose) =>
							m.group === "side" && (
								<use
									href={`#${prefix}-${index}-${pose + 1}`}
									transform={`translate(${m.x} ${m.y}) rotate(${(m.angle * 180) / Math.PI})`}
								/>
							),
					)}
					{FIGHTER.hull.map((p, i) => (
						<polygon
							points={points([
								[-3, 0],
								p,
								FIGHTER.hull[(i + 1) % FIGHTER.hull.length],
							])}
							fill={faceColor(
								p,
								FIGHTER.hull[(i + 1) % FIGHTER.hull.length],
								-Math.PI / 2,
								[105, 160, 177],
							)}
						/>
					))}
					<polygon
						points={points(FIGHTER.ridge)}
						fill={shade([130, 185, 195], -Math.PI / 2, 0.2)}
					/>
					<polygon points={points(FIGHTER.cockpit)} fill="#030609" />
					{mounts.map(
						(m, pose) =>
							m.group === "aft" && (
								<use
									href={`#${prefix}-${index}-${pose + 1}`}
									transform={`translate(${m.x + 5} ${m.y}) rotate(${(m.angle * 180) / Math.PI})`}
								/>
							),
					)}
				</g>
			</svg>
			<div class="detail">
				<svg
					viewBox="-15 -16 30 32"
					role="img"
					aria-label={`${concept.name} enlarged plasma chamber`}
				>
					<use href={`#${prefix}-${index}-0`} transform="rotate(-90)" />
				</svg>
				<p>{concept.idea}</p>
			</div>
		</article>
	))}
</div>
<style>
.concepts.simplified {
	max-width: 620px;
	margin-inline: auto;
	grid-template-columns: 1fr;
}
.concepts {
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: var(--spacing-lg);
	margin-block: var(--spacing-lg);
}
article {
	border: var(--flight-border);
	background: var(--color-void-light);
	padding: var(--spacing-md);
}
h4 {
	color: var(--color-text);
	min-height: 2.7em;
	margin: 0;
	font-size: 1.1rem;
}
svg {
	width: 100%;
	height: 280px;
	display: block;
}
.detail {
	display: grid;
	grid-template-columns: 1fr;
	gap: var(--spacing-md);
	align-items: center;
}
.detail svg {
	height: 190px;
}
p {
	color: var(--color-text);
	margin: 0;
	font-size: var(--font-body);
}
@media (max-width: 900px) {
	.detail {
		grid-template-columns: 1fr;
	}
}
@media (max-width: 620px) {
	.concepts {
		grid-template-columns: 1fr;
	}
}
</style>
