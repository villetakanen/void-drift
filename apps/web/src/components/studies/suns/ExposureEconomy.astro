---
import { massWellAcceleration } from "@void-drift/core";
import { buildCollisionRadius, GRAVITY_TUNING } from "@void-drift/mode-a";
import { collection, loadout, radius, reach } from "./charging";

const candidates = [
	{ name: "A / Close envelope", edge: 70 },
	{ name: "B / Wider envelope", edge: 100 },
];
const peakDamage = 1.5;
const shoulder = radius + 20;
const damage = (d: number, edge: number) =>
	peakDamage * Math.max(0, Math.min(1, (edge - d) / (edge - shoulder)));
const distances = [60, 80, 100, 160, 260];
const sx = (d: number) => 80 + (d / reach) * 880;
const samples = [
	...new Set([
		radius,
		shoulder,
		70,
		100,
		reach,
		...Array.from(
			{ length: 161 },
			(_, i) => radius + ((reach - radius) * i) / 160,
		),
	]),
].sort((a, b) => a - b);
const energy = (d: number) => collection(d, 7.5, "shoulder");
const ey = (value: number) => 500 - (value / 7.5) * 300;
const hy = (value: number) => 500 - (value / 1.5) * 300;
const line = (fn: (d: number) => number) =>
	samples.map((d) => `${sx(d)},${ey(fn(d))}`).join(" ");
const markers = [
	{ d: 35, label: "35 u · surface", x: 110, y: 48 },
	{ d: 55, label: "55 u · shoulder / maximum damage", x: 340, y: 80 },
	{ d: 70, label: "70 u · A damage ends", x: 575, y: 112 },
	{ d: 100, label: "100 u · B damage ends", x: 800, y: 144 },
];
const contact = radius + buildCollisionRadius(loadout);
---

<div class="economy">
	<h4>How much of the field asks for hull?</h4>
	<p>
		Same Sun in both examples: surface 35 u; collection and gravity reach
		{reach.toFixed(0)}
		u. Retained charging profile: 7.5 E/s, 20 u shoulder, 10% outer edge. Only
		the proposed damage reach changes.
	</p>
	<svg
		viewBox="0 0 1040 240"
		role="img"
		aria-label="Field extents: gravity and collection reach 324 units, proposed damage ends at 70 or 100 units"
	>
		<text x="0" y="28">Distance from centre →</text>
		<line x1={sx(radius)} x2={sx(reach)} y1="65" y2="65" class="energy" />
		<text x="0" y="95">Gravity + collection</text>
		{candidates.map((c, i) => (
			<g>
				<line
					x1={sx(radius)}
					x2={sx(c.edge)}
					y1={130 + i * 60}
					y2={130 + i * 60}
					class="damage"
				/>
				<text x={sx(c.edge) + 14} y={135 + i * 60}>
					{c.name} · damage ends at {c.edge} u
				</text>
			</g>
		))}
		<line x1={sx(radius)} x2={sx(radius)} y1="45" y2="210" class="axis" />
		<text x={sx(radius)} y="230" text-anchor="middle">Surface 35</text>
		<text x={sx(reach)} y="230" text-anchor="middle">{reach.toFixed(0)} u</text>
	</svg>
	<h4>The return and the cost, at each distance</h4>
	<p>
		Blue is collection; pale dashed is net energy after 0.8 E/s life support;
		orange dashed also subtracts 0.2 E/s for an optional running repair device.
		No propulsion draw. Repair has no cost on the ordinary, unfitted ship.
	</p>

	<svg
		class="tradeoff"
		viewBox="0 0 1040 610"
		role="img"
		aria-label="Five overlaid energy and hull-loss curves against distance. Energy scale on the left, hull-loss scale on the right. Shading marks damage in both candidates from 35 to 70, only B from 70 to 100, and no radiation damage in either from 100 to 324 units."
	>
		<rect
			x={sx(0)}
			y="180"
			width={sx(35) - sx(0)}
			height="340"
			class="body-zone"
		/>
		<rect
			x={sx(35)}
			y="180"
			width={sx(70) - sx(35)}
			height="340"
			class="both-zone"
		/>
		<rect
			x={sx(70)}
			y="180"
			width={sx(100) - sx(70)}
			height="340"
			class="b-zone"
		/>
		<rect
			x={sx(100)}
			y="180"
			width={sx(reach) - sx(100)}
			height="340"
			class="clear-zone"
		/>
		{markers.map((m) => (
			<g>
				<text x={m.x} y={m.y} text-anchor="middle">
					{m.label}
				</text>
				<path d={`M${m.x} ${m.y + 8} H${sx(m.d)} V180`} class="leader" />
				<line x1={sx(m.d)} x2={sx(m.d)} y1="180" y2="520" class="boundary" />
			</g>
		))}
		<text x="960" y="170" text-anchor="end">
			324 u · collection + gravity end
		</text>
		<line x1={sx(reach)} x2={sx(reach)} y1="180" y2="520" class="boundary" />
		{[0, 2.5, 5, 7.5].map((v) => (
			<g>
				<line x1="80" x2="960" y1={ey(v)} y2={ey(v)} class="grid" />
				<text x="65" y={ey(v) + 5} text-anchor="end">
					{v}
				</text>
				<text x="975" y={ey(v) + 5}>
					{(v / 5).toFixed(1)}
				</text>
			</g>
		))}
		<text x="24" y="350" transform="rotate(-90 24 350)" text-anchor="middle">
			ENERGY · E/s (left)
		</text>
		<text x="1020" y="350" transform="rotate(90 1020 350)" text-anchor="middle">
			HULL LOSS · hull/s (right)
		</text>
		<polyline points={line(energy)} class="energy-curve" />
		<polyline points={line((d) => energy(d) - 0.8)} class="net" />
		<polyline points={line((d) => energy(d) - 1)} class="repair" />
		{candidates.map((c, i) => (
			<polyline
				points={samples
					.map((d) => `${sx(d)},${hy(damage(d, c.edge))}`)
					.join(" ")}
				class={i === 0 ? "damage-a" : "damage-b"}
			/>
		))}
		{[0, 35, 55, 70, 100, 160, 260, reach].map((d) => (
			<text x={sx(d)} y={d === 55 ? 552 : 538} text-anchor="middle">
				{d.toFixed(0)}
			</text>
		))}
		<text x="960" y="575" text-anchor="end">Distance from centre · u →</text>
		<text x="80" y="599">Radiation-free does not mean gravity-free.</text>
	</svg>
	<div class="curve-key">
		<span><i class="key-collection"></i>Collection · left</span>
		<span><i class="key-net"></i>Net, ordinary ship · left</span>
		<span><i class="key-repair"></i>Net, repair running · left</span>
		<span><i class="key-a"></i>Hull loss A · right</span>
		<span><i class="key-b"></i>Hull loss B · right</span>
	</div>
	<ul class="zones">
		<li>
			<strong>Inside 35 u:</strong>
			stellar body. The Wasp itself contacts the star at about
			{contact.toFixed(1)}
			u because its hull has width.
		</li>
		<li>
			<strong>35–70 u:</strong>
			damage in both proposals. Maximum damage holds from the surface to the
			shoulder at 55 u, then falls toward each damage boundary.
		</li>
		<li>
			<strong>70–100 u:</strong>
			no radiation damage in A; damage still applies in B.
		</li>
		<li>
			<strong>100–324 u:</strong>
			no radiation damage in either. Gravity and collection remain active inside
			the outer boundary.
		</li>
	</ul>
	<p>
		From the surface to the field edge, A’s damage occupies about
		{(((70 - radius) / (reach - radius)) * 100).toFixed(0)}% of the radial span
		and B’s about {(((100 - radius) / (reach - radius)) * 100).toFixed(0)}%.
		These are distance fractions, not area fractions. Both leave most of the
		collection field radiation-free.
	</p>
	<p>
		All five lines share distance, but energy and hull use different scales. A
		crossing between an energy line and a damage line is not break-even or a
		repair exchange rate. The table below expresses the actual energy and hull
		amounts together. Optional repair costs energy; its restoration rate remains
		unknown.
	</p>
	<p>
		Maximum damage now begins at the shoulder’s outer edge (55 u) on approach
		and stays at 1.5 hull/s inward to the surface. Outside the shoulder, these
		proposals fall linearly to zero at 70 u (A) or 100 u (B). The later delivery
		decision selects B with this linear decline. Stepped levels such as 1.5, 1.0
		and 0.5 hull/s would need explicit band boundaries; they would create abrupt
		changes on crossing those bands. First settle where damage begins, then
		compare those shapes without moving the chosen boundary. This retained
		comparison documents the alternatives; B is selected in the delivery
		decision.
	</p>

	<h4>A ten-second exposure budget</h4>
	<p>
		These are local rates multiplied by ten seconds, not a simulated hover or
		orbit. Gravity makes staying here a flight problem; any manoeuvring costs
		extra. Wasp contact begins at approximately {contact.toFixed(1)} u from the
		centre. Figures assume enough battery space and hull to accept the whole
		interval.
	</p>
	<table>
		<thead>
			<tr>
				<th>Distance</th>
				<th>Pull<br>u/s²</th>
				<th>Energy gained<br>ordinary ship</th>
				<th>Energy gained<br>repair running</th>
				<th>Hull lost<br>A / B</th>
				<th>Repair needed to hold hull<br>A / B · hull/s</th>
			</tr>
		</thead>
		<tbody>
			{distances.map((d) => (
				<tr>
					<th>{d} u</th>
					<td>
						{massWellAcceleration(
							d,
							GRAVITY_TUNING.sunMass,
							GRAVITY_TUNING.cutoff,
							GRAVITY_TUNING.falloff,
						).toFixed(0)}
					</td>
					<td>{((energy(d) - 0.8) * 10).toFixed(1)} E</td>
					<td>{((energy(d) - 1) * 10).toFixed(1)} E</td>
					<td>
						{(damage(d, 70) * 10).toFixed(1)} /{" "}
						{(damage(d, 100) * 10).toFixed(1)}
					</td>
					<td>
						{damage(d, 70).toFixed(2)} / {damage(d, 100).toFixed(2)}
					</td>
				</tr>
			))}
		</tbody>
	</table>
	<p>
		The repair column is the required restoration rate, not what the device
		delivers. Its output is still undefined. At 80 u, A allows radiation-free
		charging while B costs {(damage(80, 100) * 10).toFixed(1)} hull over ten
		seconds for exactly the same energy income. At 100 u both are
		radiation-free, while collection is still {energy(100).toFixed(2)} E/s.
	</p>
	<p>
		<strong>Selected outcome:</strong>
		B is the standard Sun’s damage envelope: maximum damage through the
		shoulder, then a linear decline to zero at 100 u. A remains here as the
		comparison that informed that choice. Repair-assisted charging still depends
		on the optional device’s undefined restoration rate.
	</p>
</div>
<style>
.economy {
	margin-block: var(--spacing-lg);
}
h4 {
	font-size: var(--font-size-heading);
	margin-block: var(--spacing-lg) var(--spacing-md);
}
p {
	max-width: var(--measure-prose);
	margin-block: var(--spacing-md);
}
svg {
	width: 100%;
	display: block;
	background: var(--color-elev-1);
	margin-block: var(--spacing-lg);
}
text {
	fill: var(--color-text);
	font: 14px var(--font-family-ui);
}
.axis {
	stroke: var(--color-text-muted);
}
.grid {
	stroke: var(--color-border);
}
.energy {
	stroke: var(--color-resource-hull);
	stroke-width: 8;
}
.damage {
	stroke: var(--color-resource-danger);
	stroke-width: 8;
}
.energy-curve,
.net,
.repair,
.damage-a,
.damage-b {
	fill: none;
	stroke-width: 2;
}
.energy-curve {
	stroke: var(--color-resource-hull);
}
.net {
	stroke: var(--color-text);
	stroke-dasharray: 7 4;
}
.repair {
	stroke: var(--color-resource-warning);
	stroke-dasharray: 3 4;
}
.damage-b {
	stroke: var(--color-caution-tape);
	stroke-dasharray: 10 5;
}
.damage-a {
	stroke: var(--color-resource-danger);
}
table {
	width: 100%;
	border-collapse: collapse;
	font-size: 0.95rem;
}
th,
td {
	text-align: left;
	vertical-align: top;
	padding: var(--spacing-md);
	border-bottom: 1px solid var(--color-border);
}

.body-zone {
	fill: var(--color-text-muted);
	opacity: 0.18;
}
.both-zone {
	fill: var(--color-resource-danger);
	opacity: 0.16;
}
.b-zone {
	fill: var(--color-resource-warning);
	opacity: 0.14;
}
.clear-zone {
	fill: var(--color-resource-hull);
	opacity: 0.035;
}
.boundary {
	stroke: var(--color-text-muted);
	stroke-dasharray: 4 4;
}
.leader {
	fill: none;
	stroke: var(--color-text-muted);
	stroke-width: 1;
}
.curve-key {
	display: flex;
	flex-wrap: wrap;
	gap: 16px 24px;
	font-size: 0.9rem;
}
.curve-key span {
	display: flex;
	align-items: center;
	gap: 8px;
}
i {
	display: inline-block;
	width: 24px;
	border-top: 3px solid;
}
.key-collection {
	border-color: var(--color-resource-hull);
}
.key-net {
	border-color: var(--color-text);
	border-top-style: dashed;
}
.key-repair {
	border-color: var(--color-resource-warning);
	border-top-style: dotted;
}
.key-a {
	border-color: var(--color-resource-danger);
}
.key-b {
	border-color: var(--color-caution-tape);
	border-top-style: dashed;
}
.zones {
	max-width: var(--measure-prose);
	padding-left: 24px;
	margin-block: 24px;
}
.zones li {
	margin-bottom: 12px;
}
</style>
