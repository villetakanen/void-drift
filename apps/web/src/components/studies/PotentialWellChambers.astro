---
const names = [
  "Square wells / Wide pair",
  "Square wells / Long pair",
  "Square wells / Three chambers",
  "Diamond wells / Wide pair",
  "Diamond wells / Long pair",
  "Diamond wells / Three chambers",
  "Slotted wells / Wide pair",
  "Slotted wells / Long pair",
  "Slotted wells / Three chambers",
];
const notes = [
  "Broad square shoulders around separate dark centers.",
  "Two square chambers spaced along underlying rails.",
  "Three square chambers share an underlying frame.",
  "Four large sloping planes define each diamond chamber.",
  "Separated diamond chambers expose the rails between them.",
  "Three diamond chambers form a compact cluster.",
  "Long narrow recesses contained by broad shoulders.",
  "Two elongated chambers held along a common rail pair.",
  "Three narrow wells on one underlying support frame.",
];
const root = "/studies/resource-capacity-2026-11-02";
---

<section
  class="grid-scroll"
  aria-label="Nine chamber constructions grouped by raised collars, recessed sockets and cradled wells"
>
  <div class="well-options">
    {names.map((name, i) => (
      <article>
        <h4>
          {String(i + 1).padStart(2, "0")} / {name}
        </h4>
        <p class="note">{notes[i]}</p>
        <div class="pair">
          {["normal"].map((size) => (
            <figure>
              <figcaption>
                {size === "normal" ? "Normal · +85" : "Large · +140 · 2× mass"}
              </figcaption>
              <div class="enlargement">
                <img
                  src={`${root}/round3-${i + 1}.svg`}
                  width="320"
                  height="320"
                  alt={`${name}, ${size}, orthographic top-down at eight times scale`}
                />
              </div>
              <div class="actual">
                <img
                  src={`${root}/round3-${i + 1}.svg`}
                  width="40"
                  height="40"
                  alt={`${name}, ${size}, at one times scale`}
                />
              </div>
              <small>8× above · 1× below</small>
            </figure>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>
<style>
.note {
  min-height: 5em;
  font-size: 0.875rem;
  line-height: 1.5;
}
.grid-scroll {
  overflow-x: auto;
}
.well-options {
  display: grid;
  grid-template-columns: repeat(3, 344px);
  gap: 1rem;
  width: max-content;
}
.grid-scroll:focus-visible {
  outline: 2px solid var(--color-action);
  outline-offset: 2px;
}
article {
  border: 1px solid var(--color-border);
  padding: 11px;
  background: var(--color-void);
}
h4 {
  margin: 0 0 1rem;
}
.pair {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 1rem;
}
figure {
  margin: 0;
  width: 320px;
  max-width: 100%;
  text-align: center;
}
figcaption {
  font-size: 0.875rem;
}
.enlargement {
  overflow: auto;
}
.enlargement img {
  display: block;
  width: 320px;
  height: 320px;
  max-width: none;
}
.actual {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64px;
  border-top: 1px solid var(--color-border);
}
.actual img {
  width: 40px;
  height: 40px;
  max-width: none;
}
small {
  color: var(--color-text-muted);
}
</style>
