---
import { buildMounts, defaultBuilds } from "@void-drift/mode-a";
import { FIGHTER } from "../../../../../packages/mode-a/src/lib/fighter";

type Point = readonly [number, number];
const points = (v: readonly Point[]) => v.map((p) => p.join(",")).join(" ");
const mounts = buildMounts(defaultBuilds().balanced)
	.map((m) => (m.group === "aft" ? { ...m, x: m.x - 5 } : m))
	.filter((m) => m.group !== "hull");
type Vessel = { body: Point[]; ridge: Point };
function bottle(x: number, y: number, length: number, width: number): Vessel {
	const body: Point[] = [
		[length / 2, 0],
		[length / 2 - 1, -width * 0.65],
		[length / 2 - 3, -width],
		[-length / 2 + 2, -width],
		[-length / 2, -width * 0.5],
		[-length / 2, width * 0.5],
		[-length / 2 + 2, width],
		[length / 2 - 3, width],
		[length / 2 - 1, width * 0.65],
	];
	return { body: body.map(([a, b]) => [a + x, b + y]), ridge: [x, y] };
}
function sphere(x: number): Vessel {
	return {
		body: Array.from(
			{ length: 8 },
			(_, i) =>
				[
					x + 3.3 * Math.cos((i * Math.PI) / 4),
					3.3 * Math.sin((i * Math.PI) / 4),
				] as Point,
		),
		ridge: [x, 0],
	};
}
const concepts = [
	{
		name: "01 / Twin bottles",
		idea: "Two separate bottles sit side by side, feeding a single magnetic coil channel below them.",
		vessels: [bottle(5, -2.6, 10, 2), bottle(5, 2.6, 10, 2)],
	},
	{
		name: "02 / Long bottle",
		idea: "One elongated reservoir feeds a narrow coil channel. The bottle and accelerator remain distinct parts.",
		vessels: [bottle(4, 0, 14, 3.2)],
	},
	{
		name: "03 / Stacked spheres",
		idea: "Two faceted spherical containers sit in series, with the magnetic coil channel below the second sphere.",
		vessels: [sphere(8), sphere(0.8)],
	},
];
const feed: Vessel = {
	body: [
		[6, -0.65],
		[1, -0.65],
		[1, -3],
		[-1, -3],
		[-3, -1],
		[-3, 1],
		[-1, 3],
		[1, 3],
		[1, 0.65],
		[6, 0.65],
	],
	ridge: [0, 0],
};
const channel: Vessel = {
	body: [
		[-3, -1.4],
		[-12, -1.4],
		[-13, -2.1],
		[-13, 2.1],
		[-12, 1.4],
		[-3, 1.4],
	],
	ridge: [-8, 0],
};
// Match 02.2's fixed 210° sun, with +x model-forward rotated up on screen.
function shade(base: readonly number[], angle: number, slope = 0.85) {
	const amount =
		0.42 +
		1.05 * Math.max(0, Math.cos(angle - (210 * Math.PI) / 180) * slope + 0.25);
	return `rgb(${base.map((v) => Math.round(Math.min(255, v * amount))).join(",")})`;
}
function faceColor(p: Point, q: Point, angle: number, base: readonly number[]) {
	return shade(base, angle + Math.atan2((p[1] + q[1]) / 2, (p[0] + q[0]) / 2));
}
---

<div class="concepts">
	{concepts.map((concept, index) => (
		<article style="color: #ffb52e">
			<h4>{concept.name}</h4>
			<svg
				viewBox="-40 -56 80 102"
				role="img"
				aria-label={`${concept.name} fitted to all four Fighter engine mounts`}
			>
				<defs>
					{[0, ...mounts.map((m) => m.angle)].map((angle, pose) => (
						<g id={`plasma-first-pass-${index}-${pose}`}>
							{[feed, channel, ...concept.vessels].map((vessel) =>
								vessel.body.map((p, i) => (
									<polygon
										points={points([
											vessel.ridge,
											p,
											vessel.body[(i + 1) % vessel.body.length],
										])}
										fill={faceColor(
											[p[0] - vessel.ridge[0], p[1] - vessel.ridge[1]],
											[
												vessel.body[(i + 1) % vessel.body.length][0] -
													vessel.ridge[0],
												vessel.body[(i + 1) % vessel.body.length][1] -
													vessel.ridge[1],
											],
											angle - Math.PI / 2,
											[64, 68, 74],
										)}
									/>
								)),
							)}
							{[-5, -7.5, -10].map((x) => (
								<>
									<polygon
										points={points([
											[x, -2.4],
											[x + 0.8, -2.4],
											[x + 0.8, 0],
											[x, 0],
										])}
										fill={shade([120, 128, 136], angle - Math.PI, 0.5)}
									/>
									<polygon
										points={points([
											[x, 0],
											[x + 0.8, 0],
											[x + 0.8, 2.4],
											[x, 2.4],
										])}
										fill={shade([120, 128, 136], angle, 0.5)}
									/>
									<polygon
										points={points([
											[x + 0.25, -1],
											[x + 0.55, -1],
											[x + 0.55, 1],
											[x + 0.25, 1],
										])}
										fill="currentColor"
									/>
								</>
							))}
							{concept.vessels.map((v) => (
								<polygon
									points={points([
										[v.ridge[0] - 1, v.ridge[1] - 0.35],
										[v.ridge[0] + 1, v.ridge[1] - 0.35],
										[v.ridge[0] + 1, v.ridge[1] + 0.35],
										[v.ridge[0] - 1, v.ridge[1] + 0.35],
									])}
									fill="currentColor"
								/>
							))}
							<polygon
								points="-13,-1.4 -12,-1.4 -12,1.4 -13,1.4"
								fill="currentColor"
							/>
						</g>
					))}
				</defs>
				<g transform="rotate(-90)">
					{mounts.map(
						(m, pose) =>
							m.group === "side" && (
								<use
									href={`#plasma-first-pass-${index}-${pose + 1}`}
									transform={`translate(${m.x} ${m.y}) rotate(${(m.angle * 180) / Math.PI})`}
								/>
							),
					)}
					{FIGHTER.hull.map((p, i) => (
						<polygon
							points={points([
								[-3, 0],
								p,
								FIGHTER.hull[(i + 1) % FIGHTER.hull.length],
							])}
							fill={faceColor(
								p,
								FIGHTER.hull[(i + 1) % FIGHTER.hull.length],
								-Math.PI / 2,
								[105, 160, 177],
							)}
						/>
					))}
					<polygon
						points={points(FIGHTER.ridge)}
						fill={shade([130, 185, 195], -Math.PI / 2, 0.2)}
					/>
					<polygon points={points(FIGHTER.cockpit)} fill="#030609" />
					{mounts.map(
						(m, pose) =>
							m.group === "aft" && (
								<use
									href={`#plasma-first-pass-${index}-${pose + 1}`}
									transform={`translate(${m.x + 5} ${m.y}) rotate(${(m.angle * 180) / Math.PI})`}
								/>
							),
					)}
				</g>
			</svg>
			<div class="detail">
				<svg
					viewBox="-15 -16 30 32"
					role="img"
					aria-label={`${concept.name} enlarged plasma chamber`}
				>
					<use href={`#plasma-first-pass-${index}-0`} transform="rotate(-90)" />
				</svg>
				<p>{concept.idea}</p>
			</div>
		</article>
	))}
</div>
<style>
.concepts {
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: var(--spacing-lg);
	margin-block: var(--spacing-lg);
}
article {
	border: var(--flight-border);
	background: var(--color-void-light);
	padding: var(--spacing-md);
}
h4 {
	color: var(--color-text);
	min-height: 2.7em;
	margin: 0;
	font-size: 1.1rem;
}
svg {
	width: 100%;
	height: 340px;
	display: block;
}
.detail {
	display: grid;
	grid-template-columns: 90px 1fr;
	gap: var(--spacing-md);
	align-items: center;
}
.detail svg {
	height: 130px;
}
p {
	color: var(--color-text);
	margin: 0;
	font-size: var(--font-body);
}
@media (max-width: 900px) {
	.detail {
		grid-template-columns: 1fr;
	}
}
@media (max-width: 620px) {
	.concepts {
		grid-template-columns: 1fr;
	}
}
</style>
