---
const choices = [0, 1, 3, 5];
const designs = [
	[
		"1A / Inner ribbon · shaped faces",
		"A light upper-left face and darker lower-right face give the continuous ribbon a restrained ridge.",
	],
	[
		"1B / Inner ribbon · recessed links",
		"Four short charcoal links sit beneath the sectors and meet the ribbon, giving the ring a shared underlying structure.",
	],
	[
		"2A / Swept connection · tapered facets",
		"The two sweeps gain light and dark faces while retaining their directional silhouette.",
	],
	[
		"2B / Swept connection · lower bridges",
		"Two recessed diagonal bridges join the opposing sweeps beneath the working ring, visible only at its openings.",
	],
	[
		"4A / Inner return · shaded arc",
		"One continuous tonal change gives the inner horseshoe volume and ties it into the terminal faces.",
	],
	[
		"4B / Inner return · shoulder links",
		"Short lower links connect the return to both shoulders; the mouth stays open and the outer silhouette stays quiet.",
	],
	[
		"6A / Terminal sweep · folded planes",
		"A restrained division of each terminal sweep suggests a shallow fold leading into the working arc.",
	],
	[
		"6B / Terminal sweep · recessed crescent",
		"A close charcoal crescent passes beneath both shoulders, joining the two sweeps without an external frame.",
	],
];
const paths = [
	"M0-9L6.4-6.4L9 0L6.4 6.4L0 9L-6.4 6.4L-9 0L-6.4-6.4Z M0-7L-5-5L-7 0L-5 5L0 7L5 5L7 0L5-5Z M-14-1H-8V1H-14Z M8-1H14V1H8Z",
	"M-17-2L-11-3L-4-10L0-13L-8-9L-13-1Z M17 2L11 3L4 10L0 13L8 9L13 1Z",
	"M-18-2L-12-2L-9-5L-11 1L-18 2Z M18 2L12 2L9 5L11-1L18-2Z",
	"M-8 9L-10 2L-8-5L-4-9H4L8-5L10 2L8 9L6 8L8 1L6-4L3-7H-3L-6-4L-8 1L-6 8Z",
	"M-13-4L-10-12L0-17L10-12L13-4L8-10L0-14L-8-10Z",
	"M-12 10L-15 2L-12-6L-12 1L-8 7Z M12 10L15 2L12-6L12 1L8 7Z",
	"M1-21L-13-17L-15-12V13L-11 19L1 21L-10 16L-12 12V-12L-10-15Z",
	"M-1-20H1V20H-1Z",
	"M0-21L-13-17L-16 0L-13 17L0 21L-11 15L-13 0L-11-15Z M3-21L14-16L16 0L14 16L3 21L12 14L13 0L12-14Z",
];
---

<svg width="0" height="0" aria-hidden="true" style="position:absolute">
	<defs>
		{designs.map((_, i) => {
			const choice = choices[Math.floor(i / 2)];
			return (
				<>
					<clipPath id={`depth-yellow-${i}`}>
						<path d={paths[choice]} fill-rule="evenodd" />
						{choice < 3 ? (
							<path d="M-18-3H-13V3H-18Z M13-3H18V3H13Z" />
						) : (
							<path d="M-13 8L-8 4L-4 9L-9 13Z M8 4L13 8L9 13L4 9Z" />
						)}
					</clipPath>
					<g id={`depth-full-${i}`}>
						{i % 2 === 1 && (
							<g fill="#437083">
								{i === 1 && (
									<path d="M-12-13L-8-11L-4-5L-6-3L-11-8Z M8-11L12-13L11-8L6-3L4-5Z M-11 8L-6 3L-4 5L-8 11L-12 13Z M4 5L6 3L11 8L12 13L8 11Z" />
								)}
								{i === 3 && (
									<path d="M-13-9L-10-12L13 9L10 12Z M-13 9L-10 12L13-9L10-12Z" />
								)}
								{i === 5 && (
									<path d="M-15-7L-12-10L-6-5L-8-2Z M12-10L15-7L8-2L6-5Z" />
								)}
								{i === 7 && (
									<path d="M-13 8L-17 1L-14-9L-7-15H7L14-9L17 1L13 8L11 6L14 0L11-7L6-12H-6L-11-7L-14 0L-11 6Z" />
								)}
							</g>
						)}
						<use href={`#graphic-full-${choice}`} />
						<g clip-path={`url(#depth-yellow-${i})`}>
							<path d="M-24-24H24V24H-24Z" fill="#b5c22a" />
							<path d="M-24-24H24L-24 24Z" fill="#d7df62" />
							<path d="M-24 24H24V-12L13 0L6 8Z" fill="#87971e" />
						</g>
						{i % 2 === 1 && (
							<g fill="#7894a4">
								<path
									d={
										choice < 3
											? "M-2-14H1V-10H-2Z M-2 10H1V14H-2Z"
											: "M-2-13H1V-10H-2Z"
									}
								/>
							</g>
						)}
					</g>
				</>
			);
		})}
	</defs>
</svg>
<div class="board">
	<div class="grid">
		{designs.map(([name, note], i) => (
			<article>
				<h4>{name}</h4>
				<svg
					class="large"
					width="260"
					height="260"
					viewBox="-24 -24 48 48"
					role="img"
					aria-label={`${name}, enlarged`}
				>
					<use href={`#depth-full-${i}`} />
				</svg>
				<p class="scale">Enlarged above · 1× below</p>
				<div class="contexts">
					{["Free", "Under wing", "On chassis"].map((label, j) => (
						<figure>
							<svg
								width="80"
								height="72"
								viewBox="-40 -36 80 72"
								role="img"
								aria-label={`${name}, ${label}, 1×`}
							>
								{j === 2 && (
									<path d="M-30-30H22L32 0L22 30H-30Z" fill="#264d6b" />
								)}
								<use href={`#depth-full-${i}`} />
								{j === 1 && <path d="M-40-36H-11L-9 36H-40Z" fill="#437e99" />}
							</svg>
							<figcaption>{label}</figcaption>
						</figure>
					))}
				</div>
				<p>{note}</p>
			</article>
		))}
	</div>
</div>
<p class="caption">
	Blue surfaces are schematic hull-edge fixtures, not production chassis or
	verified mount positions. Under-wing samples cover the left attachment side;
	on-chassis samples place the whole module above the hull. The hull surfaces
	are comparison fixtures. Working shapes are retained; the added paths are
	graphic connection proposals.
</p>
<style>
.board {
	width: 100%;

	overflow-x: auto;
}
.grid {
	display: grid;
	grid-template-columns: repeat(2, minmax(280px, 1fr));
	gap: 16px;
}
article {
	padding: 15px;
	border: 1px solid var(--color-border);
}
h4 {
	margin: 0;
	min-height: 3em;
}
.large {
	display: block;
	width: 100%;
	height: 260px;
	max-width: none;
}
.scale,
.caption {
	color: var(--color-text-muted);
}
.contexts {
	display: flex;
	justify-content: space-between;
}
figure {
	margin: 0;
}
figure svg {
	width: 80px;
	height: 72px;
	max-width: none;
}
figcaption {
	font-size: 12px;
}
article p {
	font-size: 14px;
}
.board:focus-visible {
	outline: 2px solid var(--color-text);
}
</style>
