---
import { buildMounts, defaultBuilds } from "@void-drift/mode-a";
import { FIGHTER } from "../../../../../packages/mode-a/src/lib/fighter";

type Point = readonly [number, number];
const points = (v: readonly Point[]) => v.map((p) => p.join(",")).join(" ");
const mounts = buildMounts(defaultBuilds().balanced)
	.map((m) => (m.group === "aft" ? { ...m, x: m.x - 5 } : m))
	.filter((m) => m.group !== "hull");
const reference = {
	name: "01 / Needle accelerator",
	idea: "A long tapered casing ends in a narrow emission slit: the most direct expression of a focused ion beam.",
	body: [
		[9, 0],
		[5, -3],
		[-8, -3],
		[-11, -1.7],
		[-11, 1.7],
		[-8, 3],
		[5, 3],
	],
	outlet: [
		[-8, -2.7],
		[-11, -1.7],
		[-11, 1.7],
		[-8, 2.7],
	],
	blue: [
		[-10.8, -1.1],
		[-10, -1.1],
		[-10, 1.1],
		[-10.8, 1.1],
	],
	ridge: [1, 0],
};
const concepts = [
	{
		name: "01 / Light · slim needle",
		idea: "A shorter, slimmer accelerator with the same pointed nose, axial facets and single blue slit. Reduced casing bulk suggests a lighter machine.",
		length: 0.8,
		width: 0.75,
	},
	{
		name: "02 / Medium · accepted reference",
		idea: "The exact 02.3 / 01 body, unchanged. Medium is a comparison label here, not a committed third engine in the lineup.",
		length: 1,
		width: 1,
	},
	{
		name: "03 / Heavy · deep needle",
		idea: "Deeper shoulders and a modestly longer casing retain the needle axis. One wider slit preserves the family identity without adding barrels or a new mechanism.",
		length: 1.15,
		width: 1.45,
	},
].map((variant) => {
	const transform = (p: readonly number[]): Point => [
		p[0] * variant.length,
		p[1] * variant.width,
	];
	return {
		name: variant.name,
		idea: variant.idea,
		body: reference.body.map(transform),
		outlet: reference.outlet.map(transform),
		blue: reference.blue.map(transform),
		ridge: transform(reference.ridge),
	};
});
// Match 02.2's fixed 210° sun, with +x model-forward rotated up on screen.
function shade(base: readonly number[], angle: number, slope = 0.85) {
	const amount =
		0.42 +
		1.05 * Math.max(0, Math.cos(angle - (210 * Math.PI) / 180) * slope + 0.25);
	return `rgb(${base.map((v) => Math.round(Math.min(255, v * amount))).join(",")})`;
}
function faceColor(p: Point, q: Point, angle: number, base: readonly number[]) {
	return shade(base, angle + Math.atan2((p[1] + q[1]) / 2, (p[0] + q[0]) / 2));
}
---

<div class="concepts">
	{concepts.map((concept, index) => (
		<article>
			<h4>{concept.name}</h4>
			<svg
				viewBox="-40 -56 80 102"
				role="img"
				aria-label={`${concept.name} fitted to all four Fighter engine mounts`}
			>
				<defs>
					{[0, ...mounts.map((m) => m.angle)].map((angle, pose) => (
						<g id={`ion-family-${index}-${pose}`}>
							{concept.body.map((p, i) => (
								<polygon
									points={points([
										concept.ridge,
										p,
										concept.body[(i + 1) % concept.body.length],
									])}
									fill={faceColor(
										p,
										concept.body[(i + 1) % concept.body.length],
										angle - Math.PI / 2,
										[64, 68, 74],
									)}
								/>
							))}
							<polygon points={points(concept.outlet)} fill="#12171e" />
							<polygon points={points(concept.blue)} fill="#29baff" />
						</g>
					))}
				</defs>
				<g transform="rotate(-90)">
					{mounts.map(
						(m, pose) =>
							m.group === "side" && (
								<use
									href={`#ion-family-${index}-${pose + 1}`}
									transform={`translate(${m.x} ${m.y}) rotate(${(m.angle * 180) / Math.PI})`}
								/>
							),
					)}
					{FIGHTER.hull.map((p, i) => (
						<polygon
							points={points([
								[-3, 0],
								p,
								FIGHTER.hull[(i + 1) % FIGHTER.hull.length],
							])}
							fill={faceColor(
								p,
								FIGHTER.hull[(i + 1) % FIGHTER.hull.length],
								-Math.PI / 2,
								[105, 160, 177],
							)}
						/>
					))}
					<polygon
						points={points(FIGHTER.ridge)}
						fill={shade([130, 185, 195], -Math.PI / 2, 0.2)}
					/>
					<polygon points={points(FIGHTER.cockpit)} fill="#030609" />
					{mounts.map(
						(m, pose) =>
							m.group === "aft" && (
								<use
									href={`#ion-family-${index}-${pose + 1}`}
									transform={`translate(${m.x + 5} ${m.y}) rotate(${(m.angle * 180) / Math.PI})`}
								/>
							),
					)}
				</g>
			</svg>
			<div class="detail">
				<svg
					viewBox="-15 -16 30 32"
					role="img"
					aria-label={`${concept.name} enlarged body and blue outlet`}
				>
					<use href={`#ion-family-${index}-0`} transform="rotate(-90)" />
				</svg>
				<p>{concept.idea}</p>
			</div>
		</article>
	))}
</div>
<style>
.concepts {
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: var(--spacing-lg);
	margin-block: var(--spacing-lg);
}
article {
	border: var(--flight-border);
	background: var(--color-void-light);
	padding: var(--spacing-md);
}
h4 {
	margin: 0;
	font-size: 1.1rem;
}
svg {
	width: 100%;
	height: 340px;
	display: block;
}
.detail {
	display: grid;
	grid-template-columns: 90px 1fr;
	gap: var(--spacing-md);
	align-items: center;
}
.detail svg {
	height: 130px;
}
p {
	margin: 0;
	font-size: var(--font-body);
}
@media (max-width: 900px) {
	.detail {
		grid-template-columns: 1fr;
	}
}
@media (max-width: 620px) {
	.concepts {
		grid-template-columns: 1fr;
	}
}
</style>
