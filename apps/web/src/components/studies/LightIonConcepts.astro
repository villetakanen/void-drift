---
import { buildMounts, defaultBuilds } from "@void-drift/mode-a";
import { FIGHTER } from "../../../../../packages/mode-a/src/lib/fighter";

type Point = readonly [number, number];
const points = (v: readonly Point[]) => v.map((p) => p.join(",")).join(" ");
const mounts = buildMounts(defaultBuilds().balanced)
	.map((m) => (m.group === "aft" ? { ...m, x: m.x - 5 } : m))
	.filter((m) => m.group !== "hull");
const concepts: {
	name: string;
	idea: string;
	body: Point[];
	outlet: Point[];
	blue: Point[];
	ridge: Point;
}[] = [
	{
		name: "01 / Needle accelerator",
		idea: "A long tapered casing ends in a narrow emission slit: the most direct expression of a focused ion beam.",
		body: [
			[9, 0],
			[5, -3],
			[-8, -3],
			[-11, -1.7],
			[-11, 1.7],
			[-8, 3],
			[5, 3],
		],
		outlet: [
			[-8, -2.7],
			[-11, -1.7],
			[-11, 1.7],
			[-8, 2.7],
		],
		blue: [
			[-10.8, -1.1],
			[-10, -1.1],
			[-10, 1.1],
			[-10.8, 1.1],
		],
		ridge: [1, 0],
	},
	{
		name: "02 / Recessed dish",
		idea: "A compact housing opens into a shallow faceted dish, with a small blue emitter recessed at its center.",
		body: [
			[7, 0],
			[4, -3],
			[-4, -3],
			[-7, -4.5],
			[-10, -4.5],
			[-11, 0],
			[-10, 4.5],
			[-7, 4.5],
			[-4, 3],
			[4, 3],
		],
		outlet: [
			[-6, -3.5],
			[-9, -3.5],
			[-10, 0],
			[-9, 3.5],
			[-6, 3.5],
			[-8, 0],
		],
		blue: [
			[-9, -1.2],
			[-8, -1.7],
			[-7, -1],
			[-7, 1],
			[-8, 1.7],
			[-9, 1.2],
		],
		ridge: [1, 0],
	},
	{
		name: "03 / Collared tube",
		idea: "A barrel-like polygonal body ends in a thick protective collar around one blue aperture.",
		body: [
			[8, 0],
			[5, -3.5],
			[-6, -3.5],
			[-7, -4.5],
			[-10, -4.5],
			[-10, 4.5],
			[-7, 4.5],
			[-6, 3.5],
			[5, 3.5],
		],
		outlet: [
			[-7, -3.3],
			[-10, -3.3],
			[-10, 3.3],
			[-7, 3.3],
		],
		blue: [
			[-9.5, -2.1],
			[-8.5, -2.1],
			[-8.5, 2.1],
			[-9.5, 2.1],
		],
		ridge: [2, 0],
	},
	{
		name: "04 / Split focusing fork",
		idea: "Two charcoal focusing prongs shelter one central blue emitter. The gap suggests a beam constrained along its axis.",
		body: [
			[8, 0],
			[4, -3.5],
			[-10, -3.5],
			[-11, -2],
			[-6, -1],
			[-6, 1],
			[-11, 2],
			[-10, 3.5],
			[4, 3.5],
		],
		outlet: [
			[-5, -1.7],
			[-7, -1],
			[-7, 1],
			[-5, 1.7],
		],
		blue: [
			[-6.5, -0.8],
			[-5.5, -0.8],
			[-5.5, 0.8],
			[-6.5, 0.8],
		],
		ridge: [2, 0],
	},
	{
		name: "05 / Stepped field cage",
		idea: "A sequence of angular shoulders narrows into a small outlet, suggesting successive acceleration stages.",
		body: [
			[8, 0],
			[4, -4],
			[-1, -4],
			[-1, -3.3],
			[-5, -3.3],
			[-5, -2.5],
			[-9, -2.5],
			[-11, -1.5],
			[-11, 1.5],
			[-9, 2.5],
			[-5, 2.5],
			[-5, 3.3],
			[-1, 3.3],
			[-1, 4],
			[4, 4],
		],
		outlet: [
			[-9, -2],
			[-11, -1.5],
			[-11, 1.5],
			[-9, 2],
		],
		blue: [
			[-10.7, -1],
			[-9.8, -1],
			[-9.8, 1],
			[-10.7, 1],
		],
		ridge: [3, 0],
	},
	{
		name: "06 / Armored emitter",
		idea: "A short shielded wedge surrounds a blue slit. Broad armor planes make the engine read as a compact installed machine.",
		body: [
			[7, 0],
			[3, -4],
			[-6, -4],
			[-9, -2.5],
			[-9, 2.5],
			[-6, 4],
			[3, 4],
		],
		outlet: [
			[-5, -3],
			[-9, -2.5],
			[-9, 2.5],
			[-5, 3],
			[-6, 0],
		],
		blue: [
			[-8.5, -1.5],
			[-7.5, -1.5],
			[-7.5, 1.5],
			[-8.5, 1.5],
		],
		ridge: [1, 0],
	},
];
// Match 02.2's fixed 210° sun, with +x model-forward rotated up on screen.
function shade(base: readonly number[], angle: number, slope = 0.85) {
	const amount =
		0.42 +
		1.05 * Math.max(0, Math.cos(angle - (210 * Math.PI) / 180) * slope + 0.25);
	return `rgb(${base.map((v) => Math.round(Math.min(255, v * amount))).join(",")})`;
}
function faceColor(p: Point, q: Point, angle: number, base: readonly number[]) {
	return shade(base, angle + Math.atan2((p[1] + q[1]) / 2, (p[0] + q[0]) / 2));
}
---

<div class="concepts">
	{concepts.map((concept, index) => (
		<article>
			<h4>{concept.name}</h4>
			<svg
				viewBox="-40 -56 80 102"
				role="img"
				aria-label={`${concept.name} fitted to all four Fighter engine mounts`}
			>
				<defs>
					{[0, ...mounts.map((m) => m.angle)].map((angle, pose) => (
						<g id={`ion-concept-${index}-${pose}`}>
							{concept.body.map((p, i) => (
								<polygon
									points={points([
										concept.ridge,
										p,
										concept.body[(i + 1) % concept.body.length],
									])}
									fill={faceColor(
										p,
										concept.body[(i + 1) % concept.body.length],
										angle - Math.PI / 2,
										[64, 68, 74],
									)}
								/>
							))}
							<polygon points={points(concept.outlet)} fill="#12171e" />
							<polygon points={points(concept.blue)} fill="#29baff" />
						</g>
					))}
				</defs>
				<g transform="rotate(-90)">
					{mounts.map(
						(m, pose) =>
							m.group === "side" && (
								<use
									href={`#ion-concept-${index}-${pose + 1}`}
									transform={`translate(${m.x} ${m.y}) rotate(${(m.angle * 180) / Math.PI})`}
								/>
							),
					)}
					{FIGHTER.hull.map((p, i) => (
						<polygon
							points={points([
								[-3, 0],
								p,
								FIGHTER.hull[(i + 1) % FIGHTER.hull.length],
							])}
							fill={faceColor(
								p,
								FIGHTER.hull[(i + 1) % FIGHTER.hull.length],
								-Math.PI / 2,
								[105, 160, 177],
							)}
						/>
					))}
					<polygon
						points={points(FIGHTER.ridge)}
						fill={shade([130, 185, 195], -Math.PI / 2, 0.2)}
					/>
					<polygon points={points(FIGHTER.cockpit)} fill="#030609" />
					{mounts.map(
						(m, pose) =>
							m.group === "aft" && (
								<use
									href={`#ion-concept-${index}-${pose + 1}`}
									transform={`translate(${m.x + 4} ${m.y}) rotate(${(m.angle * 180) / Math.PI})`}
								/>
							),
					)}
				</g>
			</svg>
			<div class="detail">
				<svg
					viewBox="-12 -13 24 26"
					role="img"
					aria-label={`${concept.name} enlarged body and blue outlet`}
				>
					<use href={`#ion-concept-${index}-0`} transform="rotate(-90)" />
				</svg>
				<p>{concept.idea}</p>
			</div>
		</article>
	))}
</div>
<style>
.concepts {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: var(--spacing-lg);
	margin-block: var(--spacing-lg);
}
article {
	border: var(--flight-border);
	background: var(--color-void-light);
	padding: var(--spacing-md);
}
h4 {
	margin: 0;
	font-size: 1.1rem;
}
svg {
	width: 100%;
	height: 340px;
	display: block;
}
.detail {
	display: grid;
	grid-template-columns: 90px 1fr;
	gap: var(--spacing-md);
	align-items: center;
}
.detail svg {
	height: 130px;
}
p {
	margin: 0;
	font-size: var(--font-body);
}
@media (max-width: 620px) {
	.concepts {
		grid-template-columns: 1fr;
	}
}
</style>
