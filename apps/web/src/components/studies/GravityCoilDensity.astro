---
interface Props {
	selected?: boolean;
}
const { selected = false } = Astro.props;
const prefix = selected ? "selected" : "density";
const variants = [
	{ id: "broad", count: 4, name: "A / Four broad sections" },
	{ id: "fine", count: 8, name: "B / Eight narrow sections" },
].filter((v) => !selected || v.id === "fine");
const p = (r: number, a: number) => [r * Math.cos(a), r * Math.sin(a)];
const points = (ps: number[][]) => ps.map((v) => v.join(",")).join(" ");
const arc = (r: number, a: number, b: number) =>
	Array.from({ length: 5 }, (_, i) => p(r, a + ((b - a) * i) / 4));
---

<svg width="0" height="0" aria-hidden="true" style="position:absolute">
	<defs>
		{variants.map((v) => (
			<g id={`${prefix}-${v.id}`}>
				{Array.from({ length: v.count }, (_, i) => {
					const a = (i * 2 * Math.PI) / v.count + 0.07,
						b = ((i + 1) * 2 * Math.PI) / v.count - 0.07;
					return (
						<g>
							<polygon
								points={points([...arc(16, a, b), ...arc(8, b, a)])}
								fill="#304759"
							/>
							<polygon
								points={points([...arc(15, a, b), ...arc(10, b, a)])}
								fill={
									Math.sin((a + b) / 2) + Math.cos((a + b) / 2) < 0
										? "#a2b7bf"
										: "#607d8d"
								}
							/>
							<polygon
								points={points([...arc(10, a, b), ...arc(8, b, a)])}
								fill="#263c4b"
							/>
						</g>
					);
				})}
				<path
					d="M-18-3H-13V3H-18Z M13-3H18V3H13Z"
					fill={selected ? "#cedb17" : "#7894a4"}
				/>
			</g>
		))}
	</defs>
</svg>
<div class="forms">
	{variants.map((v) => (
		<article>
			<h4>{v.name}</h4>
			<svg
				class="large"
				viewBox="-24 -24 48 48"
				role="img"
				aria-label={`${v.name}, enlarged`}
			>
				<use href={`#${prefix}-${v.id}`} />
			</svg>
			<div class="actual">
				<svg
					width="64"
					height="64"
					viewBox="-32 -32 64 64"
					role="img"
					aria-label={`${v.name}, 1×`}
				>
					<use href={`#${prefix}-${v.id}`} />
				</svg>
				<span>1× · 36 px across</span>
			</div>
		</article>
	))}
</div>
<style>
.forms {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
	gap: var(--spacing-lg);
}
article {
	border: 1px solid var(--color-border);
	padding: var(--spacing-lg);
}
h4 {
	margin: 0;
}
.large {
	width: 100%;
	height: 260px;
}
.actual {
	display: flex;
	align-items: center;
	gap: var(--spacing-md);
	color: var(--color-text-muted);
}
.actual svg {
	width: 64px;
	height: 64px;
	flex: none;
}
</style>
