---

<div class="reference-board">
  {references.map(({ title, image, source, credit, alt, note }) => (
    <figure>
      <a class="preview" href={image} aria-label={`Open image of ${title}`}>
        <img
          src={image}
          alt={alt}
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
        />
      </a>
      <figcaption>
        <strong>{title}</strong>
        <p>{note}</p>
        <a href={source}>{credit}</a>
      </figcaption>
    </figure>
  ))}
</div>

<style>
.reference-board {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--spacing-lg);
  margin-block: var(--spacing-md);
}
figure {
  margin: 0;
  min-width: 0;
}
.preview {
  display: grid;
  aspect-ratio: 16 / 10;
  place-items: center;
  border: 1px solid var(--color-border);
  background: var(--color-void);
}
.preview img {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 0;
  object-fit: contain;
}
figcaption {
  font-size: var(--font-size-caption);
  margin-top: var(--spacing-sm);
}
figcaption p {
  margin: var(--spacing-xs) 0;
  color: var(--color-text-muted);
}
</style>
