---
import { FIGHTER } from "../../../../../packages/mode-a/src/lib/fighter";

type Point = readonly [number, number];
type Facet = {
	points: readonly Point[];
	shade: 0 | 1 | 2 | 3 | 4 | 5;
};

interface Ab306Variant {
	name: string;
	idea: string;
	facets: readonly Facet[];
}

const pts = (list: readonly Point[]) => list.map((p) => p.join(",")).join(" ");

const palette = [
	FIGHTER.facets[0], // #c8f4f0 (0: brightest)
	FIGHTER.facets[1], // #83c7d0 (1: light)
	FIGHTER.facets[5], // #6193a9 (2: medium-light — side & rear winglet left)
	FIGHTER.facets[2], // #437e99 (3: medium — outer wingtip left / AB-3 flank right)
	FIGHTER.facets[4], // #365d79 (4: dark — side & rear winglet right)
	FIGHTER.facets[3], // #264d6b (5: deepest shadow — outer wingtip right)
] as const;

// Nose facets (unchanged from 08.09 / AB3-06)
const noseFacets: readonly Facet[] = [
	{
		points: [
			[-3, -25],
			[0, -25],
			[0, -16],
			[-3, -10],
			[-6, -10],
		],
		shade: 0,
	},
	{
		points: [
			[0, -25],
			[3, -25],
			[6, -10],
			[3, -10],
			[0, -16],
		],
		shade: 2,
	},
];

// Outer wingtip bevel facets (unchanged from 08.09 / AB3-06)
const outerWingtipFacets: readonly Facet[] = [
	{
		points: [
			[-6, -10],
			[-13.5, 12.5],
			[-18, 6.5],
		],
		shade: 3,
	},
	{
		points: [
			[6, -10],
			[18, 6.5],
			[13.5, 12.5],
		],
		shade: 5,
	},
];

// Default middle winglet facets (shade 2 left, shade 4 right)
const defaultMidWingletFacets: readonly Facet[] = [
	{
		points: [
			[-6, -10],
			[-9.5, 11],
			[-13.5, 12.5],
		],
		shade: 2,
	},
	{
		points: [
			[6, -10],
			[13.5, 12.5],
			[9.5, 11],
		],
		shade: 4,
	},
];

// Default bright inner shoulder facets (shade 0 left, shade 2 right)
const defaultShoulderFacets: readonly Facet[] = [
	{
		points: [
			[-6, -10],
			[-3, -10],
			[-3, -1],
			[-5, 9],
			[-9.5, 11],
		],
		shade: 0,
	},
	{
		points: [
			[6, -10],
			[9.5, 11],
			[5, 9],
			[3, -1],
			[3, -10],
		],
		shade: 2,
	},
];

// Untouched AB-3 bright chassis flanks + truncated central spine
const ab3ChassisFacets: readonly Facet[] = [
	{
		points: [
			[-3, -1],
			[-1.4, 24.5],
			[-3.3, 24.5],
			[-5, 9],
		],
		shade: 0,
	},
	{
		points: [
			[3, -1],
			[5, 9],
			[3.3, 24.5],
			[1.4, 24.5],
		],
		shade: 3,
	},
	{
		points: [
			[-3, -1],
			[0, 3.5],
			[0, 24.5],
			[-1.4, 24.5],
		],
		shade: 1,
	},
	{
		points: [
			[0, 3.5],
			[3, -1],
			[1.4, 24.5],
			[0, 24.5],
		],
		shade: 4,
	},
];

const variants: readonly Ab306Variant[] = [
	{
		name: "06.1 / Parallel trailing edges (Matched angle)",
		idea: "Keeps AB3-06 intact, but angles the rear winglet’s bottom edge ((±7.4, 18.8) → (±4, 17.3)) parallel to the side winglet’s trailing edge ((±13.5, 12.5) → (±5, 9)), so both winglets sit at the exact same pitch.",
		facets: [
			...noseFacets,
			...outerWingtipFacets,
			...defaultMidWingletFacets,
			...defaultShoulderFacets,
			{
				points: [
					[-9.5, 11],
					[-5, 9],
					[-4, 17.3],
					[-7.4, 18.8],
				],
				shade: 2,
			},
			{
				points: [
					[9.5, 11],
					[7.4, 18.8],
					[4, 17.3],
					[5, 9],
				],
				shade: 4,
			},
			...ab3ChassisFacets,
		],
	},
	{
		name: "06.2 / Unpinched winglet bridge (Shared edge at waist)",
		idea: "Pulls the bright shoulder corner inward from (±9.5, 11) to (±7.2, 10) so the side winglet (shade 2/4) and rear winglet (shade 2/4) share a 2.5-unit bridge instead of pinching to a single point.",
		facets: [
			...noseFacets,
			...outerWingtipFacets,
			// Mid winglet reaches inward to (±7.2, 10)
			{
				points: [
					[-6, -10],
					[-7.2, 10],
					[-9.5, 11],
					[-13.5, 12.5],
				],
				shade: 2,
			},
			{
				points: [
					[6, -10],
					[13.5, 12.5],
					[9.5, 11],
					[7.2, 10],
				],
				shade: 4,
			},
			// Bright shoulder stops at (±7.2, 10)
			{
				points: [
					[-6, -10],
					[-3, -10],
					[-3, -1],
					[-5, 9],
					[-7.2, 10],
				],
				shade: 0,
			},
			{
				points: [
					[6, -10],
					[7.2, 10],
					[5, 9],
					[3, -1],
					[3, -10],
				],
				shade: 2,
			},
			// Rear winglet meets the mid winglet across the (±9.5, 11) -> (±7.2, 10) bridge
			{
				points: [
					[-9.5, 11],
					[-7.2, 10],
					[-5, 9],
					[-4, 18.5],
					[-7, 18],
				],
				shade: 2,
			},
			{
				points: [
					[9.5, 11],
					[7, 18],
					[4, 18.5],
					[5, 9],
					[7.2, 10],
				],
				shade: 4,
			},
			...ab3ChassisFacets,
		],
	},
	{
		name: "06.3 / Continuous single-polygon winglet sheet",
		idea: "Uses the unpinched (±7.2, 10) waist bridge from 06.2 and merges the side winglet and rear winglet into one continuous polygon (shade 2 left / shade 4 right) on the exact same plane.",
		facets: [
			...noseFacets,
			...outerWingtipFacets,
			// Bright shoulder stops at (±7.2, 10)
			{
				points: [
					[-6, -10],
					[-3, -10],
					[-3, -1],
					[-5, 9],
					[-7.2, 10],
				],
				shade: 0,
			},
			{
				points: [
					[6, -10],
					[7.2, 10],
					[5, 9],
					[3, -1],
					[3, -10],
				],
				shade: 2,
			},
			// Merged side winglet + rear winglet as one unbroken surface
			{
				points: [
					[-6, -10],
					[-7.2, 10],
					[-5, 9],
					[-4, 18.5],
					[-7, 18],
					[-9.5, 11],
					[-13.5, 12.5],
				],
				shade: 2,
			},
			{
				points: [
					[6, -10],
					[13.5, 12.5],
					[9.5, 11],
					[7, 18],
					[4, 18.5],
					[5, 9],
					[7.2, 10],
				],
				shade: 4,
			},
			...ab3ChassisFacets,
		],
	},
	{
		name: "06.4 / Wider outer step ((±11, 11.6) → (±7.6, 18))",
		idea: "Starts the rear winglet’s outer edge partway out along the side winglet’s bottom edge at (±11, 11.6) instead of (±9.5, 11), so the rear winglet visibly overlaps and continues the side winglet.",
		facets: [
			...noseFacets,
			...outerWingtipFacets,
			...defaultMidWingletFacets,
			...defaultShoulderFacets,
			{
				points: [
					[-11, 11.6],
					[-9.5, 11],
					[-5, 9],
					[-4, 18.5],
					[-7.6, 18],
				],
				shade: 2,
			},
			{
				points: [
					[11, 11.6],
					[7.6, 18],
					[4, 18.5],
					[5, 9],
					[9.5, 11],
				],
				shade: 4,
			},
			...ab3ChassisFacets,
		],
	},
	{
		name: "06.5 / Collinear inner crease ((±6, -10) → (±7.8, 10.2) → (±4, 18.5))",
		idea: "Aligns the inner shoulder boundary so the side winglet and rear winglet share a smooth inner curve, while the outer rear edge runs from (±10.5, 11.4) down to (±7.4, 18.2).",
		facets: [
			...noseFacets,
			...outerWingtipFacets,
			{
				points: [
					[-6, -10],
					[-7.8, 10.2],
					[-10.5, 11.4],
					[-13.5, 12.5],
				],
				shade: 2,
			},
			{
				points: [
					[6, -10],
					[13.5, 12.5],
					[10.5, 11.4],
					[7.8, 10.2],
				],
				shade: 4,
			},
			{
				points: [
					[-6, -10],
					[-3, -10],
					[-3, -1],
					[-5, 9],
					[-7.8, 10.2],
				],
				shade: 0,
			},
			{
				points: [
					[6, -10],
					[7.8, 10.2],
					[5, 9],
					[3, -1],
					[3, -10],
				],
				shade: 2,
			},
			{
				points: [
					[-10.5, 11.4],
					[-7.8, 10.2],
					[-5, 9],
					[-4, 18.5],
					[-7.4, 18.2],
				],
				shade: 2,
			},
			{
				points: [
					[10.5, 11.4],
					[7.4, 18.2],
					[4, 18.5],
					[5, 9],
					[7.8, 10.2],
				],
				shade: 4,
			},
			...ab3ChassisFacets,
		],
	},
	{
		name: "06.6 / Two-ribbon rear winglet (Matching outer bevel)",
		idea: "Gives the AB3-06 rear winglet the same two-plane cross-section as the side wing: an inner winglet plane in shade 2/4 plus an outer stabilizer bevel in shade 3/5.",
		facets: [
			...noseFacets,
			...outerWingtipFacets,
			...defaultMidWingletFacets,
			...defaultShoulderFacets,
			// Inner rear winglet plane (shade 2 / 4, matching mid winglet)
			{
				points: [
					[-8.2, 10.4],
					[-5, 9],
					[-4, 18.5],
					[-6, 18.2],
				],
				shade: 2,
			},
			{
				points: [
					[8.2, 10.4],
					[6, 18.2],
					[4, 18.5],
					[5, 9],
				],
				shade: 4,
			},
			// Outer rear stabilizer bevel (shade 3 / 5, matching outer wingtip bevel)
			{
				points: [
					[-10.5, 11.4],
					[-8.2, 10.4],
					[-6, 18.2],
					[-7.6, 17.8],
				],
				shade: 3,
			},
			{
				points: [
					[10.5, 11.4],
					[7.6, 17.8],
					[6, 18.2],
					[8.2, 10.4],
				],
				shade: 5,
			},
			...ab3ChassisFacets,
		],
	},
	{
		name: "06.7 / Wingtip-parallel aft bevel ((±7.4, 16.8) → (±3.9, 19.2))",
		idea: "Cuts the rear winglet’s lower edge at the same inward bevel angle as the forward wingtip ((±18, 6.5) → (±13.5, 12.5)), while keeping the unpinched (±7.5, 10.1) bridge.",
		facets: [
			...noseFacets,
			...outerWingtipFacets,
			{
				points: [
					[-6, -10],
					[-7.5, 10.1],
					[-9.5, 11],
					[-13.5, 12.5],
				],
				shade: 2,
			},
			{
				points: [
					[6, -10],
					[13.5, 12.5],
					[9.5, 11],
					[7.5, 10.1],
				],
				shade: 4,
			},
			{
				points: [
					[-6, -10],
					[-3, -10],
					[-3, -1],
					[-5, 9],
					[-7.5, 10.1],
				],
				shade: 0,
			},
			{
				points: [
					[6, -10],
					[7.5, 10.1],
					[5, 9],
					[3, -1],
					[3, -10],
				],
				shade: 2,
			},
			{
				points: [
					[-9.5, 11],
					[-7.5, 10.1],
					[-5, 9],
					[-3.9, 19.2],
					[-7.4, 16.8],
				],
				shade: 2,
			},
			{
				points: [
					[9.5, 11],
					[7.4, 16.8],
					[3.9, 19.2],
					[5, 9],
					[7.5, 10.1],
				],
				shade: 4,
			},
			...ab3ChassisFacets,
		],
	},
	{
		name: "06.8 / Slotted air-gap continuation (Separated, same level & angle)",
		idea: "Leaves a crisp 1.3-unit parallel gap behind the side winglet’s trailing edge ((±10, 12.5) → (±4.8, 10.3)), then continues the rear winglet at the exact same shade (2/4) and parallel trailing angle.",
		facets: [
			...noseFacets,
			...outerWingtipFacets,
			...defaultMidWingletFacets,
			...defaultShoulderFacets,
			{
				points: [
					[-9.6, 12.4],
					[-4.8, 10.3],
					[-4, 18.2],
					[-7.2, 19.4],
				],
				shade: 2,
			},
			{
				points: [
					[9.6, 12.4],
					[7.2, 19.4],
					[4, 18.2],
					[4.8, 10.3],
				],
				shade: 4,
			},
			...ab3ChassisFacets,
		],
	},
	{
		name: "06.9 / Unpinched + parallel trailing edge (06.1 + 06.2 combined)",
		idea: "Combines the unpinched (±7.4, 10.1) winglet bridge with the parallel bottom edge ((±7.3, 18.8) → (±4, 17.4)), so the side winglet and rear winglet share both a physical bridge and parallel edge angles.",
		facets: [
			...noseFacets,
			...outerWingtipFacets,
			{
				points: [
					[-6, -10],
					[-7.4, 10.1],
					[-9.5, 11],
					[-13.5, 12.5],
				],
				shade: 2,
			},
			{
				points: [
					[6, -10],
					[13.5, 12.5],
					[9.5, 11],
					[7.4, 10.1],
				],
				shade: 4,
			},
			{
				points: [
					[-6, -10],
					[-3, -10],
					[-3, -1],
					[-5, 9],
					[-7.4, 10.1],
				],
				shade: 0,
			},
			{
				points: [
					[6, -10],
					[7.4, 10.1],
					[5, 9],
					[3, -1],
					[3, -10],
				],
				shade: 2,
			},
			{
				points: [
					[-9.5, 11],
					[-7.4, 10.1],
					[-5, 9],
					[-4, 17.4],
					[-7.3, 18.8],
				],
				shade: 2,
			},
			{
				points: [
					[9.5, 11],
					[7.3, 18.8],
					[4, 17.4],
					[5, 9],
					[7.4, 10.1],
				],
				shade: 4,
			},
			...ab3ChassisFacets,
		],
	},
];

// Reference cockpit
const cockpitLeft: readonly Point[] = [
	[0, -16],
	[-3, -10],
	[-3, -1],
	[0, 3.5],
];
const cockpitRight: readonly Point[] = [
	[0, -16],
	[3, -10],
	[3, -1],
	[0, 3.5],
];
---

<div class="study-block">
	<div class="variant-grid">
		{variants.map((v) => (
			<figure class="variant-card">
				<svg
					viewBox="-24 -30 48 62"
					role="img"
					aria-label={`LHI Wasp AB3-06 refinement ${v.name}`}
				>
					<line x1="0" y1="-29" x2="0" y2="30" class="axis" />
					<line x1="-22" y1="0" x2="22" y2="0" class="axis" />

					{v.facets.map((f) => (
						<polygon points={pts(f.points)} fill={palette[f.shade]} />
					))}

					<polygon points={pts(cockpitLeft)} fill="#000000" />
					<polygon points={pts(cockpitRight)} fill="#000000" />
				</svg>
				<figcaption>
					<div class="variant-name">{v.name}</div>
					<p>{v.idea}</p>
				</figcaption>
			</figure>
		))}
	</div>
</div>

<style>
.study-block {
	display: flex;
	flex-direction: column;
	gap: 1rem;
	margin: 1rem 0 1.5rem;
}

.variant-grid {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
	gap: 1rem;
}

.variant-card {
	margin: 0;
	padding: 0.85rem;
	background: var(--bg-secondary, #16162a);
	border: 1px solid var(--border-default, rgba(255, 255, 255, 0.12));
	border-radius: 6px;
	display: flex;
	flex-direction: column;
	gap: 0.55rem;
}

.variant-card svg {
	width: 100%;
	height: 230px;
	display: block;
	background: radial-gradient(
		circle at 50% 45%,
		rgba(97, 147, 169, 0.12),
		rgba(10, 12, 22, 0.92) 75%
	);
	border-radius: 4px;
}

.axis {
	stroke: rgba(255, 255, 255, 0.06);
	stroke-width: 0.25;
	stroke-dasharray: 1 1;
}

figcaption {
	display: flex;
	flex-direction: column;
	gap: 0.25rem;
}

.variant-name {
	font-family: var(--font-mono, monospace);
	font-size: 0.78rem;
	font-weight: 600;
	color: var(--text-primary, #f0f4f8);
}

figcaption p {
	margin: 0;
	font-size: 0.78rem;
	line-height: 1.4;
	color: var(--text-secondary, #94a3b8);
}
</style>
