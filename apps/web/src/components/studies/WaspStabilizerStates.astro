---
import { SCOUT } from "../../../../../packages/mode-a/src/lib/scout";
import WaspHull from "./WaspHull.astro";

const states = [
	{
		state: "coast",
		name: "01 / Coasting",
		note: "No input. All four stabilizers rest; the ship holds its heading.",
	},
	{
		state: "turn",
		name: "02 / Turning left",
		note: "Left input. Forward-right and aft-left fire outward, pushing the nose left and the tail right.",
	},
	{
		state: "arrest",
		name: "03 / Released",
		note: "Input released. The opposite pair fires until the rotation stops, then rests.",
	},
] as const;
const flightScale = 0.65;
const scoutFacets = SCOUT.facets.map((facet) => ({
	points: facet.points.map(([x, y]) => `${x},${y}`).join(" "),
	color: facet.color,
}));
---

<div class="states">
	<label class="toggle"
		><input type="checkbox">
		Show slot footprints</label
	>
	<div class="cards">
		{states.map((s) => (
			<figure>
				<figcaption>{s.name}</figcaption>
				<svg
					viewBox="-22 -24 44 48"
					role="img"
					aria-label={`${s.name}. ${s.note}`}
				>
					<WaspHull state={s.state} slots />
				</svg>
				<p>{s.note}</p>
			</figure>
		))}
	</div>
	<figure class="flight">
		<figcaption>
			Flight scale · 0.65 pixels per ship unit · Wasp coasting, turning,
			released · Scout
		</figcaption>
		<svg
			width="360"
			height="90"
			viewBox="0 0 360 90"
			role="img"
			aria-label="The three Wasp states and the Scout drawn at the real flight drawing scale. The Wasp is about 26 pixels long; the Scout about 34."
		>
			<rect width="360" height="90" fill="#050510" />
			{states.map((s, i) => (
				<g transform={`translate(${60 + i * 80} 42) scale(${flightScale})`}>
					<WaspHull state={s.state} />
				</g>
			))}
			<g transform={`translate(300 44) scale(${flightScale}) rotate(-90)`}>
				{scoutFacets.map((facet) => (
					<polygon points={facet.points} fill={facet.color} />
				))}
				<circle
					cx={SCOUT.cockpit.x}
					cy="0"
					r={SCOUT.cockpit.collarRadius}
					fill="#437e99"
				/>
				<circle
					cx={SCOUT.cockpit.x}
					cy="0"
					r={SCOUT.cockpit.radius}
					fill="#000"
				/>
			</g>
		</svg>
	</figure>
</div>
<style>
.toggle {
	display: flex;
	align-items: center;
	gap: var(--spacing-sm);
	min-height: 44px;
	margin-bottom: var(--spacing-md);
	cursor: pointer;
}
input {
	accent-color: var(--color-acid-lime);
	width: 20px;
	height: 20px;
}
input:focus-visible {
	outline: 2px solid var(--color-acid-lime);
	outline-offset: 4px;
}
.cards {
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: var(--spacing-md);
}
figure {
	margin: 0;
	padding: var(--spacing-md);
	border: var(--flight-border);
}
figcaption {
	color: var(--color-acid-lime);
	font: var(--font-small) var(--font-flight);
}
.cards svg {
	display: block;
	width: 100%;
	height: 300px;
	margin-block: var(--spacing-md);
}
.states:not(:has(input:checked)) :global(.slots) {
	display: none;
}
figure p {
	margin: 0;
}
.flight {
	margin-top: var(--spacing-md);
}
.flight svg {
	display: block;
	margin-top: var(--spacing-md);
	max-width: 100%;
	border: var(--flight-border);
}
@media (max-width: 900px) {
	.cards {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
}
@media (max-width: 580px) {
	.cards {
		grid-template-columns: 1fr;
	}
}
</style>
