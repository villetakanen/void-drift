---
import { ENGINE_ART } from "../../../../../packages/mode-a/src/lib/engine-art";
import { FIGHTER } from "../../../../../packages/mode-a/src/lib/fighter";

type Point = readonly [number, number];
type Facet = {
	points: readonly Point[];
	shade: 0 | 1 | 2 | 3 | 4 | 5;
};

const pts = (list: readonly Point[]) => list.map((p) => p.join(",")).join(" ");

const palette = [
	FIGHTER.facets[0], // #c8f4f0 (0: brightest)
	FIGHTER.facets[1], // #83c7d0 (1: light)
	FIGHTER.facets[5], // #6193a9 (2: medium-light — side & rear winglet left)
	FIGHTER.facets[2], // #437e99 (3: medium — outer wingtip left / AB-3 flank right)
	FIGHTER.facets[4], // #365d79 (4: dark — side & rear winglet right)
	FIGHTER.facets[3], // #264d6b (5: deepest shadow — outer wingtip right)
] as const;

// Approved plain hull: 06.9 / Unpinched + parallel trailing edge (06.1 + 06.2 combined)
const hull069Facets: readonly Facet[] = [
	// Nose
	{
		points: [
			[-3, -25],
			[0, -25],
			[0, -16],
			[-3, -10],
			[-6, -10],
		],
		shade: 0,
	},
	{
		points: [
			[0, -25],
			[3, -25],
			[6, -10],
			[3, -10],
			[0, -16],
		],
		shade: 2,
	},
	// Outer wingtip bevel
	{
		points: [
			[-6, -10],
			[-13.5, 12.5],
			[-18, 6.5],
		],
		shade: 3,
	},
	{
		points: [
			[6, -10],
			[18, 6.5],
			[13.5, 12.5],
		],
		shade: 5,
	},
	// Unpinched middle winglet
	{
		points: [
			[-6, -10],
			[-7.4, 10.1],
			[-9.5, 11],
			[-13.5, 12.5],
		],
		shade: 2,
	},
	{
		points: [
			[6, -10],
			[13.5, 12.5],
			[9.5, 11],
			[7.4, 10.1],
		],
		shade: 4,
	},
	// Bright inner shoulder
	{
		points: [
			[-6, -10],
			[-3, -10],
			[-3, -1],
			[-5, 9],
			[-7.4, 10.1],
		],
		shade: 0,
	},
	{
		points: [
			[6, -10],
			[7.4, 10.1],
			[5, 9],
			[3, -1],
			[3, -10],
		],
		shade: 2,
	},
	// Parallel-angled rear winglet
	{
		points: [
			[-9.5, 11],
			[-7.4, 10.1],
			[-5, 9],
			[-4, 17.4],
			[-7.3, 18.8],
		],
		shade: 2,
	},
	{
		points: [
			[9.5, 11],
			[7.3, 18.8],
			[4, 17.4],
			[5, 9],
			[7.4, 10.1],
		],
		shade: 4,
	},
	// AB-3 bright chassis flanks
	{
		points: [
			[-3, -1],
			[-1.4, 24.5],
			[-3.3, 24.5],
			[-5, 9],
		],
		shade: 0,
	},
	{
		points: [
			[3, -1],
			[5, 9],
			[3.3, 24.5],
			[1.4, 24.5],
		],
		shade: 3,
	},
	// AB-3 truncated central spine
	{
		points: [
			[-3, -1],
			[0, 3.5],
			[0, 24.5],
			[-1.4, 24.5],
		],
		shade: 1,
	},
	{
		points: [
			[0, 3.5],
			[3, -1],
			[1.4, 24.5],
			[0, 24.5],
		],
		shade: 4,
	},
];

const cockpitLeft: readonly Point[] = [
	[0, -16],
	[-3, -10],
	[-3, -1],
	[0, 3.5],
];
const cockpitRight: readonly Point[] = [
	[0, -16],
	[3, -10],
	[3, -1],
	[0, 3.5],
];

type EngineKey = "ion" | "heavy-ion" | "fusion" | "plasma";

const engineCatalog: readonly {
	id: EngineKey;
	label: string;
	shortLabel: string;
	frontExtent: number;
	aftExtent: number;
	halfWidth: number;
}[] = [
	{
		id: "ion",
		label: "Light Ion (ion)",
		shortLabel: "Light Ion",
		frontExtent: 9.0,
		aftExtent: 11.0,
		halfWidth: 3.0,
	},
	{
		id: "heavy-ion",
		label: "Heavy Ion (heavy-ion)",
		shortLabel: "Heavy Ion",
		frontExtent: 10.35,
		aftExtent: 12.65,
		halfWidth: 4.35,
	},
	{
		id: "fusion",
		label: "Light Fusion (fusion)",
		shortLabel: "Light Fusion",
		frontExtent: 10.0,
		aftExtent: 12.0,
		halfWidth: 3.5,
	},
	{
		id: "plasma",
		label: "Heavy Plasma (plasma)",
		shortLabel: "Heavy Plasma",
		frontExtent: 10.0,
		aftExtent: 14.0,
		halfWidth: 5.0,
	},
];

// Convert ENGINE_ART pose 3 (aft lighting) from ship-right (+x) coordinates to
// upright SVG coordinates (nose = -y, stern = +y, port = -x, starboard = +x):
// [ex, ey] -> [ey, -ex] relative to the mount center (0, mountY).
function getUprightEngineFaces(id: EngineKey) {
	const faces = ENGINE_ART[id][3];
	return faces.map((face) => ({
		points: face.points.map(([ex, ey]) => [ey, -ex] as const),
		color:
			face.color === "currentColor"
				? id === "fusion"
					? "#c6ff32"
					: "#ffb52e"
				: face.color,
	}));
}

const DEFAULT_Y = 18.5;
---

<div class="engine-positioner" id="wasp-engine-positioner">
	<div class="toolbar">
		<div class="control-block">
			<span class="control-label">Active Engine</span>
			<div class="button-row" data-role="engine-buttons">
				{engineCatalog.map((eng, idx) => (
					<button
						type="button"
						class:list={["chip-btn", { active: idx === 0 }]}
						data-engine-btn={eng.id}
					>
						{eng.shortLabel}
					</button>
				))}
				<button type="button" class="chip-btn" data-engine-btn="none">
					Off (Bare 06.9)
				</button>
			</div>
		</div>

		<div class="control-block slider-block">
			<div class="slider-header">
				<label for="wasp-engine-y" class="control-label">
					Engine Mount Y (Center)
				</label>
				<div class="nudge-row">
					<button type="button" class="nudge-btn" data-nudge="-1">−1.0</button>
					<button type="button" class="nudge-btn" data-nudge="-0.5">
						−0.5
					</button>
					<output id="wasp-engine-y-readout" class="y-readout">
						y = {DEFAULT_Y.toFixed(1)}
					</output>
					<button type="button" class="nudge-btn" data-nudge="0.5">+0.5</button>
					<button type="button" class="nudge-btn" data-nudge="1">+1.0</button>
				</div>
			</div>
			<input
				id="wasp-engine-y"
				type="range"
				min="6"
				max="26"
				step="0.5"
				value={DEFAULT_Y}
			>
			<div class="preset-row">
				<span class="preset-caption">Quick Y presets:</span>
				{[13.5, 15.0, 16.5, 18.0, 18.5, 19.5, 21.0, 22.5].map((preset) => (
					<button type="button" class="preset-btn" data-preset-y={preset}>
						{preset.toFixed(1)}
					</button>
				))}
			</div>
		</div>

		<div class="control-block">
			<span class="control-label">Overlays</span>
			<label class="toggle-check">
				<input type="checkbox" id="wasp-show-slot-box" checked>
				<span>Show Universal (+) slot box (9 × 11)</span>
			</label>
			<label class="toggle-check">
				<input type="checkbox" id="wasp-show-ref-lines" checked>
				<span>Show stern &amp; winglet reference lines</span>
			</label>
		</div>
	</div>

	<div class="metrics-bar" id="wasp-engine-metrics">
		<span> Mount center: <strong data-metric="center">y = 18.5</strong> </span>
		<span>
			Slot box (9×11): <strong data-metric="slot">y = 13.0 → 24.0</strong>
		</span>
		<span>
			Engine front tip: <strong data-metric="front">y = 9.5</strong>
		</span>
		<span>
			Engine nozzle tip:
			<strong data-metric="aft">y = 29.5 (+5.0 past stern)</strong>
		</span>
	</div>

	<div class="main-stage">
		<figure class="stage-card primary-stage">
			<div class="stage-title">
				<span>Interactive Inspector (1× Builder Scale)</span>
				<span class="stage-sub" data-metric="active-label"
					>Light Ion (ion)</span
				>
			</div>
			<svg
				viewBox="-24 -30 48 68"
				role="img"
				aria-label="Interactive LHI Wasp 06.9 rear engine positioner"
			>
				<line x1="0" y1="-29" x2="0" y2="36" class="axis" />
				<line x1="-22" y1="0" x2="22" y2="0" class="axis" />

				{/* Hull 06.9 */}
				{hull069Facets.map((f) => (
					<polygon points={pts(f.points)} fill={palette[f.shade]} />
				))}
				<polygon points={pts(cockpitLeft)} fill="#000000" />
				<polygon points={pts(cockpitRight)} fill="#000000" />

				{/* Reference lines (waist y=9, winglet trailing y=17.4..18.8, stern y=24.5) */}
				<g data-layer="ref-lines">
					<line x1="-14" y1="9" x2="14" y2="9" class="ref-line" />
					<text x="-13.5" y="8.3" class="ref-text">waist y=9</text>
					<line x1="-14" y1="17.4" x2="14" y2="17.4" class="ref-line" />
					<text x="-13.5" y="16.7" class="ref-text">winglet inner y=17.4</text>
					<line
						x1="-14"
						y1="24.5"
						x2="14"
						y2="24.5"
						class="ref-line stern-line"
					/>
					<text x="-13.5" y="23.8" class="ref-text">stern y=24.5</text>
				</g>

				{/* Movable engine & slot group on top of the ship */}
				<g data-movable-mount transform={`translate(0, ${DEFAULT_Y})`}>
					<g data-layer="slot-box">
						<rect
							x="-4.5"
							y="-5.5"
							width="9"
							height="11"
							rx="0.6"
							class="slot-rect"
						/>
						<line x1="-2.2" y1="0" x2="2.2" y2="0" class="slot-cross" />
						<line x1="0" y1="-2.2" x2="0" y2="2.2" class="slot-cross" />
					</g>

					{engineCatalog.map((eng, idx) => (
						<g
							data-engine-layer={eng.id}
							style={idx === 0 ? "" : "display: none;"}
						>
							{getUprightEngineFaces(eng.id).map((face) => (
								<polygon points={pts(face.points)} fill={face.color} />
							))}
						</g>
					))}

					<circle cx="0" cy="0" r="0.55" class="mount-pivot" />
				</g>
			</svg>
		</figure>

		<div class="four-up-panel">
			<div class="stage-title">
				<span>All 4 Engines Synchronized at Current Y</span>
				<span class="stage-sub">Moves live with the slider</span>
			</div>
			<div class="four-up-grid">
				{engineCatalog.map((eng) => (
					<figure class="mini-card" data-mini-card={eng.id}>
						<svg
							viewBox="-22 -28 44 64"
							role="img"
							aria-label={`${eng.label} on LHI Wasp 06.9`}
						>
							<line x1="0" y1="-27" x2="0" y2="34" class="axis" />
							{hull069Facets.map((f) => (
								<polygon points={pts(f.points)} fill={palette[f.shade]} />
							))}
							<polygon points={pts(cockpitLeft)} fill="#000000" />
							<polygon points={pts(cockpitRight)} fill="#000000" />

							<g data-layer="ref-lines">
								<line
									x1="-11"
									y1="24.5"
									x2="11"
									y2="24.5"
									class="ref-line stern-line"
								/>
							</g>

							<g data-movable-mount transform={`translate(0, ${DEFAULT_Y})`}>
								<g data-layer="slot-box">
									<rect
										x="-4.5"
										y="-5.5"
										width="9"
										height="11"
										rx="0.6"
										class="slot-rect"
									/>
								</g>
								{getUprightEngineFaces(eng.id).map((face) => (
									<polygon points={pts(face.points)} fill={face.color} />
								))}
							</g>
						</svg>
						<figcaption>
							<strong>{eng.shortLabel}</strong>
							<span
								class="mini-bounds"
								data-mini-bounds={eng.id}
								data-front={eng.frontExtent}
								data-aft={eng.aftExtent}
							>
								y = {(DEFAULT_Y - eng.frontExtent).toFixed(1)} →{" "}
								{(DEFAULT_Y + eng.aftExtent).toFixed(1)}
							</span>
						</figcaption>
					</figure>
				))}
			</div>
		</div>
	</div>
</div>

<script>
const root = document.getElementById("wasp-engine-positioner");
if (root) {
	const slider = root.querySelector<HTMLInputElement>("#wasp-engine-y");
	const readout = root.querySelector<HTMLElement>("#wasp-engine-y-readout");
	const slotCheckbox = root.querySelector<HTMLInputElement>(
		"#wasp-show-slot-box",
	);
	const refCheckbox = root.querySelector<HTMLInputElement>(
		"#wasp-show-ref-lines",
	);
	const engineButtons =
		root.querySelectorAll<HTMLButtonElement>("[data-engine-btn]");
	const nudgeButtons = root.querySelectorAll<HTMLButtonElement>("[data-nudge]");
	const presetButtons =
		root.querySelectorAll<HTMLButtonElement>("[data-preset-y]");
	const movableMounts = root.querySelectorAll<SVGGElement>(
		"[data-movable-mount]",
	);
	const engineLayers = root.querySelectorAll<SVGGElement>(
		"[data-engine-layer]",
	);
	const slotLayers = root.querySelectorAll<SVGGElement>(
		'[data-layer="slot-box"]',
	);
	const refLayers = root.querySelectorAll<SVGGElement>(
		'[data-layer="ref-lines"]',
	);
	const miniBounds = root.querySelectorAll<HTMLElement>("[data-mini-bounds]");

	const metricCenter = root.querySelector<HTMLElement>(
		'[data-metric="center"]',
	);
	const metricSlot = root.querySelector<HTMLElement>('[data-metric="slot"]');
	const metricFront = root.querySelector<HTMLElement>('[data-metric="front"]');
	const metricAft = root.querySelector<HTMLElement>('[data-metric="aft"]');
	const metricActiveLabel = root.querySelector<HTMLElement>(
		'[data-metric="active-label"]',
	);

	const extents: Record<string, { label: string; front: number; aft: number }> =
		{
			ion: { label: "Light Ion (ion)", front: 9.0, aft: 11.0 },
			"heavy-ion": {
				label: "Heavy Ion (heavy-ion)",
				front: 10.35,
				aft: 12.65,
			},
			fusion: { label: "Light Fusion (fusion)", front: 10.0, aft: 12.0 },
			plasma: { label: "Heavy Plasma (plasma)", front: 10.0, aft: 14.0 },
			none: { label: "Bare 06.9 Hull (No engine)", front: 0, aft: 0 },
		};

	let currentEngine = "ion";
	let currentY = Number(slider?.value ?? 18.5);

	function render() {
		if (slider) slider.value = String(currentY);
		if (readout) readout.textContent = `y = ${currentY.toFixed(1)}`;

		movableMounts.forEach((g) => {
			g.setAttribute("transform", `translate(0, ${currentY})`);
		});

		engineLayers.forEach((layer) => {
			const id = layer.getAttribute("data-engine-layer");
			layer.style.display = id === currentEngine ? "" : "none";
		});

		engineButtons.forEach((btn) => {
			const id = btn.getAttribute("data-engine-btn");
			btn.classList.toggle("active", id === currentEngine);
		});

		presetButtons.forEach((btn) => {
			const val = Number(btn.getAttribute("data-preset-y"));
			btn.classList.toggle("active", Math.abs(val - currentY) < 0.01);
		});

		const info = extents[currentEngine] ?? extents.ion;
		if (metricCenter) metricCenter.textContent = `y = ${currentY.toFixed(1)}`;
		if (metricSlot) {
			metricSlot.textContent = `y = ${(currentY - 5.5).toFixed(1)} → ${(currentY + 5.5).toFixed(1)}`;
		}
		if (metricActiveLabel) metricActiveLabel.textContent = info.label;

		if (currentEngine === "none") {
			if (metricFront) metricFront.textContent = "—";
			if (metricAft) metricAft.textContent = "—";
		} else {
			const frontY = currentY - info.front;
			const aftY = currentY + info.aft;
			const overhang = aftY - 24.5;
			const overhangText =
				overhang >= 0
					? `+${overhang.toFixed(1)} past stern`
					: `${overhang.toFixed(1)} inside stern`;
			if (metricFront) metricFront.textContent = `y = ${frontY.toFixed(2)}`;
			if (metricAft) {
				metricAft.textContent = `y = ${aftY.toFixed(2)} (${overhangText})`;
			}
		}

		miniBounds.forEach((el) => {
			const front = Number(el.getAttribute("data-front") ?? 0);
			const aft = Number(el.getAttribute("data-aft") ?? 0);
			el.textContent = `y = ${(currentY - front).toFixed(1)} → ${(currentY + aft).toFixed(1)}`;
		});
	}

	slider?.addEventListener("input", () => {
		currentY = Number(slider.value);
		render();
	});

	nudgeButtons.forEach((btn) => {
		btn.addEventListener("click", () => {
			const delta = Number(btn.getAttribute("data-nudge") ?? 0);
			currentY = Math.min(26, Math.max(6, currentY + delta));
			render();
		});
	});

	presetButtons.forEach((btn) => {
		btn.addEventListener("click", () => {
			currentY = Number(btn.getAttribute("data-preset-y") ?? 18.5);
			render();
		});
	});

	engineButtons.forEach((btn) => {
		btn.addEventListener("click", () => {
			currentEngine = btn.getAttribute("data-engine-btn") ?? "ion";
			render();
		});
	});

	slotCheckbox?.addEventListener("change", () => {
		const show = slotCheckbox.checked;
		slotLayers.forEach((el) => {
			el.style.display = show ? "" : "none";
		});
	});

	refCheckbox?.addEventListener("change", () => {
		const show = refCheckbox.checked;
		refLayers.forEach((el) => {
			el.style.display = show ? "" : "none";
		});
	});

	render();
}
</script>

<style>
.engine-positioner {
	display: flex;
	flex-direction: column;
	gap: 1rem;
	margin: 1rem 0 1.5rem;
	padding: 1rem;
	background: var(--bg-secondary, #16162a);
	border: 1px solid var(--border-default, rgba(255, 255, 255, 0.12));
	border-radius: 8px;
}

.toolbar {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
	gap: 1rem;
	align-items: start;
}

.control-block {
	display: flex;
	flex-direction: column;
	gap: 0.45rem;
}

.control-label {
	font-family: var(--font-mono, monospace);
	font-size: 0.75rem;
	text-transform: uppercase;
	letter-spacing: 0.04em;
	color: var(--text-secondary, #94a3b8);
}

.button-row,
.preset-row,
.nudge-row {
	display: flex;
	flex-wrap: wrap;
	gap: 0.35rem;
	align-items: center;
}

.slider-header {
	display: flex;
	justify-content: space-between;
	align-items: center;
	gap: 0.5rem;
	flex-wrap: wrap;
}

.chip-btn,
.nudge-btn,
.preset-btn {
	font-family: var(--font-mono, monospace);
	font-size: 0.74rem;
	padding: 0.3rem 0.55rem;
	border-radius: 4px;
	border: 1px solid rgba(255, 255, 255, 0.16);
	background: rgba(15, 23, 42, 0.7);
	color: var(--text-primary, #f0f4f8);
	cursor: pointer;
}

.chip-btn.active,
.preset-btn.active {
	background: rgba(212, 255, 0, 0.16);
	border-color: #d4ff00;
	color: #d4ff00;
}

.y-readout {
	font-family: var(--font-mono, monospace);
	font-size: 0.82rem;
	font-weight: 700;
	color: #d4ff00;
	min-width: 4.8rem;
	text-align: center;
}

input[type="range"] {
	width: 100%;
	accent-color: #d4ff00;
}

.preset-caption {
	font-size: 0.72rem;
	color: var(--text-secondary, #94a3b8);
}

.toggle-check {
	display: flex;
	align-items: center;
	gap: 0.45rem;
	font-size: 0.78rem;
	color: var(--text-primary, #f0f4f8);
	cursor: pointer;
}

.metrics-bar {
	display: flex;
	flex-wrap: wrap;
	gap: 1rem;
	padding: 0.55rem 0.75rem;
	background: rgba(10, 12, 22, 0.65);
	border: 1px solid rgba(255, 255, 255, 0.08);
	border-radius: 6px;
	font-family: var(--font-mono, monospace);
	font-size: 0.75rem;
	color: var(--text-secondary, #94a3b8);
}

.metrics-bar strong {
	color: var(--text-primary, #f0f4f8);
}

.main-stage {
	display: grid;
	grid-template-columns: minmax(260px, 1fr) minmax(320px, 1.35fr);
	gap: 1rem;
	align-items: start;
}

@media (max-width: 760px) {
	.main-stage {
		grid-template-columns: 1fr;
	}
}

.stage-card,
.four-up-panel {
	margin: 0;
	padding: 0.75rem;
