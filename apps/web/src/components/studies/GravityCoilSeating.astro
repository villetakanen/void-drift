---
import { POTENTIAL_WELL_ART } from "../../../../../packages/mode-a/src/lib/potential-well-art";

interface Props {
  mounts: { x: number; y: number }[][];
}
const { mounts } = Astro.props;
const cards = [
  {
    name: "Reference / Potential Well",
    note: "Production artwork. Dark working interiors and a longitudinal assembly provide a comparison that already feels seated.",
    id: "seat-well",
  },
  {
    name: "A / 1A unchanged",
    note: "The reference coil, turned fore–aft. Its open centre shows the chassis through the winding. No new attachment cues.",
    id: "seat-open",
  },
  {
    name: "B / Contained field chamber",
    note: "Same 1A construction; only the central opening becomes a recessed working interior. Tests whether seeing the hull through it creates the floating reading.",
    id: "seat-chamber",
  },
  {
    name: "C / Captured terminals",
    note: "Same open 1A coil, with its terminals captured by two narrow hull fittings. Tests whether visible contact and overlap establish attachment.",
    id: "seat-captured",
  },
];
---

