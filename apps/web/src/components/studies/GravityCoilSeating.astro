<div class="seating">
  {cards.map((card, n) => (
    <article>
      <h4>{card.name}</h4>
      <p>{card.note}</p>
      <figure>
        <svg
          width="160"
          height="140"
          viewBox="-27 -25 54 50"
          role="img"
          aria-label={`${card.name}, free-standing`}
        >
          <use href={`#${card.id}`} />
        </svg>
        <figcaption>
          {n === 3 ? "Coil with proposed hull fittings" : "Free-standing"}
        </figcaption>
      </figure>
      {[1, 0].map((i) => (
        <figure>
          <svg
            width="200"
            height="200"
            viewBox="-50 -55 100 100"
            role="img"
            aria-label={`${card.name}, ${i === 0 ? "Wasp" : "Fighter"} above hull, 2×`}
          >
            <use href={`#seat-fit-${n}-${i}-false`} />
          </svg>
          <figcaption>
            {i === 0 ? "Wasp" : "Fighter"} · on chassis · 2×
          </figcaption>
        </figure>
      ))}
      <div class="actual">
        {[1, 0].map((i) => (
          <figure>
            <svg
              width="100"
              height="100"
              viewBox="-50 -55 100 100"
              role="img"
              aria-label={`${card.name}, ${i === 0 ? "Wasp" : "Fighter"} above hull, 1×`}
            >
              <use href={`#seat-fit-${n}-${i}-false`} />
            </svg>
            <figcaption>{i === 0 ? "Wasp" : "Fighter"} · 1×</figcaption>
          </figure>
        ))}
      </div>
      <figure>
        <svg
          width="200"
          height="200"
          viewBox="-50 -55 100 100"
          role="img"
          aria-label={`${card.name}, Wasp under wing, 2×`}
        >
          <use href={`#seat-fit-${n}-0-true`} />
        </svg>
        <figcaption>Wasp · under wing · 2×</figcaption>
      </figure>
    </article>
  ))}
</div>
<p class="conditions">
  A–C share the exact 1A winding, ribbon, size and orientation. B changes only
  the central interior; C changes only the attachment relationship. C’s blue
  fittings belong to the hull, not to a backing plate carried by the coil. The
  Potential Well uses its production scale; the coil keeps the previous 18-unit
  length. Engines and mount positions are identical across columns. No proposal
  is selected.
</p>
<style>
.seating {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
}
article {
  border: 1px solid var(--color-border);
  padding: 12px;
  min-width: 0;
}
h4 {
  font-size: 16px;
  min-height: 42px;
  margin: 0 0 12px;
}
article > p {
  font-size: 14px;
  line-height: 1.6;
  min-height: 150px;
}
figure {
  margin: 0;
  text-align: center;
}
svg {
  display: block;
  margin: auto;
  max-width: none;
}
figcaption,
.conditions {
  font-size: 12px;
  color: var(--color-text-muted);
}
.actual {
  display: flex;
  justify-content: center;
}
.conditions {
  margin-top: 20px;
}
@media (max-width: 1100px) {
  .seating {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
@media (max-width: 580px) {
  .seating {
    grid-template-columns: 1fr;
  }
  article > p {
    min-height: 0;
  }
}
</style>
