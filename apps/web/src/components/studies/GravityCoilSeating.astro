            <use href={`#belong-ship-${i}`} />
            {!below && (
              <use
                href={`#${card.id}`}
                transform={`translate(${mounts[i][0].y} ${-mounts[i][0].x}) scale(${n === 0 ? 0.55 : 0.5})`}
