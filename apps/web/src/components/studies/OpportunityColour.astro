---
import gravity from "./resting-gravity.svg?raw";
import repair from "./resting-repair.svg?raw";
import solar from "./resting-solar.svg?raw";
import storage from "./resting-storage.svg?raw";

const pairs = [
	{ label: "Wasp A / storage + solar", parts: [storage, solar] },
	{ label: "Wasp B / gravity + repair", parts: [gravity, repair] },
];
---

<div class="colour-bench" style="--family-accent:#cedb17">
	<div class="controls">
		<strong>Accepted family accent · RGB 206, 219, 23 · #CEDB17</strong>
	</div>
	<div class="ships">
		{pairs.map((pair) => (
			<figure>
				<figcaption>{pair.label}</figcaption>
				{[false, true].map((small) => (
					<svg
						class:list={["ship", { small }]}
						viewBox="-48 -56 96 112"
						role="img"
						aria-label={`${pair.label}, Light ion aft, resting equipment above the hull, ${small ? "0.65 flight scale" : "4 times enlarged"}`}
					>
						<image
							href="/studies/utility-machinery-2026-11-02/wasp.png"
							x="-48"
							y="-56"
							width="96"
							height="112"
						/>
						{pair.parts.map((art, i) => (
							<g transform={`translate(${i === 0 ? -12 : 12} -1.5)`}>
								<svg
									x="-10.5"
									y="-10.5"
									width="21"
									height="21"
									viewBox="-30 -30 60 60"
									set:html={art
										.replace(/^<svg[^>]*>/, " ")
										.replace(/<\/svg>\s*$/, " ")}
								/>
							</g>
						))}
					</svg>
				))}
				<p>Enlarged / 0.65× flight scale</p>
			</figure>
		))}
	</div>
	<p class="note">
		All four devices rest above the hull at the production wing-mount centres.
		Device drawings are scaled to 35% of the previous bench’s drawing units to
		fit equipment mounts. This is a colour fixture; size and layering are not
		production decisions. Engines and hull colours remain unchanged.
	</p>
</div>

<style>
.colour-bench {
	margin-block: 2rem;
}
.controls {
	padding: 1rem;
	border: 1px solid var(--color-border);
}
.ships {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: 1rem;
}
figure {
	margin: 1.5rem 0;
	min-width: 0;
	text-align: center;
}
figcaption {
	font-weight: 600;
}
.ship {
	display: block;
	width: 384px;
	height: 448px;
	max-width: 100%;
	margin: auto;
}
.ship.small {
	width: 62.4px;
	height: 72.8px;
	max-width: none;
}
.note,
figure p {
	color: var(--color-text-muted);
}
@media (max-width: 600px) {
	.ships {
		grid-template-columns: 1fr;
	}
}
</style>
