---
// The specimen draws the polygons parsed from the master file itself.
import { parseEngineMaster } from "../../../../../../scripts/engine-art-from-svg.mjs";
import masterSvg from "../../../../public/studies/fission-engine-2026-11-26/02-1-fission-master.svg?raw";
import PartDrawing from "../../hangar/PartDrawing.svelte";

const master = "/studies/fission-engine-2026-11-26/02-1-fission-master.svg";
const accent = masterSvg.match(/<svg\b[^>]*\scolor="([^"]+)"/)?.[1];
const parsed = parseEngineMaster(masterSvg).poses as Record<
  string,
  { points: number[][]; color: string }[]
>;
const labels = ["0 · catalogue", "1 · side-lit", "2 · side-lit", "3 · aft-lit"];
const poses = Object.entries(parsed).map(([pose, faces]) => ({
  label: labels[Number(pose)],
  faces: faces.map((face) => ({
    points: face.points.map((point) => point.join(",")).join(" "),
    fill: face.color,
  })),
}));
---

<figure>
  <div class="specimen">
    <div class="pair">
      <div class="cell">
        <PartDrawing id="fusion" />
        <p>Catalogue card today · drawn by the game</p>
      </div>
      <div class="cell">
        <svg
          viewBox="-18 -20 36 40"
          role="img"
          aria-label="Fission engine SVG master, catalogue pose, nose up"
          style={`color: ${accent}`}
        >
          <g transform="rotate(-90)">
            {poses[0].faces.map((face) => (
              <polygon points={face.points} fill={face.fill} />
            ))}
          </g>
        </svg>
        <p>SVG master · catalogue pose</p>
      </div>
    </div>
    <div class="poses">
      {poses.map(({ label, faces }) => (
        <div class="cell">
          <svg
            viewBox="-18 -20 36 40"
            role="img"
            aria-label={`Fission engine SVG master, pose ${label}`}
            style={`color: ${accent}`}
          >
            <g transform="rotate(-90)">
              {faces.map((face) => (
                <polygon points={face.points} fill={face.fill} />
              ))}
            </g>
          </svg>
          <p>{label}</p>
        </div>
      ))}
    </div>
  </div>
  <figcaption>
    Enlarged for inspection, nose up. The top row compares the game’s catalogue
    drawing with the master’s catalogue pose at the same size. The bottom row is
    the master’s four poses.
  </figcaption>
  <div class="downloads"><a href={master}>Fission engine SVG master</a></div>
</figure>

<style>
figure {
  margin: var(--spacing-xl) 0;
}
.specimen {
  display: grid;
  gap: var(--spacing-lg);
  padding: var(--spacing-lg);
  background: var(--color-void);
  border: 1px solid var(--color-border);
}
.pair,
.poses {
  display: flex;
  justify-content: center;
  gap: var(--spacing-xl);
}
.cell {
  display: grid;
  justify-items: center;
  gap: var(--spacing-sm);
}
.cell :global(svg) {
  display: block;
  height: 240px;
  width: auto;
}
.poses .cell :global(svg) {
  height: 140px;
}
.cell p {
  margin: 0;
  color: var(--color-text-muted);
  font: var(--font-size-caption) var(--font-family-ui);
}
figcaption {
  max-width: var(--measure-prose);
  margin-top: var(--spacing-md);
  color: var(--color-text-muted);
}
.downloads {
  margin-top: var(--spacing-md);
}
a:focus-visible {
  outline: 2px solid var(--color-selected);
  outline-offset: 4px;
}
</style>
