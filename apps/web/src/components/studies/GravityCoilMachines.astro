---
const rows = [
	{ id: 0, name: "Toroid" },
	{ id: 2, name: "Horseshoe" },
	{ id: 4, name: "Barrel spring" },
];
const designs = [
	[
		"Cantilever fork",
		"Two yellow arms carry the ring from one hull edge, leaving its outer half unsupported over space.",
	],
	[
		"Inner bearing ring",
		"A narrow inner ring joins three radial supports; two side feet attach the assembly to the chassis.",
	],
	[
		"External brace",
		"An open hexagonal brace ties four outer points together, with two short hull attachment lugs.",
	],
	[
		"Crown hanger",
		"A yellow fork grips the closed crown; the open mouth projects beyond the wing edge.",
	],
	[
		"Inner service arch",
		"A thin inner horseshoe links the two terminals to a crown connector while keeping the mouth open.",
	],
	[
		"Side truss",
		"Two open side braces support the shoulders and terminals, leaving the central opening unobstructed.",
	],
	[
		"Single service spine",
		"One narrow yellow spine joins the end collars along one side, carrying the spring beyond a hull edge.",
	],
	[
		"Axial core",
		"A slender central core connects the end collars through the spring, with two lateral attachment feet.",
	],
	[
		"Open end frame",
		"Two end crosspieces and slender side ties form an open cage around the unchanged winding.",
	],
];
---

<svg width="0" height="0" aria-hidden="true" style="position:absolute">
	<defs>
		{designs.map((_, i) => (
			<g id={`machine-add-${i}`} fill="#cedb17">
				{i === 0 && (
					<path d="M-23-13H-16L-9-8L-11-5L-18-10H-23Z M-23 10H-18L-11 5L-9 8L-16 13H-23Z" />
				)}
				{i === 1 && (
					<>
						<path
							d="M0-7L5-5L7 0L5 5L0 7L-5 5L-7 0L-5-5Z M0-5L-3.5-3.5L-5 0L-3.5 3.5L0 5L3.5 3.5L5 0L3.5-3.5Z"
							fill-rule="evenodd"
						/>
						<path d="M-1-13H1V-6H-1Z M-13 5L-5 2L-4 4L-12 7Z M4 4L5 2L13 5L12 7Z" />
					</>
				)}
				{i === 2 && (
					<path
						d="M-11-20H11L22 0L11 20H-11L-22 0Z M-10-18L-20 0L-10 18H10L20 0L10-18Z"
						fill-rule="evenodd"
					/>
				)}
				{i === 3 && (
					<path d="M-7-23H7V-19L12-12L9-10L4-17H-4L-9-10L-12-12L-7-19Z" />
				)}
				{i === 4 && (
					<>
						<path d="M-8 7L-8-3L-4-8H4L8-3V7H6V-2L3-6H-3L-6-2V7Z" />
						<path d="M-1-14H1V-7H-1Z" />
					</>
				)}
				{i === 5 && (
					<path d="M-20-12H-13V-10H-18V10H-10V12H-20Z M13-12H20V12H10V10H18V-10H13Z" />
				)}
				{i === 6 && (
					<>
						<path d="M-17-22H-5V-20H-14V20H-5V22H-17Z" />
						<path d="M-23-10H-15V-6H-23Z M-23 6H-15V10H-23Z" />
					</>
				)}
				{i === 7 && (
					<>
						<path d="M-2-20H2V20H-2Z" fill="#88951b" />
						<path d="M-1-20H1V20H-1Z M-18-2H-1V2H-18Z M1-2H18V2H1Z" />
					</>
				)}
				{i === 8 && (
					<path d="M-16-22H16V22H-16Z M-14-19V19H14V-19Z" fill-rule="evenodd" />
				)}
			</g>
		))}
		{designs.map((_, i) => (
			<g id={`machine-full-${i}`}>
				<use href={`#machine-add-${i}`} />
				<use href={`#coil-nine-${rows[Math.floor(i / 3)].id}`} />
			</g>
		))}
	</defs>
</svg>
<div class="board">
	<div class="grid">
		{designs.map(([name, note], i) => (
			<article>
				<h4>
					{i + 1} / {rows[Math.floor(i / 3)].name} · {name}
				</h4>
				<svg
					class="large"
					width="260"
					height="260"
					viewBox="-24 -24 48 48"
					role="img"
					aria-label={`${name}, enlarged`}
				>
					<use href={`#machine-full-${i}`} />
				</svg>
				<p class="scale">Enlarged above · 1× below</p>
				<div class="contexts">
					{["Free", "Under wing", "On chassis"].map((label, j) => (
						<figure>
							<svg
								width="80"
								height="72"
								viewBox="-40 -36 80 72"
								role="img"
								aria-label={`${name}, ${label}, 1×`}
							>
								{j === 2 && (
									<path d="M-30-30H22L32 0L22 30H-30Z" fill="#264d6b" />
								)}
								<use href={`#machine-full-${i}`} />
								{j === 1 && <path d="M-40-36H-11L-9 36H-40Z" fill="#437e99" />}
							</svg>
							<figcaption>{label}</figcaption>
						</figure>
					))}
				</div>
				<p>{note}</p>
			</article>
		))}
	</div>
</div>
<p class="caption">
	Blue surfaces are schematic hull-edge fixtures, not production chassis or
	verified mount positions. Under-wing samples cover the left attachment side;
	on-chassis samples place the whole module above the hull. Yellow supports are
	the only additions; original white–charcoal geometry is reused unchanged.
</p>
<style>
.board {
	width: 100%;

	overflow-x: auto;
}
.grid {
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: 16px;
}
article {
	padding: 15px;
	border: 1px solid var(--color-border);
}
h4 {
	margin: 0;
	min-height: 3em;
}
.large {
	display: block;
	width: 100%;
	height: 260px;
	max-width: none;
}
.scale,
.caption {
	color: var(--color-text-muted);
}
.contexts {
	display: flex;
	justify-content: space-between;
}
figure {
	margin: 0;
}
figure svg {
	width: 80px;
	height: 72px;
	max-width: none;
}
figcaption {
	font-size: 12px;
}
article p {
	font-size: 14px;
}
.board:focus-visible {
	outline: 2px solid var(--color-text);
}
</style>
