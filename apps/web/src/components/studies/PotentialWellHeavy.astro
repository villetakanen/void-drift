---
const root = "/studies/resource-capacity-2026-11-02";
const options = [
	[
		"normal",
		"Accepted normal",
		"Two wells at the decided 0.55 scale. +85 capacity; baseline mass.",
	],
	[
		"larger",
		"A / Larger containment wells",
		"Two larger wells retain the same silhouette and construction. Extra chamber volume carries the capacity difference.",
	],
	[
		"third",
		"B / Three-well bank",
		"One additional well extends the same assembly. Strong modular continuity, with a longer footprint.",
	],
	[
		"wide",
		"C / Broader chambers",
		"Two wider chambers give the device a heavier stance while limiting added length. Their elongated openings change its character.",
	],
];
---

<div class="heavy-grid">
	{options.map(([id, title, note]) => (
		<figure>
			<h4>{title}</h4>
			<p>{note}</p>
			<div class="large-view">
				<img
					src={`${root}/${id === "normal" ? "close-coupling-sized" : `heavy-${id}`}.svg`}
					width={id === "normal" ? 176 : 211.2}
					height={id === "normal" ? 176 : 264}
					alt={`${title}, 8 times decided mounted scale`}
				/>
			</div>
			<div class="small-view">
				<img
					src={`${root}/${id === "normal" ? "close-coupling-sized" : `heavy-${id}`}.svg`}
					width={id === "normal" ? 22 : 26.4}
					height={id === "normal" ? 22 : 33}
					alt={`${title}, actual mounted size before flight scaling`}
				/>
			</div>
			<small>8× above · 1× below · 0.55 artwork scale</small>
			{id !== "normal" && <p>+140 capacity · 2× normal mass</p>}
		</figure>
	))}
</div>
<style>
.heavy-grid {
	display: grid;
	grid-template-columns: repeat(4, minmax(240px, 1fr));
	gap: 1rem;
	overflow: auto;
}
figure {
	margin: 0;
	border: 1px solid var(--color-border);
	padding: 1rem;
}
h4 {
	min-height: 3em;
	margin: 0 0 1rem;
}
p {
	font-size: 0.875rem;
	line-height: 1.5;
	min-height: 7em;
}
.large-view {
	height: 280px;
	display: flex;
	align-items: center;
	justify-content: center;
}
.small-view {
	height: 55px;
	display: flex;
	align-items: center;
	justify-content: center;
	border-top: 1px solid var(--color-border);
}
img {
	max-width: none;
}
small {
	color: var(--color-text-muted);
}
</style>
