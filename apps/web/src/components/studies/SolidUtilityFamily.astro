---
import { ENGINE_ART } from "../../../../../packages/mode-a/src/lib/engine-art";

const names = [
  "Storage / paired cells",
  "Solar / collector wings",
  "Gravity / opposed masses",
  "Repair / service jaws",
];
const notes = [
  "Two substantial cells held at their ends. Their ridges and shoulders carry the volume; the gap separates real parts.",
  "Thin collector wings grow from a thick converter spine. The contrast between surface area and central mass carries the role.",
  "Two heavy opposing masses sit on a central axle. This is a mechanical metaphor for gravity charging, not an agreed operating principle.",
  "Two solid articulated jaws flank a service core. The opening belongs to the tool’s reach rather than to an ornamental housing.",
];
---

<svg width="0" height="0" aria-hidden="true">
  <defs>
    <g id="solid-cell">
      <path d="M-16-3L-11-6H11L16-3L11 6H-11Z" fill="#435461" />
      <path d="M-16-3L-11-6H11L16-3H-11Z" fill="#a4bac4" />
      <path d="M-11-3H16L11 2H-11Z" fill="#7b96a5" />
      <path d="M-11 2H11L11 6H-11L-16-3Z" fill="#4b6372" />
    </g>
    {names.map((_, i) => (
      <g id={`solid-family-${i}`}>
        {i === 0 && (
          <>
            <use href="#solid-cell" transform="translate(0 -7)" />
            <use href="#solid-cell" transform="translate(0 7)" />
            {[-12, 12].map((x) => (
              <g transform={`translate(${x} 0)`}>
                <path d="M-2-13H2V13H-2Z" fill="#354651" />
                <path d="M-2-13H1V13H-2Z" fill="#8198a3" />
              </g>
            ))}
          </>
        )}
        {i === 1 && (
          <>
            <path
              d="M-23-12L-5-10V11L-23 9Z M5-10L23-12V9L5 11Z"
              fill="#365469"
            />
            <path
              d="M-23-12L-5-10V-8L-23-10Z M5-10L23-12V-10L5-8Z"
              fill="#8baab8"
            />
            <path d="M-23-1L-5 1V3L-23 1Z M5 1L23-1V1L5 3Z" fill="#1d3545" />
            <use href="#solid-cell" transform="rotate(90) scale(1 .65)" />
          </>
        )}
        {i === 2 && (
          <>
            <path d="M-17-2H17V2H-17Z" fill="#9fb3bc" />
            <use href="#solid-cell" transform="rotate(90) scale(.7 .55)" />
            <path
              d="M-22-11L-16-14L-11-9V9L-16 14L-22 11Z M11-9L16-14L22-11V11L16 14L11 9Z"
              fill="#465c6b"
            />
            <path
              d="M-22-11L-16-14V8L-22 11Z M11-9L16-14V8L11 9Z"
              fill="#a2b7c1"
            />
            <path
              d="M-16-14L-11-9V9L-16 14V8Z M16-14L22-11V11L16 14V8Z"
              fill="#718e9e"
            />
          </>
        )}
        {i === 3 && (
          <>
            <use href="#solid-cell" transform="translate(0 7) scale(.65 .9)" />
            <path
              d="M-13 10L-18 5L-17-10L-9-19L-5-16L-11-8L-10 4Z M13 10L18 5L17-10L9-19L5-16L11-8L10 4Z"
              fill="#456071"
            />
            <path
              d="M-18 5L-17-10L-9-19L-7-16L-14-8L-15 4Z M10 4L11-8L5-16L9-19L14-9L13 5Z"
              fill="#a2b9c4"
            />
            <path
              d="M-9-19L-5-16L-7-12L-11-14Z M9-19L5-16L7-12L11-14Z"
              fill="#819ba8"
            />
          </>
        )}
      </g>
    ))}
  </defs>
</svg>
<figure>
  <svg
    width="180"
    height="90"
    viewBox="-20 -10 40 20"
    role="img"
    aria-label="Production ion engine"
  >
    {ENGINE_ART.ion[0].map((f) => (
      <polygon
        points={f.points.map((p) => p.join(",")).join(" ")}
        fill={f.color}
      />
    ))}
  </svg>
  <figcaption>Established ion engine · production artwork</figcaption>
</figure>
<div class="family">
  {names.map((name, i) => (
    <article>
      <h4>{name}</h4>
      <svg viewBox="-30 -25 60 50" role="img" aria-label={name}>
        <use href={`#solid-family-${i}`} />
      </svg>
      <div class="small">
        <svg
          width="39"
          height="33"
          viewBox="-30 -25 60 50"
          role="img"
          aria-label={`${name} small scale`}
        >
          <use href={`#solid-family-${i}`} />
        </svg>
        <span>0.65×</span>
      </div>
      <p>{notes[i]}</p>
    </article>
  ))}
</div>
<style>
.family {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2rem;
  margin-block: 2rem;
}
article > svg {
  width: 100%;
  max-height: 220px;
}
h4 {
  font-size: 1rem;
}
.small {
  display: flex;
  align-items: center;
  gap: 1rem;
  color: var(--color-text-muted);
}
p {
  line-height: 1.6;
  font-size: 0.95rem;
}
@media (max-width: 500px) {
  .family {
    grid-template-columns: 1fr;
  }
}
</style>
