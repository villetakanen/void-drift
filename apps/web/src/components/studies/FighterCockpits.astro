---
const hull = [
	[48, 0],
	[-18, -20],
	[-25, -17],
	[-19, 0],
	[-25, 17],
	[-18, 20],
];
const forms = [
	{
		name: "A / Forward · inset",
		note: "Flight deck toward the nose, seated within the central ridge.",
		position: 18,
		raised: false,
		points: hull,
	},
	{
		name: "B / Central · inset",
		note: "Flight deck at the center, leaving a long uninterrupted nose.",
		position: 6,
		raised: false,
		points: hull,
	},
	{
		name: "C / Rearward · inset",
		note: "Flight deck toward the wing roots, emphasizing the spear ahead.",
		position: -6,
		raised: false,
		points: hull,
	},
	{
		name: "D / Forward · raised",
		note: "The same forward position on a small faceted canopy base.",
		position: 18,
		raised: true,
		points: hull,
	},
	{
		name: "E / Central · raised",
		note: "A compact flight deck rising from the central ridge.",
		position: 6,
		raised: true,
		points: hull,
	},
	{
		name: "F / Rearward · raised",
		note: "A small raised deck nested between the rear shoulders.",
		position: -6,
		raised: true,
		points: hull,
	},
];
const palette = [
	"#c8f4f0",
	"#83c7d0",
	"#437e99",
	"#264d6b",
	"#365d79",
	"#6193a9",
];
---

<div class="fleet">
	{forms.map((form) => (
		<figure>
			<figcaption>
				<h4>{form.name}</h4>
				<p>{form.note}</p>
			</figcaption>
			<svg
				viewBox="0 0 320 310"
				role="img"
				aria-label={`${form.name}, solid low-poly Fighter with a small flight deck, shown large and turned`}
			>
				{[
					{ x: 160, y: 155, scale: 2.5, angle: -90 },
					{ x: 115, y: 270, scale: 0.65, angle: -45 },
				].map((view) => (
					<g
						transform={`translate(${view.x} ${view.y}) scale(${view.scale}) rotate(${view.angle})`}
					>
						{form.points.map((point, index) => {
							const next = form.points[(index + 1) % form.points.length];
							const upper = (point[1] + next[1]) / 2 < 0;
							return (
								<polygon
									points={`-3,0 ${point.join(",")} ${next.join(",")}`}
									fill={palette[upper ? index % 3 : 3 + (index % 3)]}
								/>
							);
						})}
						<polygon points="38,0 -15,-4 -21,0 -15,4" fill="#a2d8df" />
						<polygon points="38,0 -21,0 -15,4" fill="#51869e" />
						<g transform={`translate(${form.position} 0)`}>
							{form.raised && (
								<>
									<polygon
										points="10,0 3,-5 -9,-4 -11,0 -9,4 3,5"
										fill="#57879d"
									/>
									<polygon points="10,0 3,-5 -9,-4 -11,0" fill="#c3e9e9" />
								</>
							)}
							<polygon points="8,0 2,-3 -7,-3 -9,0 -7,3 2,3" fill="#102c43" />
							<polygon points="6,0 1,-2 -6,-2 -7,0" fill="#32738c" />
							<polygon points="6,0 -7,0 -6,2 1,2" fill="#18425d" />
						</g>
					</g>
				))}
				<polygon
					points={form.points.map((p) => p.join(",")).join(" ")}
					fill="#bdd6df"
					transform="translate(230 270) scale(.65) rotate(-90)"
				/>
			</svg>
		</figure>
	))}
</div>
<style>
.fleet {
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: var(--spacing-lg);
	margin-block: var(--spacing-lg);
}
figure {
	margin: 0;
	min-width: 0;
	padding: var(--spacing-md);
	border: var(--flight-border);
}
h4 {
	margin-bottom: var(--spacing-sm);
}
p {
	color: var(--color-text-dim);
	font-size: var(--font-small);
	min-height: 4.5em;
}
svg {
	display: block;
	width: 100%;
}
@media (max-width: 850px) {
	.fleet {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
}
@media (max-width: 480px) {
	.fleet {
		grid-template-columns: 1fr;
	}
	svg {
		max-width: 320px;
		margin: auto;
	}
	p {
		min-height: 0;
	}
}
</style>
