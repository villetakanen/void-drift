import { FIGHTER } from "../../../../../packages/mode-a/src/lib/fighter";
import { SCOUT } from "../../../../../packages/mode-a/src/lib/scout";

type Point = readonly [number, number];
type Facet = {
  points: readonly Point[];
  shade: 0 | 1 | 2 | 3 | 4 | 5;
};
type CanopyFacet = {
  points: readonly Point[];
  tone: "left-top" | "right-top" | "left-bot" | "right-bot" | "left" | "right";
};

interface WaspVariant {
  name: string;
  idea: string;
  facets: readonly Facet[];
  canopy: readonly CanopyFacet[];
}

const pts = (list: readonly Point[]) => list.map((p) => p.join(",")).join(" ");
