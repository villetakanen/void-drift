---
import { FIGHTER } from "../../../../../packages/mode-a/src/lib/fighter";

/**
 * Six slim low-poly Wasp bodies, nose up, in ship units. Every plane carries
 * heights, so it has a real normal and is shaded from one light (ahead, left
 * and above) in the shared Fighter palette. Chassis planes only: no engines,
 * slots or stabilizers.
 */
type XYZ = readonly [number, number, number];
const f = FIGHTER.facets;
const stops = [f[0], f[1], f[5], f[2], f[4], f[3]];
const hex = (c: string) =>
	[1, 3, 5].map((i) => parseInt(c.slice(i, i + 2), 16));
const mix = (t: number) => {
	const x = Math.min(Math.max(t, 0), 1) * (stops.length - 1);
	const i = Math.min(Math.floor(x), stops.length - 2);
	const u = x - i;
	const a = hex(stops[i]);
	const b = hex(stops[i + 1]);
	return `#${a
		.map((v, j) =>
			Math.round(v + (b[j] - v) * u)
				.toString(16)
				.padStart(2, "0"),
		)
		.join("")}`;
};
const light = (() => {
	const v = [-0.75, -0.3, 0.5];
	const l = Math.hypot(...v);
	return v.map((x) => x / l);
})();
const shade = (points: XYZ[]) => {
	let nx = 0;
	let ny = 0;
	let nz = 0;
	for (let i = 0; i < points.length; i++) {
		const [x1, y1, z1] = points[i];
		const [x2, y2, z2] = points[(i + 1) % points.length];
		nx += (y1 - y2) * (z1 + z2);
		ny += (z1 - z2) * (x1 + x2);
		nz += (x1 - x2) * (y1 + y2);
	}
	const l = Math.hypot(nx, ny, nz) || 1;
	if (nz < 0) {
		nx = -nx;
		ny = -ny;
		nz = -nz;
	}
	const dot = (nx * light[0] + ny * light[1] + nz * light[2]) / l;
	return mix(1 - Math.min(Math.max((dot - 0.05) / 0.9, 0), 1));
};

interface Variant {
	name: string;
	idea: string;
	/** Left-side and centre planes as [x, y, z]; planes with x < 0 are mirrored. */
	planes: XYZ[][];
}
/** Slim fuselage shared by most bodies: three planes a side, 5.6 units wide. */
const fuselage = (nose = 0.5, mid = 3, stern = 1.5): XYZ[][] => [
	[
		[0, -20, nose],
		[-2.8, -8, 0],
		[0, -8, mid],
	],
	[
		[0, -8, mid],
		[-2.8, -8, 0],
		[-2.8, 12, 0],
		[0, 12, mid],
	],
	[
		[0, 12, mid],
		[-2.8, 12, 0],
		[-2.5, 19.5, 0],
		[0, 19.5, stern],
	],
];
const variants: Variant[] = [
	{
		name: "01 / Dart",
		idea: "Straight fuselage, one clipped delta a side set well aft. Four body planes, two wings: the plainest jet.",
		planes: [
			...fuselage(),
			[
				[-2.8, 0, 0],
				[-10, 8, 0],
				[-10, 10.5, 0],
				[-2.8, 10.5, 0],
			],
		],
	},
	{
		name: "02 / Swept blades",
		idea: "Long thin swept wings from mid-body, and a small fin pair at the stern. Reads fast standing still.",
		planes: [
			...fuselage(),
			[
				[-2.8, -4, 0],
				[-12.5, 9, 0.6],
				[-2.8, 8, 0],
			],
			[
				[-2.5, 14, 0],
				[-6, 19.5, 0],
				[-2.5, 19.5, 0],
			],
		],
	},
	{
		name: "03 / Canard needle",
		idea: "A needle nose with small canards ahead of the canopy and a cropped main wing aft: the ship steers before it lifts.",
		planes: [
			...fuselage(0.3, 2.6, 1.2),
			[
				[-2.8, -13, 0],
				[-6.5, -10, 0.3],
				[-2.8, -8.5, 0],
			],
			[
				[-2.8, 2, 0],
				[-9.5, 9, 0.4],
				[-9.5, 11, 0.4],
				[-2.8, 11, 0],
			],
		],
	},
	{
		name: "04 / Cranked arrow",
		idea: "One wing a side with a crank: a shallow inner sweep breaking to a sharper outer blade, the fuselage ridge carried to the tail.",
		planes: [
			...fuselage(0.5, 3.2, 1.8),
			[
				[-2.8, -2, 0],
				[-8, 5, 0.3],
				[-11.5, 10, 0.6],
				[-2.8, 9.5, 0],
			],
		],
	},
	{
		name: "05 / Stub wings",
		idea: "Short, broad stubs like an interceptor, the body doing the work. The smallest span of the six.",
		planes: [
			...fuselage(0.6, 3.4, 1.6),
			[
				[-2.8, 1, 0],
				[-8, 5.5, 0],
				[-8, 9.5, 0],
				[-2.8, 10, 0],
			],
		],
	},
	{
		name: "06 / Four fins",
		idea: "Small fins where the stabilizers will sit, a pair at the nose taper and a pair at the stern, with a thin mid wing between. The hull itself hints at four points of control.",
		planes: [
			...fuselage(0.4, 2.8, 1.4),
			[
				[-2.8, -15, 0],
				[-5.5, -11, 0.2],
				[-2.8, -10, 0],
			],
			[
				[-2.8, 0, 0],
				[-9.5, 7.5, 0.4],
				[-2.8, 8, 0],
			],
			[
				[-2.6, 12, 0],
				[-6.5, 18, 0.2],
				[-2.5, 18, 0],
			],
		],
	},
];
const cockpit = "0,-13 1.3,-10.5 1.3,-6.5 0,-4.5 -1.3,-6.5 -1.3,-10.5";
const planes = (v: Variant) =>
	v.planes.flatMap((pts) => {
		const mirrored = pts.some(([x]) => x < 0)
			? [pts, pts.map(([x, y, z]): XYZ => [-x, y, z])]
			: [pts];
		return mirrored.map((set) => ({
			points: set.map(([x, y]) => `${x},${y}`).join(" "),
			fill: shade(set),
		}));
	});
---

<div class="lowpoly">
	<label class="toggle"
		><input type="checkbox">
		Show fold lines</label
	>
	<div class="cards">
		{variants.map((v) => {
			const facets = planes(v);
			return (
				<figure>
					<figcaption>{v.name}</figcaption>
					<svg
						viewBox="-20 -24 40 48"
						role="img"
						aria-label={`${v.name}. ${v.idea} Nose up, chassis planes only.`}
					>
						{facets.map((p) => (
							<polygon points={p.points} fill={p.fill} />
						))}
						<polygon
							points={cockpit}
							fill="#000"
							stroke={f[0]}
							stroke-width="0.35"
						/>
						<g class="folds">
							{facets.map((p) => (
								<polygon points={p.points} />
							))}
						</g>
					</svg>
					<p>{v.idea}</p>
				</figure>
			);
		})}
	</div>
</div>
<style>
.toggle {
	display: flex;
	align-items: center;
	gap: var(--spacing-sm);
	min-height: 44px;
	margin-bottom: var(--spacing-md);
	cursor: pointer;
}
input {
	accent-color: var(--color-acid-lime);
	width: 20px;
	height: 20px;
}
input:focus-visible {
	outline: 2px solid var(--color-acid-lime);
	outline-offset: 4px;
}
.cards {
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: var(--spacing-md);
}
figure {
	margin: 0;
	padding: var(--spacing-md);
	border: var(--flight-border);
}
figcaption {
	color: var(--color-acid-lime);
	font: var(--font-small) var(--font-flight);
}
svg {
	display: block;
	width: 100%;
	height: 300px;
	margin-block: var(--spacing-md);
}
.folds polygon {
	fill: none;
	stroke: var(--color-text);
	stroke-opacity: 0.55;
	stroke-width: 0.25;
	stroke-linejoin: round;
}
.lowpoly:not(:has(input:checked)) .folds {
	display: none;
}
figure p {
	margin: 0;
}
@media (max-width: 900px) {
	.cards {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
}
@media (max-width: 580px) {
	.cards {
		grid-template-columns: 1fr;
	}
}
</style>
