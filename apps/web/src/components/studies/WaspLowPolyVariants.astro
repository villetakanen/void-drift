---
import { FIGHTER } from "../../../../../packages/mode-a/src/lib/fighter";

/**
 * Six low-poly readings of the Wasp outline, built on the fold nodes drawn in
 * the owner's 2026-11-01 sketch. Nose up, ship units. No engines, slots or
 * stabilizers: chassis planes only. Light comes from the left, as on the
 * Fighter and Scout, so left-facing planes are lighter than right-facing ones.
 */
type Point = readonly [number, number];
const left: Record<string, Point> = {
	nT: [0, -20],
	n: [-2.8, -20],
	s: [-5.5, -9],
	sC: [0, -9],
	t: [-14.5, 5],
	p: [-8.5, 3.4],
	rt: [-11, 10],
	r: [-8.5, 10],
	c: [-5.3, 19.5],
	m: [0, 19.5],
	k: [0, 2],
	q: [-3, 2.7],
};
const mirror = (name: string): Point => {
	const [x, y] = left[name];
	return [-x, y];
};
const node = (name: string): Point =>
	name.endsWith("R") ? mirror(name.slice(0, -1)) : left[name];
const f = FIGHTER.facets;
/** Palette from brightest to darkest. */
const shade = [f[0], f[1], f[5], f[2], f[4], f[3]];
const cockpit = "0,-11.4 -3,-6.1 -3,-0.7 0,2 3,-0.7 3,-6.1";

interface Facet {
	nodes: string[];
	/** Shade index for the left copy and its mirrored right copy; one value is a centre plane. */
	shades: [number, number] | [number];
}
interface Variant {
	name: string;
	idea: string;
	facets: Facet[];
}
const cheek: Facet = { nodes: ["nT", "n", "s", "q", "k"], shades: [1, 4] };
const wingUpper: Facet = { nodes: ["s", "t", "p"], shades: [2, 3] };
const wingInner: Facet = { nodes: ["s", "p", "q"], shades: [1, 3] };
const wingLower: Facet = { nodes: ["t", "rt", "r", "p"], shades: [3, 4] };
const sideBox: Facet = { nodes: ["p", "r", "q"], shades: [4, 5] };
const flank: Facet = { nodes: ["q", "r", "c"], shades: [2, 4] };
const keelOuter: Facet = { nodes: ["q", "c", "m"], shades: [3, 5] };
const keelInner: Facet = { nodes: ["q", "k", "m"], shades: [0, 2] };

const variants: Variant[] = [
	{
		name: "01 / As drawn, tent keel",
		idea: "Every sketched fold kept. The spine is a raised ridge from nose to stern; the stern tent and spar both read as peaks.",
		facets: [
			cheek,
			wingUpper,
			wingInner,
			wingLower,
			sideBox,
			flank,
			keelOuter,
			keelInner,
		],
	},
	{
		name: "02 / As drawn, valley keel",
		idea: "Same folds, but the long stern triangles fall inward: the spine behind the canopy is a channel, not a ridge.",
		facets: [
			cheek,
			wingUpper,
			wingInner,
			wingLower,
			sideBox,
			flank,
			{ nodes: ["q", "c", "m"], shades: [1, 3] },
			{ nodes: ["q", "k", "m"], shades: [4, 5] },
		],
	},
	{
		name: "03 / Three planes a side",
		idea: "Shoulder-to-spar and box folds dropped. One wing plate, one cheek, one stern plane per side: the calmest body.",
		facets: [
			cheek,
			{ nodes: ["s", "t", "rt", "r", "q"], shades: [2, 3] },
			{ nodes: ["q", "r", "c", "m", "k"], shades: [3, 5] },
		],
	},
	{
		name: "04 / Spar ridge",
		idea: "The spar from wingtip to canopy base is the sharpest edge. Everything ahead of it faces the light; everything behind falls away.",
		facets: [
			{ nodes: ["nT", "n", "s", "q", "k"], shades: [0, 2] },
			{ nodes: ["s", "t", "p"], shades: [1, 3] },
			{ nodes: ["s", "p", "q"], shades: [0, 2] },
			{ nodes: ["t", "rt", "r", "p"], shades: [4, 5] },
			{ nodes: ["p", "r", "q"], shades: [3, 5] },
			{ nodes: ["q", "r", "c"], shades: [4, 5] },
			{ nodes: ["q", "c", "m"], shades: [3, 4] },
			{ nodes: ["q", "k", "m"], shades: [2, 3] },
		],
	},
	{
		name: "05 / Boxed flank",
		idea: "The shoulder, box and flank folds merge into one steep side wall under a flat wing plate, giving the small body visible depth.",
		facets: [
			cheek,
			{ nodes: ["s", "t", "rt", "r", "p"], shades: [2, 2] },
			{ nodes: ["s", "p", "r", "c", "q"], shades: [4, 5] },
			{ nodes: ["q", "c", "m", "k"], shades: [1, 3] },
		],
	},
	{
		name: "06 / Nose cap, flat stern",
		idea: "A cross fold on the shoulder line tilts the nose forward as its own cap; behind the canopy the stern becomes one flat deck.",
		facets: [
			{ nodes: ["n", "nR", "sR", "s"], shades: [2] },
			{ nodes: ["s", "q", "k", "sC"], shades: [1, 4] },
			wingUpper,
			wingInner,
			wingLower,
			sideBox,
			flank,
			{ nodes: ["q", "c", "m", "cR", "qR", "k"], shades: [3] },
		],
	},
];
const polygon = (names: string[]) =>
	names.map((n) => node(n).join(",")).join(" ");
const mirrored = (names: string[]) =>
	names.map((n) => (n.endsWith("R") ? n.slice(0, -1) : `${n}R`));
---

<div class="lowpoly">
	<label class="toggle"
		><input type="checkbox">
		Show fold lines</label
	>
	<div class="cards">
		{variants.map((v) => (
			<figure>
				<figcaption>{v.name}</figcaption>
				<svg
					viewBox="-20 -24 40 48"
					role="img"
					aria-label={`${v.name}. ${v.idea} Nose up, chassis planes only.`}
				>
					{v.facets.map((facet) =>
						facet.shades.length === 2 ? (
							<>
								<polygon
									points={polygon(facet.nodes)}
									fill={shade[facet.shades[0]]}
								/>
								<polygon
									points={polygon(mirrored(facet.nodes))}
									fill={shade[facet.shades[1]]}
								/>
							</>
						) : (
							<polygon
								points={polygon(facet.nodes)}
								fill={shade[facet.shades[0]]}
							/>
						),
					)}
					<polygon
						points={cockpit}
						fill="#000"
						stroke={f[1]}
						stroke-width="0.3"
					/>
					<g class="folds">
						{v.facets.map((facet) =>
							facet.shades.length === 2 ? (
								<>
									<polygon points={polygon(facet.nodes)} />
									<polygon points={polygon(mirrored(facet.nodes))} />
								</>
							) : (
								<polygon points={polygon(facet.nodes)} />
							),
						)}
					</g>
				</svg>
				<p>{v.idea}</p>
			</figure>
		))}
	</div>
</div>
<style>
.toggle {
	display: flex;
	align-items: center;
	gap: var(--spacing-sm);
	min-height: 44px;
	margin-bottom: var(--spacing-md);
	cursor: pointer;
}
input {
	accent-color: var(--color-acid-lime);
	width: 20px;
	height: 20px;
}
input:focus-visible {
	outline: 2px solid var(--color-acid-lime);
	outline-offset: 4px;
}
.cards {
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: var(--spacing-md);
}
figure {
	margin: 0;
	padding: var(--spacing-md);
	border: var(--flight-border);
}
figcaption {
	color: var(--color-acid-lime);
	font: var(--font-small) var(--font-flight);
}
svg {
	display: block;
	width: 100%;
	height: 300px;
	margin-block: var(--spacing-md);
}
.folds polygon {
	fill: none;
	stroke: var(--color-text);
	stroke-opacity: 0.55;
	stroke-width: 0.25;
	stroke-linejoin: round;
}
.lowpoly:not(:has(input:checked)) .folds {
	display: none;
}
figure p {
	margin: 0;
}
@media (max-width: 900px) {
	.cards {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
}
@media (max-width: 580px) {
	.cards {
		grid-template-columns: 1fr;
	}
}
</style>
