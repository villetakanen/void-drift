---
import { FIGHTER } from "../../../../../packages/mode-a/src/lib/fighter";

/**
 * Six slim low-poly Wasp bodies inside the sketched outline, nose up, in ship
 * units. Every plane carries heights, so it has a real normal and is shaded
 * from one light (ahead, left and above) in the shared Fighter palette.
 * Chassis planes only: no engines, slots or stabilizers.
 */
type XYZ = readonly [number, number, number];
const f = FIGHTER.facets;
const stops = [f[0], f[1], f[5], f[2], f[4], f[3]];
const hex = (c: string) =>
	[1, 3, 5].map((i) => parseInt(c.slice(i, i + 2), 16));
const mix = (t: number) => {
	const x = Math.min(Math.max(t, 0), 1) * (stops.length - 1);
	const i = Math.min(Math.floor(x), stops.length - 2);
	const u = x - i;
	const a = hex(stops[i]);
	const b = hex(stops[i + 1]);
	return `#${a
		.map((v, j) =>
			Math.round(v + (b[j] - v) * u)
				.toString(16)
				.padStart(2, "0"),
		)
		.join("")}`;
};
const light = (() => {
	const v = [-0.75, -0.3, 0.5];
	const l = Math.hypot(...v);
	return v.map((x) => x / l);
})();
const shade = (points: XYZ[]) => {
	let nx = 0;
	let ny = 0;
	let nz = 0;
	for (let i = 0; i < points.length; i++) {
		const [x1, y1, z1] = points[i];
		const [x2, y2, z2] = points[(i + 1) % points.length];
		nx += (y1 - y2) * (z1 + z2);
		ny += (z1 - z2) * (x1 + x2);
		nz += (x1 - x2) * (y1 + y2);
	}
	const l = Math.hypot(nx, ny, nz) || 1;
	if (nz < 0) {
		nx = -nx;
		ny = -ny;
		nz = -nz;
	}
	const dot = (nx * light[0] + ny * light[1] + nz * light[2]) / l;
	return mix(1 - Math.min(Math.max((dot - 0.05) / 0.9, 0), 1));
};

interface Variant {
	name: string;
	idea: string;
	/** Left-side and centre planes as [x, y, z]; planes with x < 0 are mirrored. */
	planes: XYZ[][];
}
/**
 * Sketched outline, left side, nose to stern. Every body keeps it exactly.
 * n nose edge, s shoulder, t wingtip, rt/r trailing cut, c stern corner.
 */
const n: XYZ = [-2.8, -20, 0];
const s: XYZ = [-5.5, -9, 0];
const t: XYZ = [-14.5, 5, 0];
const rt: XYZ = [-11, 10, 0];
const r: XYZ = [-8.5, 10, 0];
const c: XYZ = [-5.3, 19.5, 0];
/**
 * Narrow raised fuselage: quads between a spine (x 0, given heights) and a
 * side line (z 0) with matching y stations, nose to stern.
 */
const fuselage = (
	side: readonly (readonly [number, number])[],
	spine: readonly number[],
): XYZ[][] =>
	side.slice(0, -1).map((_, i) => [
		[0, side[i][1], spine[i]],
		[side[i][0], side[i][1], 0],
		[side[i + 1][0], side[i + 1][1], 0],
		[0, side[i + 1][1], spine[i + 1]],
	]);
const tube: (readonly [number, number])[] = [
	[-2.8, -20],
	[-2.8, -8],
	[-2.8, 12],
	[-2.8, 19.5],
];
const variants: Variant[] = [
	{
		name: "01 / Tube and plate",
		idea: "A straight 5.6-unit fuselage with a high spine, nose to stern. Everything outside it is one flat wing plate a side. Eight planes.",
		planes: [
			...fuselage(tube, [0.5, 3, 3, 1.5]),
			[n, s, t, rt, r, c, [-2.8, 19.5, 0]],
		],
	},
	{
		name: "02 / Shouldered body",
		idea: "The fuselage follows the nose taper out to the shoulders, then narrows to the stern: the shoulders become body, like intake cheeks. Eight planes.",
		planes: [
			...fuselage(
				[
					[-2.8, -20],
					[-5.5, -9],
					[-2.8, 12],
					[-2.5, 19.5],
				],
				[0.5, 3.2, 2.8, 1.4],
			),
			[s, t, rt, r, c, [-2.5, 19.5, 0], [-2.8, 12, 0]],
		],
	},
	{
		name: "03 / Spar fold, dihedral",
		idea: "Tube fuselage; the plate folds along the sketched spar from wingtip to body, with the tip raised. Two wing planes a side at different angles. Ten planes.",
		planes: [
			...fuselage(tube, [0.5, 3, 3, 1.5]),
			[n, s, [-14.5, 5, 0.7], [-2.8, 2.5, 0]],
			[[-2.8, 2.5, 0], [-14.5, 5, 0.7], rt, r, c, [-2.8, 19.5, 0]],
		],
	},
	{
		name: "04 / Spar fold, anhedral",
		idea: "The same spar fold with the tip dropped instead, so the blades hang from the body. Ten planes.",
		planes: [
			...fuselage(tube, [0.5, 3.2, 3.2, 1.5]),
			[n, s, [-14.5, 5, -0.9], [-2.8, 2.5, 0]],
			[[-2.8, 2.5, 0], [-14.5, 5, -0.9], rt, r, c, [-2.8, 19.5, 0]],
		],
	},
	{
		name: "05 / Boom stern",
		idea: "The fuselage pinches to 3.6 units behind the canopy and runs out as a boom; the plate keeps the stern corners as a tail. Eight planes.",
		planes: [
			...fuselage(
				[
					[-2.8, -20],
					[-2.8, -6],
					[-1.8, 8],
					[-1.8, 19.5],
				],
				[0.5, 3, 2.4, 1.2],
			),
			[n, s, t, rt, r, c, [-1.8, 19.5, 0], [-1.8, 8, 0], [-2.8, -6, 0]],
		],
	},
	{
		name: "06 / Flat deck, chines",
		idea: "A level deck 3.2 units wide drops over sharp chines to the plate: a boxy stealth fuselage on the same outline. Ten planes.",
		planes: [
			[[0, -20, 0.5], n, [-1.6, -8, 2.6], [0, -8, 2.6]],
			[
				[0, -8, 2.6],
				[-1.6, -8, 2.6],
				[-1.6, 12, 2.6],
				[0, 12, 2.6],
			],
			[
				[-1.6, -8, 2.6],
				[-2.8, -8, 0],
				[-2.8, 12, 0],
				[-1.6, 12, 2.6],
			],
			[
				[0, 12, 2.6],
				[-1.6, 12, 2.6],
				[-2.8, 12, 0],
				[-2.8, 19.5, 0],
				[0, 19.5, 1],
			],
			[n, s, t, rt, r, c, [-2.8, 19.5, 0], [-2.8, 12, 0], [-2.8, -8, 0]],
		],
	},
];
const cockpit = "0,-13 1.3,-10.5 1.3,-6.5 0,-4.5 -1.3,-6.5 -1.3,-10.5";
const planes = (v: Variant) =>
	v.planes.flatMap((pts) => {
		const mirrored = pts.some(([x]) => x < 0)
			? [pts, pts.map(([x, y, z]): XYZ => [-x, y, z])]
			: [pts];
		return mirrored.map((set) => ({
			points: set.map(([x, y]) => `${x},${y}`).join(" "),
			fill: shade(set),
		}));
	});
---

<div class="lowpoly">
	<label class="toggle"
		><input type="checkbox">
		Show fold lines</label
	>
	<div class="cards">
		{variants.map((v) => {
			const facets = planes(v);
			return (
				<figure>
					<figcaption>{v.name}</figcaption>
					<svg
						viewBox="-20 -24 40 48"
						role="img"
						aria-label={`${v.name}. ${v.idea} Nose up, chassis planes only.`}
					>
						{facets.map((p) => (
							<polygon points={p.points} fill={p.fill} />
						))}
						<polygon
							points={cockpit}
							fill="#000"
							stroke={f[0]}
							stroke-width="0.35"
						/>
						<g class="folds">
							{facets.map((p) => (
								<polygon points={p.points} />
							))}
						</g>
					</svg>
					<p>{v.idea}</p>
				</figure>
			);
		})}
	</div>
</div>
<style>
.toggle {
	display: flex;
	align-items: center;
	gap: var(--spacing-sm);
	min-height: 44px;
	margin-bottom: var(--spacing-md);
	cursor: pointer;
}
input {
	accent-color: var(--color-acid-lime);
	width: 20px;
	height: 20px;
}
input:focus-visible {
	outline: 2px solid var(--color-acid-lime);
	outline-offset: 4px;
}
.cards {
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: var(--spacing-md);
}
figure {
	margin: 0;
	padding: var(--spacing-md);
	border: var(--flight-border);
}
figcaption {
	color: var(--color-acid-lime);
	font: var(--font-small) var(--font-flight);
}
svg {
	display: block;
	width: 100%;
	height: 300px;
	margin-block: var(--spacing-md);
}
.folds polygon {
	fill: none;
	stroke: var(--color-text);
	stroke-opacity: 0.55;
	stroke-width: 0.25;
	stroke-linejoin: round;
}
.lowpoly:not(:has(input:checked)) .folds {
	display: none;
}
figure p {
	margin: 0;
}
@media (max-width: 900px) {
	.cards {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
}
@media (max-width: 580px) {
	.cards {
		grid-template-columns: 1fr;
	}
}
</style>
