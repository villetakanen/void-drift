<div class="wasp-gallery">
  <div class="cards">
    {variants.map((v) => (
      <figure>
        <figcaption>{v.name}</figcaption>
        <svg
          viewBox="-24 -30 48 64"
          role="img"
          aria-label={`${v.name}. ${v.idea} Bow up, 36 by 49.5 ship units.`}
        >
          <g class="hull">
            {v.facets.map((f) => (
              <polygon points={pts(f.points)} fill={palette[f.shade]} />
            ))}
          </g>
          <g class="canopy">
            {v.canopy.map((c) => (
              <polygon points={pts(c.points)} class={`canopy-${c.tone}`} />
            ))}
          </g>
        </svg>
        <p>{v.idea}</p>
      </figure>
    ))}
  </div>

  <figure class="scale-strip">
    <figcaption>
      Hull scale comparison · Identical ship units (Wasp 49.5, Scout 52, Fighter
      73)
    </figcaption>
    <svg
      viewBox="-115 -38 230 78"
      role="img"
      aria-label="LHI Wasp (49.5 units long) beside production Scout (52 units long) and production Fighter (73 units long) at identical scale."
    >
      <g transform="translate(-72 0)">
        <g class="hull">
          {variants[0].facets.map((f) => (
            <polygon points={pts(f.points)} fill={palette[f.shade]} />
          ))}
        </g>
        <g class="canopy">
          {variants[0].canopy.map((c) => (
            <polygon points={pts(c.points)} class={`canopy-${c.tone}`} />
          ))}
        </g>
        <text class="ship-label" x="0" y="34" text-anchor="middle">
          LHI WASP
        </text>
      </g>

      <g transform="translate(0 0)">
        <g transform="rotate(-90)">
          {SCOUT.facets.map((f) => (
            <polygon points={pts(f.points)} fill={f.color} />
          ))}
          <circle
            cx={SCOUT.cockpit.x}
            cy={SCOUT.cockpit.y}
            r={SCOUT.cockpit.collarRadius}
            fill={FIGHTER.facets[2]}
          />
          <circle
            cx={SCOUT.cockpit.x}
            cy={SCOUT.cockpit.y}
            r={SCOUT.cockpit.radius}
            fill="#000000"
          />
        </g>
        <text class="ship-label" x="0" y="34" text-anchor="middle">SCOUT</text>
      </g>

      <g transform="translate(72 11)">
        <g transform="rotate(-90)">
          {FIGHTER.hull.map((p, i) => {
            const n = FIGHTER.hull[(i + 1) % FIGHTER.hull.length];
            return (
              <polygon
                points={`-3,0 ${p.join(",")} ${n.join(",")}`}
                fill={
                  FIGHTER.facets[(p[1] + n[1]) / 2 < 0 ? i % 3 : 3 + (i % 3)]
                }
              />
            );
          })}
          <polygon points={pts(FIGHTER.ridge)} fill="#a2d8df" />
          <polygon points="38,0 -21,0 -15,4" fill="#51869e" />
          <polygon points={pts(FIGHTER.cockpit)} fill="#000000" />
        </g>
        <text class="ship-label" x="0" y="23" text-anchor="middle">
          FIGHTER
        </text>
      </g>
    </svg>
  </figure>
</div>

<style>
.wasp-gallery {
  margin-block: var(--spacing-lg);
}
.cards {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--spacing-md);
}
figure {
  margin: 0;
  padding: var(--spacing-md);
  border: var(--flight-border);
  background: var(--color-void-light, #070b10);
  display: flex;
  flex-direction: column;
}
figcaption {
  color: var(--color-acid-lime);
  font: var(--font-small) var(--font-flight);
}
svg {
  display: block;
  width: 100%;
  height: 290px;
  margin-block: var(--spacing-sm);
}
figure p {
  margin: 0;
  font-size: var(--font-small);
  color: var(--color-text-dim);
}

.canopy-left,
.canopy-left-top {
  fill: #050a0e;
}
.canopy-right,
.canopy-right-top,
.canopy-left-bot,
.canopy-right-bot {
  fill: #000000;
}

.scale-strip {
  margin-top: var(--spacing-lg);
}
.scale-strip svg {
  height: 240px;
}
.ship-label {
  fill: var(--color-text-dim);
  font: 2.6px var(--font-flight);
}

@media (max-width: 900px) {
  .cards {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
@media (max-width: 580px) {
  .cards {
    grid-template-columns: 1fr;
  }
}
</style>
