---
const variants = [
	{
		id: "exposed",
		title: "A / Clamped cell assembly",
		description:
			"Three separate pressure-like cells, joined by two transverse clamps. The gaps and stepped ends make the construction visible.",
	},
	{
		id: "frame",
		title: "B / Load-bearing frame",
		description:
			"The same cells sit inside an open structural cradle. Broad shoulders and projecting feet give the assembly a heavier industrial stance.",
	},
];
---

<div class="constructions">
	{variants.map((v) => (
		<article>
			<h4>{v.title}</h4>
			<svg
				class="large"
				viewBox="-44 -48 88 96"
				role="img"
				aria-label={v.title}
			>
				<defs>
					<g id={`construction-${v.id}`}>
						{v.id === "frame" && (
							<g>
								<path
									d="M-30-33 H30 V33 H-30 Z M-20-23 V23 H20 V-23 Z"
									fill-rule="evenodd"
									fill="#657780"
								/>
								<path
									d="M-30-33 H30 L25-27 H-25 Z M-30-33 L-25-27 V27 L-30 33 Z"
									fill="#b6c5ca"
								/>
								<path d="M30-33 V33 H-30 L-25 27 H25 V-27 Z" fill="#374952" />
								{[-1, 1].map((sign) => (
									<g transform={`translate(${sign * 30} 0)`}>
										<path
											d="M-5-23 H5 V-12 H-5 Z M-5 12 H5 V23 H-5 Z"
											fill="#91a2a9"
										/>
									</g>
								))}
							</g>
						)}
						{[-1, 0, 1].map((i) => (
							<g transform={`translate(${i * 14} ${i === 0 ? -4 : 2})`}>
								<path
									d="M-6-23 L-3-28 H3 L6-23 V23 L3 28 H-3 L-6 23 Z"
									fill="#778b94"
								/>
								<path d="M-6-23 L-3-28 V25 L-6 23 Z" fill="#bac8cc" />
								<path d="M3-28 L6-23 V23 L3 28 Z" fill="#435963" />
								<path d="M-3-28 H3 L6-23 H-6 Z" fill="#d1dadd" />
								<path d="M-3 19 H3 V23 H-3 Z" fill="#d3be88" />
							</g>
						))}
						{[-14, 14].map((y) => (
							<g transform={`translate(0 ${y})`}>
								<path d="M-23-4 H23 V4 H-23 Z" fill="#3b4b52" />
								<path d="M-23-4 H23 L20-1 H-20 Z" fill="#aab8be" />
								<path
									d="M-23-4 H-18 V4 H-23 Z M18-4 H23 V4 H18 Z"
									fill="#71858f"
								/>
							</g>
						))}
					</g>
				</defs>
				<use href={`#construction-${v.id}`} />
			</svg>
			<p>{v.description}</p>
			<div class="samples">
				<span>Small silhouette check · 32 px</span>
				<svg
					width="32"
					height="36"
					viewBox="-44 -48 88 96"
					role="img"
					aria-label={`${v.title}, small view`}
				>
					<use href={`#construction-${v.id}`} />
				</svg>
			</div>
		</article>
	))}
</div>
<style>
.constructions {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: var(--spacing-lg);
	margin-block: var(--spacing-lg);
}
article {
	padding: var(--spacing-lg);
	background: var(--color-void-light);
	border: var(--flight-border);
}
h4 {
	margin: 0;
}
.large {
	display: block;
	width: 100%;
	height: 280px;
}
.samples {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: var(--spacing-md);
	color: var(--color-text-muted);
	font-size: var(--font-size-caption);
}
@media (max-width: 650px) {
	.constructions {
		grid-template-columns: 1fr;
	}
}
</style>
