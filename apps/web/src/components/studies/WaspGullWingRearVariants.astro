<div class="wasp-rear-gallery">
	<div class="cards">
		{variants.map((v) => {
			const [botL, tip] = v.canopyAft ?? [
				[-3, -1],
				[0, 3.5],
			];
			const botR: Point = [-botL[0], botL[1]];
			return (
				<figure>
					<figcaption>{v.name}</figcaption>
					<svg
						viewBox="-24 -30 48 64"
						role="img"
						aria-label={`${v.name}. ${v.idea}`}
					>
						<g class="hull">
							{sharedForeFacets.map((f) => (
								<polygon points={pts(f.points)} fill={palette[f.shade]} />
							))}
							{v.aftFacets.map((f) => (
								<polygon points={pts(f.points)} fill={palette[f.shade]} />
							))}
						</g>
						<g class="canopy">
							<polygon
								points={pts([[0, -16], [-3, -10], botL, tip])}
								fill="#050a0e"
							/>
							<polygon
								points={pts([[0, -16], [3, -10], botR, tip])}
								fill="#000000"
							/>
						</g>
					</svg>
					<p>{v.idea}</p>
				</figure>
			);
		})}
	</div>
</div>

<style>
.wasp-rear-gallery {
	margin-block: var(--spacing-lg);
}
.cards {
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: var(--spacing-md);
}
figure {
	margin: 0;
	padding: var(--spacing-md);
	border: var(--flight-border);
	background: var(--color-void-light, #070b10);
	display: flex;
	flex-direction: column;
}
figcaption {
	color: var(--color-acid-lime);
	font: var(--font-small) var(--font-flight);
}
svg {
	display: block;
	width: 100%;
	height: 290px;
	margin-block: var(--spacing-sm);
}
figure p {
	margin: 0;
	font-size: var(--font-small);
	color: var(--color-text-dim);
}
@media (max-width: 900px) {
	.cards {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
}
@media (max-width: 580px) {
	.cards {
		grid-template-columns: 1fr;
	}
}
</style>
