---
import { buildMounts, defaultBuilds } from "@void-drift/mode-a";
import { FIGHTER } from "../../../../../packages/mode-a/src/lib/fighter";

const mounts = buildMounts(defaultBuilds().scout);
const variants = [
	{
		name: "01 / Swept talons",
		idea: "Long shoulder barbs sweep aft; a narrow, bevelled spear carries the tail fitting.",
		hull: "0,-22 18,13 10,7 5,9 -5,9 -10,7 -18,13",
		tail: "-4,6 4,6 6,13 6,24 0,30 -6,24 -6,13",
	},
	{
		name: "02 / Forward fangs",
		idea: "Two forward-pointing blades flank the bubble; the stern flares into a clipped counter-wedge.",
		hull: "0,-20 7,-12 15,-22 12,-5 17,9 6,7 -6,7 -17,9 -12,-5 -15,-22 -7,-12",
		tail: "-4,5 4,5 9,26 0,23 -9,26",
	},
	{
		name: "03 / Counter triangle",
		idea: "A clean forward wedge meets a broad, opposite-pointing tail: two triangles, tightly joined.",
		hull: "0,-22 17,9 6,5 -6,5 -17,9",
		tail: "-4,5 4,5 12,12 0,30 -12,12",
	},
	{
		name: "04 / Split knives",
		idea: "Deep swept cuts leave two sharp outer blades; a long diamond tail continues the central ridge.",
		hull: "0,-22 19,16 12,10 10,1 5,7 -5,7 -10,1 -12,10 -19,16",
		tail: "0,4 8,18 0,32 -8,18",
	},
	{
		name: "05 / Barbed dart",
		idea: "Two hard changes of angle create small hooked shoulders; a broad counter-triangle anchors the rear.",
		hull: "0,-22 12,-4 10,-2 18,12 9,8 5,10 -5,10 -9,8 -18,12 -10,-2 -12,-4",
		tail: "-4,7 4,7 13,14 0,29 -13,14",
	},
	{
		name: "06 / Razor kite",
		idea: "A narrow faceted kite sheds its shoulders into rearward spikes, paired with a compact diamond tail.",
		hull: "0,-22 13,-1 17,13 8,7 4,9 -4,9 -8,7 -17,13 -13,-1",
		tail: "0,5 9,16 0,29 -9,16",
	},
].map((v) => ({
	...v,
	cockpitY: -21,
	radius: 6,
	deckY: -7,
	sideY: 2,
	arm: 10.5,
	aftY: 17,
	angle: 26,
}));
---

<div class="aggressive-hulls">
	<label class="toggle"
		><input type="checkbox" checked>
		Show mount footprints</label
	>
	<div class="cards">
		{variants.map((v, i) => (
			<figure>
				<figcaption>{v.name}</figcaption>
				<svg
					viewBox="-25 -33 50 72"
					role="img"
					aria-label={`${v.name}. ${v.idea} Cockpit first, one deck mount, two side engines and one tail mount. Nose up.`}
				>
					<defs>
						<clipPath id={`scout-aggressive-${i}`}>
							<polygon points={v.hull} />
						</clipPath>
					</defs>
					<polygon points={v.tail} fill={FIGHTER.facets[2]} />
					<defs>
						<clipPath id={`scout-tail-${i}`}>
							<polygon points={v.tail} />
						</clipPath>
					</defs>
					<g clip-path={`url(#scout-tail-${i})`}>
						<polygon points="-16,4 0,4 0,34" fill={FIGHTER.facets[1]} />
						<polygon points="0,4 16,4 0,34" fill={FIGHTER.facets[3]} />
						<polygon points="0,6 2,18 0,32 -2,18" fill={FIGHTER.facets[5]} />
					</g>
					<polygon points={v.hull} fill={FIGHTER.facets[4]} />
					<g clip-path={`url(#scout-aggressive-${i})`}>
						<polygon points="0,-24 -22,18 -8,4 0,-8" fill={FIGHTER.facets[1]} />
						<polygon points="0,-24 22,18 8,4 0,-8" fill={FIGHTER.facets[3]} />
						<polygon points="0,-24 -4,-10 -4,10 0,7" fill={FIGHTER.facets[0]} />
						<polygon points="0,-24 4,-10 4,10 0,7" fill={FIGHTER.facets[5]} />
						<polygon
							points="-20,-24 -20,18 -10,4 -8,-12"
							fill={FIGHTER.facets[2]}
						/>
					</g>
					<circle
						cx="0"
						cy={v.cockpitY}
						r={v.radius + 0.8}
						fill={FIGHTER.facets[2]}
					/>
					<circle cx="0" cy={v.cockpitY} r={v.radius} fill="#000000" />
					<g class="mounts">
						{mounts.map((m) => {
							const x =
								m.group === "side" ? (m.index === 0 ? -v.arm : v.arm) : 0;
							const y =
								m.group === "side"
									? v.sideY
									: m.group === "hull"
										? v.deckY
										: v.aftY;
							const angle =
								m.group === "side" ? (m.index === 0 ? v.angle : -v.angle) : 0;
							return (
								<g transform={`translate(${x} ${y}) rotate(${angle})`}>
									<rect
										x={-m.height / 2}
										y={-m.width / 2}
										width={m.height}
										height={m.width}
									/>
									<text text-anchor="middle" y="1.3">
										{m.group === "side" ? "E" : m.group === "hull" ? "H" : "A"}
									</text>
								</g>
							);
						})}
					</g>
				</svg>
				<p>{v.idea}</p>
			</figure>
		))}
	</div>
</div>
<style>
.toggle {
	display: flex;
	align-items: center;
	gap: var(--spacing-sm);
	min-height: 44px;
	margin-bottom: var(--spacing-md);
	cursor: pointer;
}
input {
	accent-color: var(--color-acid-lime);
	width: 20px;
	height: 20px;
}
input:focus-visible {
	outline: 2px solid var(--color-acid-lime);
	outline-offset: 4px;
}
.cards {
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: var(--spacing-md);
}
figure {
	margin: 0;
	padding: var(--spacing-md);
	border: var(--flight-border);
}
figcaption {
	color: var(--color-acid-lime);
	font: var(--font-small) var(--font-flight);
}
svg {
	display: block;
	width: 100%;
	height: 310px;
	margin-block: var(--spacing-md);
}
.mounts rect {
	fill: #071015;
	fill-opacity: 0.65;
	stroke: #e0ffff;
	stroke-width: 0.4;
}
.mounts text {
	fill: #e0ffff;
	font: 3.5px var(--font-flight);
}
.aggressive-hulls:has(input:not(:checked)) .mounts {
	display: none;
}
figure p {
	margin: 0;
}
@media (max-width: 900px) {
	.cards {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
}
@media (max-width: 580px) {
	.cards {
		grid-template-columns: 1fr;
	}
}
</style>
