---
const devices = [
	{
		id: "storage",
		name: "Storage / held potential",
		note: "Paired energy cells seated in an amber clamp. No deployment, pulse or idle motion.",
	},
	{
		id: "solar",
		name: "Solar / reaching for energy",
		note: "Collectors unfold from compact hinges into a broad working span. The coloured hinge blocks remain attached to the centre.",
	},
	{
		id: "gravity",
		name: "Gravity / extending its reach",
		note: "A stationary coil projects an expanding field. The field is an FX hypothesis; its size does not specify a gameplay radius.",
	},
	{
		id: "repair",
		name: "Repair / sending help",
		note: "Four drones leave their attachment points and circulate around a service area. This loop tests distributed activity, not repair targeting.",
	},
];
const poly = (points: string, fill: string) =>
	`<polygon points="${points}" fill="${fill}"/>`;
function block(x: number, y: number, w: number, h: number, accent = false) {
	const colors = accent
		? ["#fff0cb", "#ffb62e", "#9c4d10"]
		: ["#d1e5ec", "#7894a4", "#304759"];
	return (
		poly(
			`${x},${y + 1} ${x + 1},${y} ${x + w - 1},${y} ${x + w},${y + 1} ${x + w},${y + h} ${x},${y + h}`,
			colors[2],
		) +
		poly(
			`${x},${y + 1} ${x + 1},${y} ${x + 1},${y + h - 1} ${x},${y + h}`,
			colors[0],
		) +
		poly(
			`${x + 1},${y} ${x + w - 1},${y} ${x + w - 1},${y + h - 1} ${x + 1},${y + h - 1}`,
			colors[1],
		)
	);
}
---

<div class="state-bench">
	<input type="checkbox" id="opportunity-running">
	<label for="opportunity-running">Activate working states</label>
	<p class="hint">
		Unchecked: both columns rest. Checked: the right column deploys and works.
		Uncheck to return to rest. Reduced-motion preference shows the deployed
		poses without looping motion.
	</p>
	<div class="devices">
		{devices.map((device) => (
			<article>
				<h4>{device.name}</h4>
				<p>{device.note}</p>
				<div class="pair">
					{[false, true].map((active) => (
						<div class:list={["state", { working: active }]}>
							<h5>{active ? "Working proposal" : "Resting"}</h5>
							{[false, true].map((small) => (
								<div class:list={["viewport", { tiny: small }]}>
									<svg
										class:list={["machine", device.id]}
										viewBox="-30 -30 60 60"
										role="img"
										aria-label={`${device.name}, ${active ? "working proposal" : "resting"}, ${small ? "gameplay scale" : "enlarged"}`}
									>
										{device.id === "storage" && (
											<g
												set:html={
													block(-8, -12, 7, 24) +
													block(1, -12, 7, 24) +
													block(-10, -8, 20, 4, true) +
													block(-10, 5, 20, 4, true)
												}
											/>
										)}
										{device.id === "solar" && (
											<>
												<g class="wing left">
													<g set:html={block(-21, -10, 16, 20)} />
													<path
														d="M-19 -7H-7V-3H-19ZM-19 -1H-7V3H-19ZM-19 5H-7V8H-19Z"
														fill="#174c70"
													/>
												</g>
												<g class="wing right">
													<g set:html={block(5, -10, 16, 20)} />
													<path
														d="M7 -7H19V-3H7ZM7 -1H19V3H7ZM7 5H19V8H7Z"
														fill="#174c70"
													/>
												</g>
												<g
													set:html={
														block(-4, -12, 8, 24) +
														block(-7, -3, 5, 7, true) +
														block(2, -3, 5, 7, true)
													}
												/>
											</>
										)}
										{device.id === "gravity" && (
											<>
												<g class="field">
													<ellipse rx="25" ry="20" />
													<ellipse rx="18" ry="25" />
												</g>
												<path
													d="M-12 -6L-6 -12H6L12 -6V6L6 12H-6L-12 6Z M-7 -3V3L-3 7H3L7 3V-3L3 -7H-3Z"
													fill="#819eae"
													fill-rule="evenodd"
												/>
												<path
													d="M-12 -6L-6 -12H6L3 -7H-3L-7 -3Z"
													fill="#d1e5ec"
												/>
												<path d="M7 3L12 6L6 12H-6L-3 7H3Z" fill="#304759" />
												<g
													set:html={
														block(-15, -3, 7, 6, true) +
														block(8, -3, 7, 6, true) +
														block(-3, -5, 6, 10)
													}
												/>
											</>
										)}
										{device.id === "repair" && (
											<>
												<g
													set:html={
														block(-7, -7, 14, 14) + block(-10, -3, 20, 6, true)
													}
												/>
												{[0, 1, 2, 3].map((i) => (
													<g class={`drone drone-${i}`}>
														<g
															set:html={
																block(-2, -12, 4, 6) + block(-2, -9, 4, 2, true)
															}
														/>
													</g>
												))}
											</>
										)}
									</svg>
								</div>
							))}
							<span>4× enlarged / 0.65× flight scale</span>
						</div>
					))}
				</div>
			</article>
		))}
	</div>
</div>
<style>
.state-bench {
	margin-block: 2rem;
}
label {
	cursor: pointer;
	font-weight: 600;
	padding: 0.7rem;
	display: inline-block;
}
input {
	accent-color: var(--color-action);
	width: 1.2rem;
	height: 1.2rem;
}
input:focus-visible {
	outline: 2px solid var(--color-action);
	outline-offset: 4px;
}
.hint,
span {
	color: var(--color-text-muted);
}
.devices {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: 2rem;
}
article {
	min-width: 0;
	border-top: 1px solid var(--color-border);
	padding-top: 1rem;
}
.pair {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: 0.5rem;
}
h5,
span {
	display: block;
	text-align: center;
}
span {
	font-size: 0.75rem;
}
.viewport {
	height: 240px;
	display: flex;
	align-items: center;
	justify-content: center;
	overflow: hidden;
}
.machine {
	width: 240px;
	height: 240px;
	flex-shrink: 0;
}
.tiny {
	height: 70px;
	border-top: 1px solid var(--color-border);
}
.tiny .machine {
	width: 39px;
	height: 39px;
}
.wing {
	transition: transform 1.3s ease-in-out;
}
.left {
	transform: translateX(12px) scaleX(0.35);
	transform-origin: -5px 0;
}
.right {
	transform: translateX(-12px) scaleX(0.35);
	transform-origin: 5px 0;
}
.field {
	fill: none;
	stroke: #ffb62e;
	stroke-width: 0.65;
	opacity: 0;
}
.drone-0 {
	transform: rotate(0deg);
}
.drone-1 {
	transform: rotate(90deg);
}
.drone-2 {
	transform: rotate(180deg);
}
.drone-3 {
	transform: rotate(270deg);
}
#opportunity-running:checked ~ .devices .working .wing {
	transform: translateX(0) scaleX(1);
}
#opportunity-running:checked ~ .devices .working .field {
	opacity: 1;
	animation: field 2.8s ease-in-out infinite;
}
#opportunity-running:checked ~ .devices .working .drone {
	animation: orbit 6s linear infinite;
}
#opportunity-running:checked ~ .devices .working .drone-1 {
	animation-delay: -1.5s;
}
#opportunity-running:checked ~ .devices .working .drone-2 {
	animation-delay: -3s;
}
#opportunity-running:checked ~ .devices .working .drone-3 {
	animation-delay: -4.5s;
}
@keyframes field {
	0%,
	100% {
		transform: scale(0.72);
		opacity: 0.35;
	}
	50% {
		transform: scale(1);
		opacity: 1;
	}
}
@keyframes orbit {
	from {
		transform: rotate(0deg) translateY(-10px);
	}
	to {
		transform: rotate(360deg) translateY(-10px);
	}
}
@media (prefers-reduced-motion: reduce) {
	.wing {
		transition: none;
	}
	#opportunity-running:checked ~ .devices .working .field,
	#opportunity-running:checked ~ .devices .working .drone {
		animation: none;
	}
	#opportunity-running:checked ~ .devices .working .drone-0 {
		transform: rotate(0deg) translateY(-10px);
	}
	#opportunity-running:checked ~ .devices .working .drone-1 {
		transform: rotate(90deg) translateY(-10px);
	}
	#opportunity-running:checked ~ .devices .working .drone-2 {
		transform: rotate(180deg) translateY(-10px);
	}
	#opportunity-running:checked ~ .devices .working .drone-3 {
		transform: rotate(270deg) translateY(-10px);
	}
}
@media (max-width: 800px) {
	.devices {
		grid-template-columns: 1fr;
	}
}
@media (max-width: 420px) {
	.viewport:not(.tiny) {
		height: 200px;
	}
	.viewport:not(.tiny) .machine {
		width: 180px;
		height: 180px;
	}
}
</style>
