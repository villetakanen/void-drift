---
interface Props {
	mounts: { x: number; y: number }[][];
}
const { mounts } = Astro.props;
const cards = [
	"A / Exposed winding",
	"B / Winding seated in a ring",
	"C / Captured between supports",
];
const arc = (inner: number, outer: number, start: number, end: number) => {
	const ts = Array.from(
		{ length: 17 },
		(_, i) => ((start + ((end - start) * i) / 16) * Math.PI) / 180,
	);
	return [
		...ts.map((t) => [outer * Math.cos(t), outer * Math.sin(t)]),
		...[...ts].reverse().map((t) => [inner * Math.cos(t), inner * Math.sin(t)]),
	]
		.map((p) => p.join(","))
		.join(" ");
};
