<div class="assemblies">
	{cards.map((name, i) => (
		<figure>
			<figcaption>{name}</figcaption>
			<svg
				width="200"
				height="200"
				viewBox="-50 -55 100 100"
				role="img"
				aria-label={`${name}, on Fighter with Light ion engines`}
			>
				<use href="#belong-ship-1" />
				<g
					transform={`translate(${mounts[1][0].y} ${-mounts[1][0].x}) scale(.5)`}
				>
					{i > 0 && (
						<>
							<polygon points={arc(11, 17, 135, 315)} fill="#83c7d0" />
							<polygon points={arc(11, 17, -45, 135)} fill="#365d79" />
						</>
					)}
					<use href="#assembly-coil-depth-full-0" transform="rotate(90)" />
					{i === 2 && (
						<>
							<polygon points={arc(8, 10, 135, 315)} fill="#83c7d0" />
							<polygon points={arc(8, 10, -45, 135)} fill="#365d79" />
							<path
								d="M-4-17H4L3-8H-3Z M-17-3H-8V3H-17Z M8-3H17V3H8Z M-3 8H3L4 17H-4Z"
								fill="#b5c22a"
							/>
							<path d="M-4-17H0V-8H-3Z M-17-3H-8V0H-17Z" fill="#d7df62" />
							<path d="M0 8H3L4 17H0Z M8 0H17V3H8Z" fill="#87971e" />
						</>
					)}
				</g>
			</svg>
		</figure>
	))}
</div>
<style>
.assemblies {
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: 12px;
}
figure {
	margin: 0;
	padding: 16px;
	border: 1px solid var(--color-border);
	display: flex;
	flex-direction: column;
	align-items: center;
}
figcaption {
	align-self: flex-start;
	font-size: 14px;
}
svg {
	max-width: 100%;
	height: auto;
}
@media (max-width: 600px) {
	.assemblies {
		grid-template-columns: 1fr;
	}
}
</style>
