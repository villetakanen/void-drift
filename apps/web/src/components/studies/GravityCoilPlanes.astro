							: ["#607d8d", "#7894a4", "#a2b7bf", "#8ba7b4"];
					return (
						<polygon
							points={band(
								a + (kind === 0 ? 0.07 : 0),
								b - (kind === 0 ? 0.07 : 0),
							)}
							fill={colors[i]}
						/>
					);
