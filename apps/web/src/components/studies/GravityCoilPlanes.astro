---
import { POTENTIAL_WELL_ART } from "../../../../../packages/mode-a/src/lib/potential-well-art";

interface Props {
	mounts: { x: number; y: number }[][];
}
const { mounts } = Astro.props;
const arc = (r: number, a: number, b: number) =>
	Array.from({ length: 4 }, (_, i) => {
		const t = a + ((b - a) * i) / 3;
		return [r * Math.cos(t), r * Math.sin(t)];
	});
const band = (a: number, b: number) =>
	[...arc(16, a, b), ...arc(8, b, a)].map((p) => p.join(",")).join(" ");
const cards = [
	{
		name: "Reference / Potential Well",
		note: "Production artwork. Dark working interiors and a longitudinal assembly provide a comparison that already feels seated.",
		id: "planes-well",
	},
	{
		name: "A / 1A unchanged",
		note: "The reference coil, turned fore–aft. Its open centre shows the chassis through the winding. No new attachment cues.",
		id: "planes-open",
	},
	{
		name: "B / Eight broad faces",
		note: "Keep the eight sectors and inner ribbon, but make each sector a whole face rather than a light inset surrounded by a dark rim. Tests the outlined-symbol reading.",
		id: "planes-chamber",
	},
	{
		name: "C / One folded ring",
		note: "Keep the ring envelope, opening and ribbon. Join the working surface into four broad directional planes. Tests whether the repeated radial segmentation, rather than the ring itself, creates the icon reading.",
		id: "planes-captured",
	},
];
