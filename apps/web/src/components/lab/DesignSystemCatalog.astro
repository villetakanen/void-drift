---
import "./catalog.css";
import { labPages } from "../../data/lab-pages";

// Every shared part of the design system, read from the Lab's page list:
// its Lab page, the files that define it and the section of its contract.
const parts = labPages
  .filter((page) => page.group === "design-system" && page.href !== "/lab/ds")
  .map((page) => {
    const [file, anchor] = (page.spec ?? "").split("#");
    return {
      ...page,
      specFile: file,
      specSection: anchor,
      atHome: page.href.startsWith("/lab/ds/"),
    };
  });
---

<div class="catalog">
  <section>
    <p>
      Shared definitions for screens to compose: {parts.length} canonical pages.
      A part that is not listed here does not exist yet; say so instead of
      building it in place.
    </p>
    <p class="caption">
      The Design system owns these component pages, including the four pages
      with earlier addresses under <code>/lab</code>. Instrument parts now lives
      in the Design system section.
    </p>
  </section>
  {parts.map((part) => (
    <section aria-labelledby={`part-${part.href.split("/").pop()}`}>
      <h2 id={`part-${part.href.split("/").pop()}`}>
        <a href={part.href}>{part.title}</a>
      </h2>
      <p>{part.purpose}</p>
      <dl>
        <dt>Page</dt>
        <dd>
          <code>{part.href}</code>
          {!part.atHome && <span class="caption"> earlier address</span>}
        </dd>
        <dt>Defined in</dt>
        <dd>
          <ul>
            {(part.defines ?? []).map((file) => (
              <li>
                <code>{file}</code>
              </li>
            ))}
          </ul>
        </dd>
        <dt>Contract</dt>
        <dd>
          <code>{part.specFile}</code>, section
          <code>{part.specSection}</code>
        </dd>
      </dl>
    </section>
  ))}
</div>

<style>
dl {
  display: grid;
  grid-template-columns: max-content 1fr;
  gap: var(--spacing-xs) var(--spacing-md);
  margin: 0;
  font-family: var(--font-family-ui);
  font-size: var(--font-size-label);
}

dt {
  color: var(--color-text-muted);
}

dd {
  margin: 0;
}

ul {
  margin: 0;
  padding: 0;
  list-style: none;
}
</style>
