---
import InstrumentBand from "../instrument/InstrumentBand.astro";
import PlanetInspector from "./PlanetInspector.svelte";

interface Props {
  config: unknown;
  label?: string;
}
const { config, label } = Astro.props;
---

<InstrumentBand>
  <PlanetInspector client:visible {config} {label} />
</InstrumentBand>
