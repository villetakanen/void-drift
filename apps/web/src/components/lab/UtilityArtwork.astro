---
import { UTILITY_ART } from "@void-drift/mode-a";

const ids = ["storage", "solar", "gravity", "repair"] as const;
---

<div class="gallery">
	{ids.map((id) => (
		<figure>
			<figcaption>
				{id}
				{id !== "storage" ? " · conceptual artwork" : " · battery artwork"}
			</figcaption>
			{[false, true].map((small) => (
				<svg
					width={small ? 100 : 240}
					height={small ? 60 : 160}
					viewBox={small ? "-50 -30 100 60" : "-30 -20 60 40"}
					role="img"
					aria-label={`${id}, ${small ? "mounted gameplay scale" : "enlarged"}`}
				>
					<g transform={`rotate(-90) scale(${small ? 0.35 * 0.65 : 1})`}>
						{UTILITY_ART[id].map((face) => (
							<path
								d={face.contours
									.map((c) => `M${c.map((p) => p.join(",")).join("L")}Z`)
									.join(" ")}
								fill={face.color}
								fill-rule={face.fillRule}
							/>
						))}
					</g>
				</svg>
			))}
			<p>Resting artwork · enlarged and mounted flight scale</p>
		</figure>
	))}
</div>
<h2>Existing battery on production hulls</h2>
<p>
	Real loadouts and production drawing rules, enlarged and at 0.65 flight scale.
	Storage occupies the first equipment mount; engines use the default loadout.
</p>
<div class="gallery">
	{["wasp", "scout", "fighter", "corvette"].map((id) => (
		<figure>
			<figcaption>{id}</figcaption>
			<canvas
				width="300"
				height="360"
				data-utility-hull={id}
				aria-label={`${id} with battery, enlarged and gameplay scale`}
			/>
		</figure>
	))}
</div>
<script>
import {
	defaultLoadout,
	drawBuild,
	ShipProfileIdSchema,
} from "@void-drift/mode-a";

for (const canvas of document.querySelectorAll<HTMLCanvasElement>(
	"canvas[data-utility-hull]",
)) {
	const id = ShipProfileIdSchema.parse(canvas.dataset.utilityHull);
	const ctx = canvas.getContext("2d");
	if (!ctx) continue;
	const build = defaultLoadout(id);
	build.hull[0] = "battery";
	drawBuild(ctx, build, 150, 150, -Math.PI / 2, 2.5);
	drawBuild(ctx, build, 150, 325, -Math.PI / 2, 0.65);
}
</script>
<style>
.gallery {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: 1rem;
}
figure {
	margin: 0;
	min-width: 0;
	text-align: center;
	border: 1px solid var(--color-border);
	padding: 1rem;
}
canvas,
svg {
	max-width: 100%;
	height: auto;
	margin: auto;
	display: block;
}
figcaption {
	font-weight: 600;
	text-transform: capitalize;
}
p {
	color: var(--color-text-muted);
}
@media (max-width: 650px) {
	.gallery {
		grid-template-columns: 1fr;
	}
}
</style>
