---
import ShipTuning from "./ShipTuning.svelte";

// The Motion instrument inside a study page: it breaks out of the text column to
// the full width and height of the window and snaps into place as it is
// scrolled to. Pass the study's configuration document; see
// docs/specs/motion-instrument.md.
interface Props {
  config: unknown;
  label?: string;
}
const { config, label } = Astro.props;
---

<div class="instrument-embed">
  <ShipTuning client:visible {config} {label} />
</div>

<style is:global>
/* A page holding the instrument snaps to it while scrolling past. */
html:has(.instrument-embed) {
  scroll-snap-type: y proximity;
  overflow-x: clip;
}
</style>
<style>
.instrument-embed {
  width: 100vw;
  height: 100svh;
  margin-inline: calc(50% - 50vw);
  scroll-snap-align: center;
}
</style>
