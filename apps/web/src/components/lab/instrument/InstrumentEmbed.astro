---
import InstrumentBand from "./InstrumentBand.astro";
import ShipTuning from "./ShipTuning.svelte";

// The Motion instrument inside a study page, in the shared full-window band.
// Pass the study's configuration document; see
// docs/specs/lab/motion-instrument/spec.md.
interface Props {
  config: unknown;
  label?: string;
}
const { config, label } = Astro.props;
---

<InstrumentBand>
  <ShipTuning client:visible {config} {label} />
</InstrumentBand>
