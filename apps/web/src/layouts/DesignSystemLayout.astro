---
import PageHeader from "../components/PageHeader.svelte";
import Tray from "../components/Tray.svelte";
import { labPages } from "../data/lab-pages";
import "@void-drift/core/styles/reset.css";
import "@void-drift/core/styles/tokens.css";
import "@void-drift/core/styles/buttons.css";
import "@void-drift/core/styles/surfaces.css";
import "@void-drift/core/styles/typography.css";
import "@void-drift/core/styles/documents-grid.css";
import "../styles.css";

interface Props {
  title: string;
  wide?: boolean;
  contentClass?: string;
  documentProse?: boolean;
}
const {
  title = "Design system",
  wide = true,
  contentClass,
  documentProse = false,
} = Astro.props;
const section = "Design system";
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const covers = (href: string) =>
  currentPath === href || currentPath.startsWith(`${href}/`);
// The deepest listed page that covers the path is the active one, so an
// overview is not lit alongside the pages beneath it.
const designSystemPages = labPages.filter(
  (page) => page.group === "design-system",
);
const activeHref = designSystemPages
  .map((page) => page.href)
  .filter(covers)
  .sort((a, b) => b.length - a.length)[0];
const componentLinks = designSystemPages
  .filter((page) => page.href !== "/lab/ds")
  .map(({ href, title }) => ({ href, label: title }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">

    <title>{title} | Void Drift {section}</title>
  </head>
  <body>
    <div class:list={["design-system-grid", { wide }]}>
      <!-- Full-width page identity -->
      <div class="page-header">
        <PageHeader
          title={section}
          pageName={title === section ? undefined : title}
          href="/lab/ds"
          links={[
            { href: "/lab", label: "lab" },
            { href: "/lab/studies", label: "studies" },
          ]}
          navigationLabel="Development sites"
        />
      </div>

      <!-- Navigation below the page identity -->
      <aside class="nav-rail">
        <Tray
          label={section}
          links={[{ href: "/lab/ds", label: "Overview" }]}
          groups={[{ label: "Components", links: componentLinks }]}
          footerLinks={[
            { href: "/lab", label: "Lab" },
            { href: "/lab/studies", label: "Design studies" },
            { href: "/", label: "Back to Game" },
          ]}
          activeHref={activeHref}
        />
      </aside>

      <!-- Column 2 Row 2: Main Stage -->
      <main class="main-stage">
        <div class="documents-grid">
          <div
            data-panel-asides
            class:list={[
              "documents-grid__content",
              contentClass,
              { "document-prose": documentProse },
            ]}
          >
            <slot />
          </div>
        </div>
      </main>

      <!-- Inspector beside the main stage -->
      <aside class="inspector-rail" hidden={wide}>
        <slot name="inspector" />
      </aside>
    </div>
  </body>
</html>

<style>
:global(body) {
  margin: 0;
  padding: 0;
  overflow: hidden;
  background: var(--color-void);
  color: var(--color-text);
  font-family: var(--font-family-ui);
}

.design-system-grid {
  display: grid;
  grid-template-columns: 250px minmax(0, 1fr) 300px;
  grid-template-rows: auto minmax(0, 1fr);
  grid-template-areas:
    "header header header"
    "nav main   inspector";
  height: 100vh;
  width: 100vw;
  overflow: hidden;
}

/* Column 1: Nav Rail */
.nav-rail {
  grid-area: nav;
  border-right: 1px solid var(--color-border-subtle);
  overflow-y: auto;
}

/* Full-width identity, inset by the layout. */
.page-header {
  grid-area: header;
  padding: var(--spacing-sm) var(--spacing-md);
  min-width: 0;
  background: var(--color-void);
  display: flex;
  align-items: center;
}

/* Column 2 Row 2: Main Stage */
.main-stage {
  grid-area: main;
  overflow-y: auto;
  background: var(--color-void);
  border-right: 1px solid var(--color-border-subtle);
}

/* A top-level island is one full-width example, even with multiple roots. */
.documents-grid__content > :global(astro-island) {
  display: flex;
  flex-direction: column;
}

/* Column 3: Inspector */
.inspector-rail {
  grid-area: inspector;
  background: var(--color-elev-1);
  overflow-y: auto;
  display: flex;
  flex-direction: column;
}

.design-system-grid.wide {
  grid-template-columns: 250px minmax(0, 1fr);
  grid-template-areas: "header header" "nav main";
}
.wide .inspector-rail {
  display: none;
}
</style>
