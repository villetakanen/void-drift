---
import PageHeader from "../components/PageHeader.svelte";
import Tray from "../components/Tray.svelte";
import { labGroups, labPages } from "../data/lab-pages";
import "@void-drift/core/styles/reset.css";
import "@void-drift/core/styles/tokens.css";
import "@void-drift/core/styles/buttons.css";
import "@void-drift/core/styles/surfaces.css";
import "@void-drift/core/styles/typography.css";
import "../styles.css";

const { title, wide = false } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const groups = labGroups
  .filter((group) => group.id !== "design-system")
  .map((group) => ({
    label: group.label,
    links: labPages
      .filter((page) => page.group === group.id)
      .map(({ href, title }) => ({ href, label: title })),
  }));
// Index is exact-only; nested routes select the deepest visible destination.
const activeHref =
  currentPath === "/lab"
    ? "/lab"
    : groups
        .flatMap((group) => group.links)
        .map((link) => link.href)
        .filter(
          (href) => currentPath === href || currentPath.startsWith(`${href}/`),
        )
        .sort((a, b) => b.length - a.length)[0];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">

    <title>{title} | Void Drift Lab</title>
  </head>
  <body>
    <div class:list={["lab-grid", { wide }]}>
      <!-- Full-width page identity -->
      <div class="page-header">
        <PageHeader
          title="Lab"
          pageName={currentPath === "/lab" ? undefined : title}
          href="/lab"
          links={[
            { href: "/lab/ds", label: "DS" },
            { href: "/lab/studies", label: "studies" },
          ]}
          navigationLabel="Development sites"
        />
      </div>

      <aside class="nav-rail">
        <Tray
          label="Lab"
          links={[{ href: "/lab", label: "Index" }]}
          groups={groups}
          footerLinks={[{ href: "/", label: "Back to Game" }]}
          activeHref={activeHref}
        />
      </aside>

      <!-- Main stage -->
      <main class="main-stage">
        <slot />
      </main>

      <!-- Inspector beside the main stage -->
      <aside class="inspector-rail" hidden={wide}>
        <slot name="inspector" />
      </aside>
    </div>
  </body>
</html>

<style>
:global(body) {
  margin: 0;
  padding: 0;
  overflow: hidden;
  background: var(--color-void);
  color: var(--color-text);
  font-family: var(--font-family-ui);
}

.lab-grid {
  display: grid;
  grid-template-columns: 250px minmax(0, 1fr) 300px;
  grid-template-rows: auto minmax(0, 1fr);
  grid-template-areas:
    "header header header"
    "nav main inspector";
  height: 100vh;
  width: 100vw;
  overflow: hidden;
}

.nav-rail {
  grid-area: nav;
  border-right: 1px solid var(--color-border-subtle);
  overflow-y: auto;
}

.page-header {
  grid-area: header;
  padding: var(--spacing-sm) var(--spacing-md);
  min-width: 0;
  background: var(--color-void);
  display: flex;
  align-items: center;
}

/* Column 2 Row 2: Main Stage */
.main-stage {
  grid-area: main;
  overflow-y: auto;
  background: var(--color-void);
  border-right: 1px solid var(--color-border-subtle);
  display: flex;
  flex-direction: column;
}

/* Column 3: Inspector */
.inspector-rail {
  grid-area: inspector;
  background: var(--color-elev-1);
  overflow-y: auto;
  display: flex;
  flex-direction: column;
}

.lab-grid.wide {
  grid-template-columns: 250px minmax(0, 1fr);
  grid-template-areas: "header header" "nav main";
}
.wide .inspector-rail {
  display: none;
}
</style>
