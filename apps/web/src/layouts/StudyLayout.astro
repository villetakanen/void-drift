---
import PageHeader from "../components/PageHeader.svelte";
import "@void-drift/core/styles/buttons.css";
import "@void-drift/core/styles/surfaces.css";
import { type Study, studies } from "../data/studies";
import "@void-drift/core/styles/reset.css";
import "@void-drift/core/styles/tokens.css";
import "@void-drift/core/styles/typography.css";

interface Props {
  study?: Study;
}
const slug = Astro.url.pathname.replace(/\/$/, "").split("/").pop();
const study = Astro.props.study ?? studies.find((entry) => entry.slug === slug);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <title>{study?.title ?? "Design studies"} | Void Drift</title>
  </head>
  <body>
    <div class="study-navigation">
      <PageHeader
        title="Lab // Research"
        level={2}
        navigationLabel="Study navigation"
        links={[
          { href: "/lab", label: "Lab" },
          { href: "/lab/studies", label: "Design studies" },
        ]}
      />
    </div>
    <main class="prose">
      <header>
        <p class="eyebrow">
          {study
            ? `STUDY / ${study.phase} / ${study.status}`
            : "DESIGN FACTORY"}
        </p>
        <h1>{study?.title ?? "Design studies"}</h1>
        <p class="lead">
          {study?.question ?? "Problem, exploration, readiness, and scope."}
        </p>
      </header>
      <slot />
    </main>
  </body>
</html>
<style>
:global(body) {
  margin: 0;
  background: var(--color-void);
  color: var(--color-text);
  font-family: var(--font-family-prose);
}
.study-navigation {
  padding-inline: var(--spacing-lg);
  border-bottom: 1px solid var(--color-border);
}
main {
  max-width: 1120px;
  margin: auto;
  padding: var(--spacing-lg);
}
header {
  padding-block: var(--spacing-lg);
  max-width: 850px;
}
.eyebrow {
  color: var(--color-text-muted);
  font: var(--font-size-caption) var(--font-family-ui);
  letter-spacing: var(--tracking-eyebrow);
}
</style>
