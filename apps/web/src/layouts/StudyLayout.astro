---
import type { Study } from "../data/studies";
import "@void-drift/core/styles/reset.css";
import "@void-drift/core/styles/tokens.css";

interface Props {
	study?: Study;
}
const { study } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{study?.title ?? "Design studies"} | Void Drift</title>
	</head>
	<body>
		<nav aria-label="Study navigation">
			<a href="/lab">← Lab</a><a href="/lab/studies">Design studies</a
			><span>VOID DRIFT / RESEARCH</span>
		</nav>
		<main>
			<header>
				<p class="eyebrow">
					{study
						? `STUDY / ${study.phase} / ${study.status}`
						: "DESIGN FACTORY"}
				</p>
				<h1>{study?.title ?? "Design studies"}</h1>
				<p class="intro">
					{study?.question ??
						"Design problem, exploration, readiness, and integration planning."}
				</p>
			</header>
			<slot />
		</main>
	</body>
</html>
<style>
:global(body) {
	margin: 0;
	background: var(--color-void);
	color: var(--color-text);
	font-family: var(--font-display);
}
nav {
	display: flex;
	gap: var(--spacing-lg);
	padding: var(--spacing-md) var(--spacing-lg);
	border-bottom: var(--flight-border);
	flex-wrap: wrap;
}
nav span {
	margin-left: auto;
	color: var(--color-text-dim);
	font: var(--font-small) var(--font-flight);
}
a {
	color: var(--color-acid-lime);
}
main {
	max-width: 1120px;
	margin: auto;
	padding: var(--spacing-lg);
}
header {
	padding-block: var(--spacing-lg);
	max-width: 850px;
}
h1 {
	font-size: var(--font-title);
	line-height: 1.1;
	margin-block: var(--spacing-md);
}
.eyebrow {
	color: var(--color-acid-lime);
	font: var(--font-small) var(--font-flight);
	letter-spacing: 0.12em;
}
.intro {
	font-size: 1.2rem;
	line-height: 1.6;
}
:global(main p),
:global(main li) {
	line-height: 1.65;
}
:global(main section > p) {
	max-width: 70ch;
	margin-block: 0 var(--spacing-md);
}
:global(main section > h3) {
	margin-block: var(--spacing-lg) var(--spacing-sm);
}
:global(main a) {
	color: var(--color-acid-lime);
}
:global(main section) {
	margin-bottom: var(--spacing-lg);
}
:global(main h2) {
	font-size: var(--font-large);
	margin-bottom: var(--spacing-md);
}
</style>
