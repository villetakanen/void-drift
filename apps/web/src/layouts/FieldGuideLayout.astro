---
import "@void-drift/core/styles/reset.css";
import "@void-drift/core/styles/tokens.css";
import "@void-drift/core/styles/buttons.css";
import "@void-drift/core/styles/typography.css";
import type { CollectionEntry } from "astro:content";
import PageHeader from "../components/PageHeader.svelte";
import Tray from "../components/Tray.svelte";

interface Props {
  title: string;
  description: string;
  entries: CollectionEntry<"fieldGuide">[];
}
const { title, description, entries } = Astro.props;
const canonical = new URL(
  Astro.url.pathname.replace(/\/$/, "") || "/",
  Astro.site,
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title} | Void Drift</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonical}>
    <link rel="icon" href="/favicon.svg">
  </head>
  <body>
    <div class="guide-grid">
      <div class="page-header">
        <PageHeader
          title="Field Guide"
          pageName={title === "Field Guide" ? undefined : title}
          href="/field-guide"
        />
      </div>

      <aside class="nav-rail">
        <Tray
          label="Field Guide navigation"
          links={[
            { href: "/field-guide", label: "Field Guide" },
            { href: "/", label: "Title screen" },
          ]}
          groups={[
            {
              label: "Articles",
              links: entries.map((e) => ({
                href: `/field-guide/${e.data.slug}`,
                label: e.data.title,
              })),
            },
          ]}
          activeHref={Astro.url.pathname.replace(/\/$/, "")}
        />
      </aside>
      <main>
        <div class="reading-content"><slot /></div>
      </main>
    </div>
  </body>
</html>
<style>
:global(body) {
  margin: 0;
  background: var(--color-void);
  color: var(--color-text);
  font-family: var(--font-family-ui);
}
.guide-grid {
  display: grid;
  grid-template-columns: 250px minmax(0, 1fr);
  grid-template-rows: auto minmax(0, 1fr);
  grid-template-areas: "header header" "nav main";
  height: 100dvh;
  overflow: hidden;
}
.page-header {
  grid-area: header;
  min-width: 0;
  padding: var(--spacing-sm) var(--spacing-md);
}
.nav-rail {
  grid-area: nav;
  border-right: 1px solid var(--color-border-subtle);
  overflow-y: auto;
}
main {
  grid-area: main;
  min-width: 0;
  overflow-y: auto;
  padding: var(--spacing-md);
}
.reading-content {
  max-width: var(--measure-prose);
}
main :global(p),
main :global(ul),
main :global(ol) {
  margin-block: var(--spacing-md);
}
@media (max-width: 700px) {
  .guide-grid {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto auto;
    grid-template-areas: "header" "nav" "main";
    height: auto;
    min-height: 100dvh;
    overflow: visible;
  }
  .nav-rail {
    border-right: 0;
  }
}
</style>
