---
import FieldGuideLayout from "../../layouts/FieldGuideLayout.astro";
import { articles } from "../../lib/field-guide";

const entries = await articles();
---

<FieldGuideLayout
  title="Field Guide"
  description="Explore the Void Drift Field Guide."
  entries={entries}
>
  <h1>Field Guide</h1>
  <p>Explore the world and workings of Void Drift.</p>
  {entries.length === 0 ? (
    <p>No articles published yet.</p>
  ) : (
    <ul>
      {entries.map((entry) => (
        <li>
          <a href={`/field-guide/${entry.data.slug}`}>{entry.data.title}</a>
          <p>{entry.data.summary}</p>
        </li>
      ))}
    </ul>
  )}
</FieldGuideLayout>
