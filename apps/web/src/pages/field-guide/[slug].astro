---
import { render } from "astro:content";
import FieldGuideLayout from "../../layouts/FieldGuideLayout.astro";
import { articles } from "../../lib/field-guide";
import { atOrAfter } from "../../lib/timestamp";
export async function getStaticPaths() {
  const entries = await articles();
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry, entries },
  }));
}
const { entry, entries } = Astro.props;
const { Content } = await render(entry);
const { generated, verified } = entry.data;
const confirmation = verified[0];
---

<FieldGuideLayout
  title={entry.data.title}
  description={entry.data.summary}
  entries={entries}
>
  <article>
    <div class="prose">
      <h1>{entry.data.title}</h1>
      <Content />
    </div>
    <footer>
      <p>
        Generated by {generated.by} ·
        <time datetime={generated.at}>{generated.at}</time>
      </p>
      {confirmation && atOrAfter(confirmation.at, generated.at) && (
        <p>
          Verified by a human: {confirmation.by.slice(6)} ·{" "}
          <time datetime={confirmation.at}>{confirmation.at}</time>
        </p>
      )}
    </footer>
  </article>
  <p><a href="/field-guide">Field Guide</a> · <a href="/">Title screen</a></p>
</FieldGuideLayout>
