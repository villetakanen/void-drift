---
import Controls from "../../components/Controls.svelte";
import LabTypographyMain from "../../components/lab/LabTypographyMain.svelte";
import LabLayout from "../../layouts/LabLayout.astro";
---

<LabLayout title="Typography">
  <LabTypographyMain client:only="svelte" />

  <Controls slot="inspector" title="Details">
    <p class="details">
      Type roles, size steps, line heights, tracking, the global
      <code>.prose</code>
      class and canvas fonts, rendered from the production tokens. The rules are
      in <code>docs/specs/design-system-core.md</code>.
    </p>
  </Controls>
</LabLayout>

<style>
.details {
  color: var(--color-text-muted);
  font-size: var(--font-size-caption);
}
</style>
