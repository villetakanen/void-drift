---
import Controls from "../../components/Controls.svelte";
import LabTypographyMain from "../../components/lab/LabTypographyMain.svelte";
import DesignSystemLayout from "../../layouts/DesignSystemLayout.astro";
---

<DesignSystemLayout title="Typography">
  <section class="link-example">
    <h2>Ordinary links</h2>
    <p>
      Links outside prose use the shared action role, including after a visit.
      Tab to the link to inspect its shared focus ring.
    </p>
    <a href="/field-guide">Field Guide</a>
  </section>
  <LabTypographyMain client:only="svelte" />

  <Controls slot="inspector" title="Details">
    <p class="details">
      Type roles, size steps, line heights, tracking, the global
      <code>.prose</code>
      class and canvas fonts, rendered from the production tokens. The rules are
      in <code>docs/specs/design-system-core.md</code>.
    </p>
  </Controls>
</DesignSystemLayout>

<style>
.link-example {
  padding: var(--spacing-md);
}

.details {
  color: var(--color-text-muted);
  font-size: var(--font-size-caption);
}
</style>
