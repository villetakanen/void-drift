---
import GravityCoilFleet from "../../components/lab/GravityCoilFleet.astro";
import IonCannonEncounter from "../../components/lab/IonCannonEncounter.svelte";
import PointDefenceEncounter from "../../components/lab/PointDefenceEncounter.svelte";
import UtilityArtworkBench from "../../components/lab/UtilityArtwork.astro";
import IonCannonFitting from "../../components/studies/IonCannonFitting.svelte";
import PotentialWellSizing from "../../components/studies/PotentialWellSizing.astro";
import StudyLayout from "../../layouts/StudyLayout.astro";
---

<StudyLayout
  study={{
    slug: "utility-artwork",
    title: "Utility machinery artwork",
    phase: "scope",
    status: "accepted",
    question:
      "I create opportunities. Shared resting artwork with #CEDB17 on connectors, struts and attachments.",
  }}
>
  <p>
    Potential Well replaces the original storage artwork. Gravity coil uses
    <a href="/lab/studies/gravity-coil-form-2026-11-03#decision"
      >M / Inset ring at 100%</a
    >
    and is available as a static fitting in the
    <a href="/hangar">ship builder</a>. Solar and repair remain conceptual
    artwork. Their shapes and colour follow
    <a href="/lab/studies/utility-machinery-2026-11-02#family-colour"
      >the accepted reference</a
    >.
  </p>
  <UtilityArtworkBench />
  <h2>Light Ion Cannon / production fitting</h2>
  <IonCannonFitting client:load />
  <IonCannonEncounter client:load />
  <h2 id="ion-point-defence">Ion Point Defence / production encounter</h2>
  <p>
    The genuine turret from the
    <a href="/lab/studies/ion-point-defence-2026-11-08#production"
      >accepted study</a
    >, in the real simulation: closest-target switching, a target out of reach,
    a hit stopped at first contact, a turning ship and the hidden turret on
    Scout.
  </p>
  <PointDefenceEncounter client:load />
  <h2 id="gravity-coil">Gravity coil / production fleet comparison</h2>
  <p>
    The accepted 100% size on every equipment mount, with Light ions in all
    engine and aft slots. These are the shared builder and flight drawings,
    using each hull’s normal layering. 1× means one ship drawing unit per CSS
    pixel at 100% browser zoom. Drawings retain their scale on narrow screens.
  </p>
  <GravityCoilFleet />
  <h2>Potential Wells / production fleet comparison</h2>
  <p>
    Normal and heavy production fittings at the accepted 0.55 scale, with Light
    ion engines in all engine and aft mounts.
  </p>
  <PotentialWellSizing />
</StudyLayout>
