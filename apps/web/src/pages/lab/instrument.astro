---
import ShipTuning from "../../components/lab/instrument/ShipTuning.svelte";
import LabLayout from "../../layouts/LabLayout.astro";
import { STARTER_DOCUMENT } from "../../lib/instrument/starter";
---

<LabLayout title="Ship tuning" wide>
	<div class="fill">
		<ShipTuning client:load config={STARTER_DOCUMENT} />
	</div>
</LabLayout>

<style>
/* The instrument fills the Lab's main stage. */
.fill {
	width: 100%;
	height: 100%;
	min-height: 0;
}
</style>
