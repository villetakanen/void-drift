---
import LabLayout from "../../layouts/LabLayout.astro";
---

<LabLayout title="Dashboard">
	<div class="dashboard-shell">
		<p>Select an asset from the left sidebar to begin tuning.</p>
		<div class="hint">← Use the nav rail to navigate</div>
	</div>
</LabLayout>

<style>
.dashboard-shell {
	flex: 1;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	background-image:
		linear-gradient(var(--color-border-faint) 1px, transparent 1px),
		linear-gradient(90deg, var(--color-border-faint) 1px, transparent 1px);
	background-size: 20px 20px;
	color: var(--color-text-muted);
}

p {
	color: var(--color-text-muted);
	font-size: 1.25rem;
	margin-bottom: 0.5rem;
}

.hint {
	font-size: 0.9rem;
	opacity: 0.6;
}
</style>
