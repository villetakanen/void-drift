---
import FlightSceneLab from "../../components/lab/flight-scene/FlightSceneLab.svelte";
import LabLayout from "../../layouts/LabLayout.astro";
import { STARTER_FLIGHT_SCENE } from "../../lib/flight-scene";
---

<LabLayout title="Flight scene" wide>
  <div class="fill">
    <FlightSceneLab client:load config={STARTER_FLIGHT_SCENE} />
  </div>
</LabLayout>

<style>
/* The instrument fills the Lab's main stage. */
.fill {
  width: 100%;
  height: 100%;
  min-height: 0;
}
</style>
