---
import IonSizeComparison from "../../components/studies/IonSizeComparison.svelte";
import IonSizesAccepted024 from "../../components/studies/IonSizesAccepted024.svelte";
import Layout from "../../layouts/Layout.astro";
---

<Layout>
  <main style="max-width: 1100px; margin: auto; padding: var(--spacing-lg);">
    <p>
      <a href="/lab">← Lab</a>
      · <a href="/lab/builder">Fit and fly engines</a>
    </p>
    <h1>Ion engines · shared FX</h1>
    <p><a href="/lab/fx">Mixed-scene FX instrument →</a></p>
    <p>
      Light and Heavy ion light accumulates on the shared FX surface and fades
      together. Heavy follows Light’s output here for comparison; fitted flight
      uses each engine’s actual output. The motion sequence is shared with the
      preserved reference below.
    </p>
    <IonSizeComparison label="Production ion effects" client:load />
    <details>
      <summary>Preserved approved reference · 02.4</summary>
      <IonSizesAccepted024 label="Frozen ion reference" client:visible />
    </details>
    <p>
      <a href="/lab/studies/ion-engines-2026-10-31#integration"
        >Design and integration record</a
      >
    </p>
  </main>
</Layout>
