---
import Inspector from "../../components/lab/planet-inspector/PlanetInspector.svelte";
import LabLayout from "../../layouts/LabLayout.astro";
---

<LabLayout title="Planet Inspector" wide>
  <div class="instrument">
    <Inspector
      client:load
      config={{ planet: { kind: "named", name: "mercury" } }}
    />
  </div>
</LabLayout>

<style>
.instrument {
  width: 100%;
  height: 100%;
  min-height: 0;
}
</style>
