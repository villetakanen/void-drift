---
import { studies } from "../../../data/studies";
import StudyLayout from "../../../layouts/StudyLayout.astro";

const earthSketches = [
  [
    { file: "02-6-1.png", title: "P1 / Pale", cx: 640, cy: 625, radius: 525 },
    { file: "02-6-2.png", title: "P2 / Smoky", cx: 640, cy: 625, radius: 525 },
    { file: "02-6-3.png", title: "P3 / Dark", cx: 640, cy: 625, radius: 525 },
  ],
  [
    { file: "02-6-4.png", title: "C1 / Slate", cx: 640, cy: 625, radius: 525 },
    { file: "02-6-5.png", title: "C2 / Teal", cx: 640, cy: 625, radius: 525 },
    {
      file: "02-6-6.png",
      title: "C3 / Graphite",
      cx: 640,
      cy: 625,
      radius: 525,
    },
  ],
  [
    { file: "02-6-7.png", title: "H1 / Silver", cx: 640, cy: 625, radius: 525 },
    {
      file: "02-6-8.png",
      title: "H2 / Mineral",
      cx: 640,
      cy: 625,
      radius: 525,
    },
    { file: "02-6-9.png", title: "H3 / Dusk", cx: 640, cy: 625, radius: 525 },
  ],
