import PotentialWellChambers from "../../../components/studies/PotentialWellChambers.astro";
import PotentialWellHeavy from "../../../components/studies/PotentialWellHeavy.astro";
import PotentialWellLongPairs from "../../../components/studies/PotentialWellLongPairs.astro";
import PotentialWellNine from "../../../components/studies/PotentialWellNine.astro";
import PotentialWellRefinements from "../../../components/studies/PotentialWellRefinements.astro";
