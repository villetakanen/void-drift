---
import { getCollection } from "astro:content";
import StudyLayout from "../../../layouts/StudyLayout.astro";

const studies = (await getCollection("studies")).sort((a, b) =>
  a.id < b.id ? -1 : a.id > b.id ? 1 : 0,
);
---

<StudyLayout>
  {studies.map((study) => (
    <article>
      <p>
        {study.data.phase} · {study.data.status}
      </p>
      <h2>
        <a href={`/lab/studies/${study.id}`}>{study.data.title} →</a>
      </h2>
      <p>{study.data.question}</p>
    </article>
  ))}
  <p>
    Studies have four parts: design problem → exploration → readiness → scope. A
    study is open, or blocked on a named dependency, until it ends as accepted,
    ruled out or stopped. Accepted studies scope slices that are implemented as
    separate work; acceptance does not imply implementation. Stopped studies
    retain their evidence in a closure record. Study-quality evaluation is
    separate.
  </p>
</StudyLayout>
<style>
article {
  border: var(--flight-border);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-lg);
  background: var(--color-void-light);
}
</style>
