---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Credits | Void Drift">
  <main class="credits">
    <h1>Credits</h1>
    <p>
      Void Drift uses the following typefaces, licensed under the SIL Open Font
      License 1.1:
    </p>
    <ul>
      <li>B612 Mono — The B612 Project Authors</li>
      <li>Noto Sans and Noto Sans Math — The Noto Project Authors</li>
      <li>Saira Stencil — The Saira Project Authors</li>
    </ul>
    <a href="/" class="btn btn-normal">RETURN TO TITLE SCREEN</a>
  </main>
</Layout>
<style>
.credits {
  max-width: 700px;
  margin: 0 auto;
  padding: var(--spacing-xl);
  line-height: 1.6;
}
.credits h1,
.credits p,
.credits ul {
  margin-bottom: var(--spacing-lg);
}
:global(body) {
  overflow: auto;
}
</style>
