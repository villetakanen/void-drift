{
	"name": "void-drift-monorepo",
	"private": true,
	"version": "0.3.0",
	"scripts": {
		"dev": "pnpm --filter web dev",
		"build": "pnpm --filter web build",
		"check": "pnpm -r check",
		"test": "vitest run",
		"check:contracts": "node scripts/check-contracts.mjs",
		"lint": "biome check . --error-on-warnings",
		"check:types": "pnpm check && pnpm --filter web exec svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.check.json",
		"test:browser": "playwright test",
		"verify": "node scripts/verify.mjs",
		"test:rules": "firebase emulators:exec --only firestore --project demo-void-drift \"node --test packages/mode-a/tests/firestore.test.mjs\"",
		"test:competition": "firebase emulators:exec --only firestore,auth --project demo-void-drift \"playwright test -c playwright.firebase.config.ts\""
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@firebase/rules-unit-testing": "6.0.0",
		"@playwright/test": "1.64.1",
		"@vitest/ui": "^4.0.16",
		"firebase-tools": "15.34.1",
		"svelte-check": "4.7.7",
		"typescript": "^5.0.0",
		"vitest": "^4.0.16"
	},
	"packageManager": "pnpm@10.33.0"
}
