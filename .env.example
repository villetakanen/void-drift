# Firebase web app configuration (public identifiers, not admin credentials).
# Leave unset for offline game/Lab use. Enable anonymous Auth and deploy Firestore rules.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_EMULATORS=false

# Optional browser error reporting. Fill all four values in ignored .env.local
# for release preparation. The DSN is public. The CLI token stays private.
PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
